<%= form_with url: project_budget_line_status_path(project, budget_line), method: :patch, scope: :budget_line, class: "space-y-7" do |form| %>
  <% if budget_line.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
      <p class="font-semibold">Fix these to continue:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% budget_line.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="text-meta text-ink-2"><%= budget_line.description %></p>

  <div>
    <%= form.label :status, class: "block text-label font-medium text-ink" %>
    <%= form.select :status, BudgetLine.statuses.keys.map { |status| [ status.humanize, status ] }, {}, class: "mt-2 block w-full field" %>
  </div>

  <div>
    <%= form.label :actual, "Actual cost", class: "block text-label font-medium text-ink" %>
    <%= form.text_field :actual, placeholder: "0.00", class: "mt-2 block w-full field" %>
  </div>

  <%= form.submit "Save Status", class: "btn btn-primary" %>
<% end %>
