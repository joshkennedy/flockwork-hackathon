<%= form_with model: [ project, budget_line ], class: "space-y-7" do |form| %>
  <% if budget_line.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% budget_line.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :kind, class: "block text-label font-medium text-ink" %>
    <%= form.select :kind, BudgetLine.kinds.keys.map { |kind| [ kind.humanize, kind ] }, {}, class: "mt-2 block w-full field" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :description, required: true, autofocus: true, class: "mt-2 block w-full field" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :estimated, "Estimated cost", class: "block text-label font-medium text-ink" %>
      <%= form.text_field :estimated, placeholder: "0.00", class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :actual, "Actual cost", class: "block text-label font-medium text-ink" %>
      <%= form.text_field :actual, placeholder: "Leave blank if unknown", class: "mt-2 block w-full field" %>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :status, class: "block text-label font-medium text-ink" %>
      <%= form.select :status, BudgetLine.statuses.keys.map { |status| [ status.humanize, status ] }, {}, class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :responsible_person_id, "Responsible person", class: "block text-label font-medium text-ink" %>
      <%= form.collection_select :responsible_person_id, team_people, :id, :name, { include_blank: "None" }, class: "mt-2 block w-full field" %>
    </div>
  </div>

  <%= form.submit budget_line.persisted? ? "Update Budget Line" : "Create Budget Line", class: "btn btn-primary" %>
<% end %>
