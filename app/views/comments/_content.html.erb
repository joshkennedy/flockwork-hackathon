<div class="space-y-4 pb-2 pt-3">
  <% if comments.any? %>
    <ol class="space-y-4">
      <% comments.each do |comment| %>
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="text-meta font-semibold text-ink"><%= person_pill(comment.author) %></span>
            <span class="text-label text-ink-2"><%= time_ago_in_words(comment.created_at) %> ago</span>
          </div>
          <div class="mt-1 text-meta leading-normal text-ink"><%= mention_pills(comment.body) %></div>
        </li>
      <% end %>
    </ol>
  <% end %>

  <% if follow %>
    <div class="flex min-h-8 items-center justify-between gap-3 text-meta text-ink-2">
      <span>Following this thread</span>
      <%= button_to "Unfollow",
            project_follow_path(project, follow),
            method: :delete,
            class: "btn btn-text" %>
    </div>
  <% end %>

  <% if can_comment %>
    <%= form_with model: [ project, Comment.new ], id: "comment_form_#{commentable.model_name.singular}_#{commentable.id}", class: "min-w-0 space-y-3", data: { turbo_permanent: true, controller: "comment-form", action: "turbo:submit-end->comment-form#submitted" } do |form| %>
      <div id="comment_errors_<%= commentable.model_name.singular %>_<%= commentable.id %>"></div>
      <%= form.hidden_field :commentable_type, value: commentable.class.name, id: nil %>
      <%= form.hidden_field :commentable_id, value: commentable.id, id: nil %>
      <%= render "mentions/field",
            form: form,
            project: project,
            label: "Add a comment",
            input_id: "comment_#{commentable.model_name.singular}_#{commentable.id}_body" %>
      <%= form.submit "Post Comment", class: "btn btn-secondary" %>
    <% end %>
  <% end %>
</div>
