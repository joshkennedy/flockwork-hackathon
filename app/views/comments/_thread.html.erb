<% project = commentable.project %>
<% comments = commentable.comments.includes(:author, :rich_text_body).order(:created_at, :id).to_a %>
<% follow = commentable.follows.find_by(person: Current.person) %>
<% can_comment = Policy.can?(Current.person, :comment, project) %>

<% if comments.any? || can_comment || follow %>
  <% if local_assigns.fetch(:external, false) %>
    <section hidden class="comment-panel" aria-label="Comments" data-comment-thread-target="panel" data-commentable-type="<%= commentable.class.name %>" data-commentable-id="<%= commentable.id %>">
      <div class="flex items-center justify-between gap-4">
        <h3>Comments</h3>
        <button type="button" class="btn btn-icon" aria-label="Close Comments" data-action="comment-thread#close"><%= icon(:close) %></button>
      </div>
      <%= render "comments/content", commentable:, comments:, project:, follow:, can_comment: %>
    </section>
  <% else %>
    <details class="<%= comments.any? ? "mt-4" : "mt-1" %> min-w-0 text-left" data-controller="comment-thread" data-commentable-type="<%= commentable.class.name %>" data-commentable-id="<%= commentable.id %>">
      <summary class="comment-toggle btn btn-text btn-sm -ml-2">
        <%= icon(:comment) %>
        <span><%= comments.any? ? pluralize(comments.length, "Comment") : "Add Comment" %></span>
      </summary>
      <%= render "comments/content", commentable:, comments:, project:, follow:, can_comment: %>
    </details>
  <% end %>
<% end %>
