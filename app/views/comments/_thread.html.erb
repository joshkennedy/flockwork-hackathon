<% project = commentable.project %>
<% comments = commentable.comments.includes(:author, :rich_text_body).order(:created_at, :id).to_a %>
<% follow = commentable.follows.find_by(person: Current.person) %>

<details class="mt-4 min-w-0 text-left" data-commentable-type="<%= commentable.class.name %>" data-commentable-id="<%= commentable.id %>">
  <summary class="cursor-pointer py-2 text-meta font-semibold text-ink-2 hover:text-ink">
    Comments (<%= comments.length %>)
  </summary>

  <div class="space-y-4 pb-2 pt-2">
    <% if comments.any? %>
      <ol class="space-y-4">
        <% comments.each do |comment| %>
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="text-meta font-semibold text-ink"><%= comment.author.name %></span>
              <span class="text-label text-ink-2"><%= time_ago_in_words(comment.created_at) %> ago</span>
            </div>
            <div class="mt-1 text-meta leading-normal text-ink"><%= comment.body %></div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="text-meta text-ink-2">No comments yet</p>
    <% end %>

    <div class="flex min-h-8 items-center justify-between gap-3 text-meta text-ink-2">
      <% if follow %>
        <span>Following this item</span>
        <%= button_to "Unfollow",
              project_follow_path(project, follow),
              method: :delete,
              class: "btn btn-text" %>
      <% elsif Policy.can?(Current.person, :comment, project) %>
        <span>Comment or get mentioned to follow</span>
      <% else %>
        <span>Get mentioned to follow</span>
      <% end %>
    </div>

    <% if Policy.can?(Current.person, :comment, project) %>
      <%= form_with model: [ project, Comment.new ], class: "min-w-0 space-y-3" do |form| %>
        <%= form.hidden_field :commentable_type, value: commentable.class.name, id: nil %>
        <%= form.hidden_field :commentable_id, value: commentable.id, id: nil %>
        <%= render "mentions/field",
              form: form,
              project: project,
              label: "Add a comment",
              input_id: "comment_#{commentable.model_name.singular}_#{commentable.id}_body" %>
        <%= form.submit "Post comment", class: "btn btn-secondary" %>
      <% end %>
    <% end %>
  </div>
</details>
