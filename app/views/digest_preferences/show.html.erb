<% content_for :title, "Weekly emails" %>

<div class="w-full max-w-xl">
  <%= page_header "Weekly emails" %>
  <p class="mt-4 text-body text-ink-2">Receive one weekly update for each active Project you lead, with open spots, overdue tasks, and unanswered invitations.</p>

  <%= form_with scope: :digest, url: digest_preferences_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
    <% if @person.errors.any? %>
      <p role="alert" class="text-meta text-danger"><%= @person.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="flex items-start gap-3">
      <%= form.check_box :enabled, checked: !@person.email_preferences.key?("weekly_project_digest") || ActiveModel::Type::Boolean.new.cast(@person.email_preferences["weekly_project_digest"]), class: "mt-1" %>
      <%= form.label :enabled, "Send me weekly Project emails", class: "text-body text-ink" %>
    </div>
    <%= form.submit "Save Preference", class: "btn btn-primary" %>
  <% end %>
</div>
