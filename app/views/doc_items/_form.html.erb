<% upload_data = doc_item.file? ? { controller: "upload", upload_key_value: "doc-item-#{project.id}-#{doc_item.id || 'new'}", upload_max_bytes_value: DocItem::FILE_MAX_BYTES, upload_max_size_label_value: "25 MB", action: "submit->upload#validate turbo:submit-start->upload#start turbo:submit-end->upload#finish direct-upload:start->upload#start direct-upload:progress->upload#progress direct-upload:error->upload#directError" } : {} %>
<%= form_with model: [ project, doc_item ], class: [ "space-y-7", ("sheet-fill" if doc_item.document?) ], data: upload_data do |form| %>
  <% if doc_item.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
      <p class="font-semibold">Fix these to continue:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% doc_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :kind %>

  <div>
    <%= form.label :title, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "mt-2 block w-full field" %>
  </div>

  <% if doc_item.document? %>
    <div class="sheet-grow">
      <%= form.label :body, class: "block text-label font-medium text-ink" %>
      <%= form.rich_text_area :body, class: "mt-2 block w-full field" %>
    </div>
  <% elsif doc_item.file? %>
    <div>
      <%= form.label :file, class: "block text-label font-medium text-ink" %>
      <%= form.file_field :file, class: "mt-2 block w-full text-meta text-ink", data: { upload_target: "input", action: "change->upload#validate" } %>
    </div>
  <% elsif doc_item.link? %>
    <div>
      <%= form.label :url, "URL", class: "block text-label font-medium text-ink" %>
      <%= form.url_field :url, required: true, placeholder: "https://", class: "mt-2 block w-full field" %>
    </div>
  <% end %>

  <%= form.submit doc_item.persisted? ? "Save #{doc_item.kind.humanize}" : "Add #{doc_item.kind.humanize}", class: "btn btn-primary" %>
<% end %>
