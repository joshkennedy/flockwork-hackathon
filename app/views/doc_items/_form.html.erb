<%= form_with model: [ project, doc_item ], class: "space-y-7" do |form| %>
  <% if doc_item.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% doc_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :kind %>

  <div>
    <%= form.label :title, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "mt-2 block w-full field" %>
  </div>

  <% if doc_item.document? %>
    <div>
      <%= form.label :body, class: "block text-label font-medium text-ink" %>
      <%= form.rich_text_area :body, class: "mt-2 block w-full field" %>
    </div>
  <% elsif doc_item.file? %>
    <div>
      <%= form.label :file, class: "block text-label font-medium text-ink" %>
      <%= form.file_field :file, required: !doc_item.file.attached?, class: "mt-2 block w-full text-meta text-ink" %>
    </div>
  <% elsif doc_item.link? %>
    <div>
      <%= form.label :url, "URL", class: "block text-label font-medium text-ink" %>
      <%= form.url_field :url, required: true, placeholder: "https://", class: "mt-2 block w-full field" %>
    </div>
  <% end %>

  <%= form.submit doc_item.persisted? ? "Update Document" : "Create Document", class: "btn btn-primary" %>
<% end %>
