  <h1 class="mt-8 text-3xl font-bold text-stone-950">New <%= @doc_item.kind.humanize.downcase %></h1>

  <div class="mt-8">
    <%= render "form", project: @project, doc_item: @doc_item %>
  </div>
</div>
