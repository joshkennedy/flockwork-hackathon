<% content_for :title, "Confirm your email" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Confirm your email</h1>
  <p class="mt-2 text-ink-2">Use the button below to use this address to sign in to Flockwork.</p>

  <%= button_to "Confirm Email", email_confirmation_path(params[:token]), class: "mt-6 w-full btn btn-primary" %>
</div>
