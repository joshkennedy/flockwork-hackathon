<% project = slot.project %>
<% own = slot.slot_claims.any? { |claim| claim.person_id == Current.person.id } %>
<% going = who_is_going(slot) %>
<li class="<%= own ? "border-b border-hairline py-3" : "tile-raised p-4" %>">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0">
      <p class="font-semibold text-ink"><%= slot.date.strftime(slot.date.year == Date.current.year ? "%a, %b %-d" : "%a, %b %-d, %Y") %><% if slot.date == Date.current %> <span class="font-normal text-ink-2">· Today</span><% end %></p>
      <p class="text-ink-2">
        <%= link_to project.name, project_path(project), class: "text-ink" %> · <%= slot.label %><% if slot.starts_at_time.present? %> · <span class="whitespace-nowrap"><%= slot.starts_at_time.strftime("%-l:%M %p") %></span><% end %>
      </p>
      <% if own %>
        <p class="mt-1 flex items-center gap-1.5 text-meta text-ink"><%= icon(:check, class: "text-sunlit") %><%= slot.label.downcase == "dinner" ? "You’re bringing dinner" : "You’re signed up" %></p>
      <% elsif going %>
        <p class="mt-1 flex items-center gap-1.5 text-meta text-ink-2"><%= icon(:check, class: "text-success") %><%= avatar_stack(slot.slot_claims.map(&:person), size: :sm) %><%= going %></p>
      <% end %>
    </div>
    <% unless own %>
      <div class="flex shrink-0 flex-wrap items-center gap-2.5 max-sm:w-full">
        <span class="badge-need"><%= pluralize(slot.capacity - slot.claims_count, "spot") %> left</span>
        <% if Policy.can?(Current.person, :claim_slot, project) %>
          <%= button_to claim_label(slot), project_slot_claim_path(project, slot),
                params: { from: "get_involved" },
                class: slot.equal?(first_claim) ? "btn btn-primary" : "btn btn-secondary btn-sm",
                form_class: "button_to max-sm:w-full",
                aria: { label: "#{claim_label(slot)}: #{slot.label} for #{project.name} on #{slot.date.strftime("%B %-d")}" } %>
        <% else %>
          <span class="text-meta text-ink-2">Join the Team to sign up</span>
        <% end %>
      </div>
    <% end %>
  </div>
</li>
