<% content_for :title, "Get involved" %>

<div class="mx-auto w-full max-w-3xl">
  <nav aria-label="Get involved navigation">
    <%= link_to "Home", workspace_path(Current.workspace), class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>
  </nav>

  <header class="mt-10">
    <h1 class="text-4xl font-bold tracking-tight text-stone-950">Get involved</h1>
    <p class="mt-4 text-lg text-stone-700">Open Team Projects welcome Volunteers from across the Workspace.</p>
  </header>

  <% if @projects.any? %>
    <ul class="mt-10 divide-y divide-stone-300 border-y border-stone-300">
      <% @projects.each do |project| %>
        <li class="flex flex-wrap items-center justify-between gap-4 py-5">
          <div>
            <%= link_to project.name, project_path(project), class: "text-lg font-semibold text-stone-900 hover:text-stone-950" %>
            <% if project.description.present? %>
              <p class="mt-1 text-sm text-stone-600"><%= project.description %></p>
            <% end %>
          </div>
          <% if Policy.member?(Current.person, project) %>
            <span class="text-sm font-medium text-stone-600">On the Team</span>
          <% else %>
            <%= button_to "Join", join_project_path(project), class: "cursor-pointer bg-[#1f291f] px-4 py-2 text-sm font-semibold text-white hover:bg-[#354235]" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-10 text-sm text-stone-600">No Open Team Projects right now.</p>
  <% end %>
</div>
