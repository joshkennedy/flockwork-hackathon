<% content_for :title, "Get involved" %>

<div class="w-full max-w-3xl">
  <nav aria-label="Get involved navigation">
    <%= link_to "Home", workspace_path(Current.workspace), class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
  </nav>

  <header class="mt-7">
    <h1 class="text-ink">Get involved</h1>
    <p class="mt-4 text-body-phone sm:text-body text-ink-2">Open Team Projects welcome Volunteers from across the Workspace.</p>
  </header>

  <% if @projects.any? %>
    <ul class="mt-7 divide-y divide-hairline border-y border-hairline">
      <% @projects.each do |project| %>
        <li class="flex flex-wrap items-center justify-between gap-4 py-5">
          <div>
            <%= link_to project.name, project_path(project), class: "text-body-phone sm:text-body font-semibold text-ink hover:text-ink" %>
            <% if project.description.present? %>
              <p class="mt-1 text-meta text-ink-2"><%= project.description %></p>
            <% end %>
          </div>
          <% if Policy.member?(Current.person, project) %>
            <span class="text-meta font-medium text-ink-2">On the Team</span>
          <% else %>
            <%= button_to "Join", join_project_path(project), class: "btn btn-secondary" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No Open Team Projects right now.</p>
  <% end %>
</div>
