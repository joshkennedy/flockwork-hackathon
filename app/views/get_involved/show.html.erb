<% content_for :title, "Get involved" %>
<% content_for :wash, "wash-volunteer" %>
<% joined, open = @projects.partition { |project| @joined_ids.include?(project.id) } %>

<div class="w-full max-w-4xl">
  <%= page_header "Get involved" %>

  <% if @projects.any? %>
    <%# Discovery first: the few Projects short on people soonest, each a click through to sign up there. %>
    <% open_needs = @needs.reject(&:full?).group_by(&:project).first(3) %>
    <section class="mt-7" aria-labelledby="needs-heading">
      <h2 id="needs-heading" class="text-ink">Open Sign-up spots</h2>
      <% if open_needs.any? %>
        <ul class="mt-3 grid gap-2">
          <% open_needs.each do |project, slots| %>
            <% open_spots = slots.sum { |slot| slot.capacity - slot.claims_count } %>
            <li class="tile-raised overflow-hidden">
              <%= link_to project_path(project), class: "group flex min-h-20 items-stretch text-ink no-underline" do %>
                <span class="w-24 shrink-0 sm:w-32">
                  <%= render "projects/thumbnail", project: project, size: "h-full w-full", flush: true %>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex h-full items-center gap-4 px-4 py-3">
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold text-ink"><%= project.name %></span>
                      <span class="mt-0.5 block text-meta text-ink-2"><%= pluralize(open_spots, SlotsHelper.count_noun(slots)) %> still open · next <%= slots.first.date.strftime("%a, %b %-d") %></span>
                    </span>
                    <span class="status-chip shrink-0 max-sm:hidden"><%= slot_window(slots.first.date) %></span>
                  </span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-2 text-ink-2">No open Sign-up spots right now.</p>
      <% end %>
    </section>

    <% if open.any? %>
      <section class="mt-7" aria-labelledby="open-teams-heading">
        <h2 id="open-teams-heading" class="text-ink">Open to you</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          <% open.each do |project| %>
            <% slots = @slots_by_project.fetch(project.id, []) %>
            <% guidance = project_guidance(project, Current.person) %>
            <li class="panel flex flex-col gap-3 overflow-hidden p-4">
              <% if project.banner_ready? %>
                <%= link_to project_path(project), class: "-mx-4 -mt-4 block overflow-hidden", aria: { label: "View #{project.name}" } do %>
                  <%= image_tag project.banner_variant(:phone), alt: "", loading: "lazy", class: "aspect-[2/1] w-full object-cover" %>
                <% end %>
              <% end %>
              <div class="min-w-0 flex-1">
                <% if project.starts_on || project.ends_on %>
                  <p class="text-label text-ink-2"><%= project_date_range(project.starts_on, project.ends_on) %></p>
                <% end %>
                <%= link_to project.name, project_path(project), class: "font-semibold text-ink" %>
                <% if project.description.present? %>
                  <p class="mt-0.5 text-meta text-ink-2"><%= project.description %></p>
                <% end %>
                <% if (momentum = momentum_line(slots)) %>
                  <p class="mt-2 text-meta text-ink-2"><%= momentum %></p>
                <% end %>
                <% if guidance&.dig(:kind) == :tasks %>
                  <p class="mt-2"><span class="badge-need"><%= unassigned_task_label(project) %></span></p>
                <% end %>
              </div>
              <% open_slots = slots.reject(&:full?) %>
              <%= link_to(open_slots.any? ? "View Open Spots" : "View Project", project_path(project), class: "btn btn-secondary max-sm:w-full", aria: { label: "#{open_slots.any? ? "View Open Spots" : "View Project"} for #{project.name}" }) %>
            </li>
          <% end %>
        </ul>
      </section>
    <% else %>
      <p class="mt-7 text-ink-2">You’re on every open Team.</p>
    <% end %>

    <% if joined.any? %>
      <section class="mt-7" aria-labelledby="joined-teams-heading">
        <h2 id="joined-teams-heading" class="text-ink">Teams you’re on</h2>
        <ul class="mt-3 border-t border-border">
          <% joined.each do |project| %>
            <li>
              <%= link_to project_path(project), class: "flex items-center justify-between gap-4 border-b border-hairline px-1 py-3 hover:bg-ghost-fill" do %>
                <span class="flex min-w-0 items-center gap-3">
                  <%= render "projects/thumbnail", project: project, size: "w-16" %>
                  <span class="min-w-0">
                    <span class="block font-semibold text-ink"><%= project.name %></span>
                    <% if (momentum = momentum_line(@slots_by_project.fetch(project.id, []))) %>
                      <span class="block text-meta text-ink-2"><%= momentum %></span>
                    <% end %>
                  </span>
                </span>
                <span class="flex shrink-0 items-center gap-1.5 text-meta text-ink-2"><%= icon(:check, class: "text-sunlit") %>On the Team</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <div class="panel mt-7 p-6">
      <p class="text-ink">No open Teams right now.</p>
      <p class="mt-1 text-meta text-ink-2">Ask a Leader where help is needed.</p>
    </div>
  <% end %>
</div>
