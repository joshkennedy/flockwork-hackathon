<% content_for :title, "Enter your code" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Enter your code</h1>
  <p class="mt-2 text-ink-2">Sent to <span class="font-medium text-ink"><%= @challenge.masked_address %></span>. Type it here, or tap the link in the message.</p>
  <%= render "error", message: @error %>
  <% if flash[:notice] %>
    <p role="status" class="mt-6 text-ink-2"><%= flash[:notice] %></p>
  <% end %>

  <%= form_with url: guest_sign_in_code_path(@project.public_token), class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :code, "6-digit code", class: "block text-label font-medium text-ink-2" %>
      <%= f.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric",
            pattern: "[0-9 ]*", maxlength: 7, class: "mt-2 block w-full field field-code" %>
    </div>

    <%= f.submit "Continue", class: "w-full btn btn-primary" %>
  <% end %>

  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
    <%= button_to "Resend Code", guest_sign_in_path(@project.public_token), params: { contact: @challenge.address, resend: 1 }, class: "btn btn-secondary" %>
    <%= link_to "Use a different email or phone", guest_sign_in_path(@project.public_token), class: "link font-medium" %>
  </div>
</div>
