<% content_for :title, "Sign-in link no longer active" %>

<div class="w-full max-w-[480px]">
  <h1 class="text-ink">This sign-in link is no longer active</h1>
  <% if @project %>
    <p class="mt-2 text-ink-2">It was already used. Get a new code to sign in.</p>
    <p class="mt-6"><%= link_to "Send a New Code", guest_sign_in_path(@project.public_token), class: "btn btn-primary" %></p>
  <% else %>
    <%# Never point a spent link at the current Public page: after a reset, that would hand the new link to whoever held the old one. %>
    <p class="mt-2 text-ink-2">It expired, was already used, or the church turned off its Public link. Open the church's Public link again to get a new code.</p>
    <p class="mt-6"><%= link_to "Go to Flockwork Home", root_path, class: "btn btn-primary" %></p>
  <% end %>
</div>
