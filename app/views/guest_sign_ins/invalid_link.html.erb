<% content_for :title, "Sign-in link not valid" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Sign-in link not valid</h1>
  <p class="mt-2 text-ink-2">That link has expired or was already used.</p>
  <% if @project %>
    <p class="mt-6"><%= link_to "Send a New Code", guest_sign_in_path(@project.public_token), class: "btn btn-primary" %></p>
  <% end %>
</div>
