<% content_for :title, "What’s your name?" %>

<div class="w-full max-w-[480px]">
  <h1 class="text-ink">What’s your name?</h1>
  <% if @challenge.slot %>
    <p class="mt-2 text-meta text-ink-2" data-chosen-slot><%= slot_summary(@challenge.slot) %></p>
  <% else %>
    <p class="mt-2 text-ink-2">So <%= @project.organization.name %> knows who’s helping.</p>
  <% end %>
  <%= render "error", message: @person&.errors&.full_messages&.to_sentence %>

  <%= form_with url: guest_sign_in_name_path(@project.public_token), class: "mt-6 space-y-5" do |f| %>
    <div>
      <%# The heading already asks for it, so the label stays for screen readers only. %>
      <%= f.label :name, "Name", class: "sr-only" %>
      <%= f.text_field :name, value: params[:name], required: true, autofocus: true, autocomplete: "name", placeholder: "First and last name", class: "block w-full field",
            aria: ({ invalid: true, describedby: "sign-in-error" } if @person&.errors&.any?) %>
    </div>

    <%= f.submit (@challenge.slot ? "Confirm My Spot" : "Continue"), class: "w-full btn btn-primary" %>
  <% end %>

  <p class="mt-3 sm:mt-6"><%= link_to "Back to #{@project.name}", public_project_path(@project.public_token, anchor: (dom_id(@challenge.slot) if @challenge.slot)), class: "link inline-block py-3.5 text-meta font-medium text-ink-2 sm:py-0" %></p>
</div>
