<% content_for :title, "Sign in to help" %>

<div class="w-full max-w-[480px]">
  <h1 class="text-ink">Sign in to help</h1>
  <% if @slot %>
    <p class="mt-2 text-meta text-ink-2" data-chosen-slot><%= slot_summary(@slot) %></p>
  <% else %>
    <p class="mt-2 text-ink-2">We’ll send you a code. No password, no account to set up.</p>
  <% end %>
  <%= render "error", message: @error %>

  <%= form_with url: guest_sign_in_path(@project.public_token), class: "mt-6 space-y-5" do |f| %>
    <%= hidden_field_tag :slot_id, @slot.id if @slot %>
    <div>
      <%= f.label :contact, "Email or mobile number", class: "block text-label font-medium text-ink-2" %>
      <%= f.text_field :contact, value: params[:contact], required: true, autofocus: true, autocomplete: "email",
            autocapitalize: "none", spellcheck: false, aria: { invalid: (true if @error), describedby: [ ("sign-in-error" if @error), "contact-texts" ].compact.join(" ") }, class: "mt-2 block w-full field" %>
      <p id="contact-texts" class="mt-2 text-meta text-ink-2">Msg &amp; data rates may apply. Reply STOP to opt out.</p>
    </div>

    <%= f.submit "Send Me a Code", class: "w-full btn btn-primary" %>
  <% end %>

  <p class="mt-3 sm:mt-6"><%= link_to "Back to #{@project.name}", public_project_path(@project.public_token), class: "link inline-block py-3.5 text-meta font-medium text-ink-2 sm:py-0" %></p>
</div>
