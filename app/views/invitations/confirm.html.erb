<% content_for :title, "Check your inbox" %>

<div class="mx-auto w-full max-w-xl">
  <h1 class="text-ink">Check your inbox</h1>
  <p class="mt-2 leading-normal text-ink-2">This Invitation is for <span class="font-medium text-ink"><%= @invitation.person.email %></span>. A secure sign-in link was sent there recently.</p>
  <% if Current.person %>
    <p class="mt-3 leading-normal text-ink-2">You are signed in as <%= Current.person.email %>.</p>
    <%= button_to "Sign Out and Continue", session_path(return_to: invitation_path(params[:token])), method: :delete, class: "mt-5 btn btn-primary" %>
  <% else %>
    <p class="mt-3 leading-normal text-ink-2">Open the link in that inbox to return to Flockwork and respond.</p>
  <% end %>
</div>
