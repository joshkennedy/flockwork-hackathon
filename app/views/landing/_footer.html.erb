<footer class="lp-footer">
  <div class="lp-footer-cols">
    <div>
      <span class="lp-footer-mark" role="img" aria-label="Flockwork"><%= render "landing/mark" %></span>
      <p class="lp-footer-tag">Project planning for your church. Everything between the idea and the day.</p>
    </div>
    <nav aria-labelledby="footer-features">
      <h2 id="footer-features">Features</h2>
      <% MarketingPage.in_section(:feature).each do |page| %>
        <%= link_to page.label, page.path %>
      <% end %>
      <%= link_to "All features", MarketingPage.find("features").path %>
    </nav>
    <nav aria-labelledby="footer-start">
      <h2 id="footer-start">Get started</h2>
      <%= link_to "Demo", new_demo_session_path %>
      <%= link_to MarketingPage.find("pricing").label, MarketingPage.find("pricing").path %>
      <%= link_to "Sign up", sign_up_path %>
      <%= link_to "Sign in", new_sign_in_request_path %>
    </nav>
    <nav aria-labelledby="footer-company">
      <h2 id="footer-company">Company</h2>
      <% MarketingPage.in_section(:company).each do |page| %>
        <%= link_to page.label, page.path %>
      <% end %>
    </nav>
  </div>
  <p class="lp-footer-legal">
    <span>© <%= Date.current.year %> Outpost Labs LLC</span>
    <% MarketingPage.in_section(:legal).each do |page| %>
      <%= link_to page.label, page.path %>
    <% end %>
  </p>
  <p class="lp-footer-word" aria-hidden="true">Flockwork</p>
</footer>
