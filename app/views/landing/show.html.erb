<% content_for :title, "Flockwork" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Flockwork</h1>
  <p class="mt-2 text-ink-2">A shared space where church teams plan and run ministry together.</p>

  <h2 class="mt-7 text-ink">Create a Workspace</h2>

  <%= form_with url: workspaces_path, class: "mt-4 space-y-4" do |f| %>
    <div>
      <%= f.label :church_name, "Church name", class: "block text-label font-medium text-ink-2" %>
      <%= f.text_field :church_name, required: true, class: "mt-1 block w-full field" %>
    </div>

    <div>
      <%= f.label :your_name, "Your name", class: "block text-label font-medium text-ink-2" %>
      <%= f.text_field :your_name, required: true, autocomplete: "name", class: "mt-1 block w-full field" %>
    </div>

    <div>
      <%= f.label :email, "Your email", class: "block text-label font-medium text-ink-2" %>
      <%= f.email_field :email, required: true, autocomplete: "email", class: "mt-1 block w-full field" %>
    </div>

    <%= f.submit "Create a Workspace", class: "w-full btn btn-primary" %>
  <% end %>
</div>
