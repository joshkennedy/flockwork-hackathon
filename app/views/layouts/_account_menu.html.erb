<%# The avatar opens the account menu: a dropdown on desktop, a sheet on phones. %>
<% name = Current.person.name %>
<details class="account-menu relative" name="app-bar">
  <summary class="app-bar-button" title="Account">
    <%= avatar(Current.person) %>
    <%# Who is signed in, and to which church, readable without opening the menu. %>
    <span class="sr-only">Account, <span data-signed-in-as><%= name %></span>, <span data-organization-name><%= Current.organization.name %></span></span>
  </summary>
  <div class="popover-in account-sheet">
    <div class="flex items-center gap-2.5 px-2 pb-2.5 pt-2">
      <%= avatar(Current.person) %>
      <span class="min-w-0">
        <span class="block truncate text-meta font-semibold"><%= name %></span>
        <span class="block truncate text-label text-ink-2"><%= Current.organization.name %></span>
      </span>
    </div>
    <%# The church name lives here; switching is offered only to someone in several churches. %>
    <% if other_churches? %>
      <%= link_to new_organization_choice_path, class: "account-item" do %>
        <span>Switch Church</span>
      <% end %>
    <% end %>
    <%= link_to profile_path, class: "account-item" do %>
      <span>Profile</span>
    <% end %>
    <%= link_to settings_path, class: "account-item" do %>
      <span>Settings</span>
    <% end %>
    <%= link_to "Terms", terms_path, class: "account-item" %>
    <%= link_to "Privacy policy", privacy_path, class: "account-item" %>
    <hr class="my-1 border-hairline">
    <%= button_to session_path, method: :delete, class: "account-item" do %>
      <span>Sign Out</span>
    <% end %>
  </div>
</details>
