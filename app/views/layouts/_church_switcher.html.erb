<%# The church name sits at the top of the sidebar. It links to the choice page only when the Person belongs to several Organizations. %>
<% switchable = other_churches? %>
<% inner = capture do %>
  <span class="avatar sm"><%= person_initials(Current.organization.name) %></span>
  <span class="min-w-0 flex-1 truncate text-meta font-semibold" data-organization-name><%= Current.organization.name %></span>
  <%= icon(:updown, class: "text-ink-2") if switchable %>
<% end %>
<% classes = "mb-3 flex min-h-11 min-w-0 items-center gap-2.5 rounded-tile px-2 py-1.5 text-ink" %>
<% if switchable %>
  <%= link_to new_organization_choice_path, class: "#{classes} hover:bg-nav-active", aria: { label: "Switch church, #{Current.organization.name}" } do %><%= inner %><% end %>
<% else %>
  <div class="<%= classes %>"><%= inner %></div>
<% end %>
