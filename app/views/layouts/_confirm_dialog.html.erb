<%# Shown by Turbo.config.forms.confirm (application.js) for any form with data-turbo-confirm. %>
<dialog id="confirm-dialog" class="modal confirm-dialog" aria-labelledby="confirm-dialog-message" data-turbo-permanent>
  <form method="dialog" class="modal-panel">
    <p id="confirm-dialog-message" class="text-heading text-ink"></p>
    <div class="mt-6 flex justify-end gap-2">
      <button value="cancel" class="btn btn-secondary" autofocus>Cancel</button>
      <button value="confirm" class="btn btn-primary" data-confirm-label>Confirm</button>
    </div>
  </form>
</dialog>
