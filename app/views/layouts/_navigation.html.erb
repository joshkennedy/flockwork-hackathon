<p class="mb-6 px-3 text-meta font-medium"><%= Current.workspace.name %></p>
<nav aria-label="Main navigation" class="grid gap-0.5">
  <% workspace_navigation.each do |label, path, symbol| %>
    <%= link_to path, class: "nav-item", aria: { current: ("page" if navigation_current?(path)), label: ("Notifications, #{unread_notification_count} unread" if symbol == :notifications) } do %>
      <%= icon(symbol) %>
      <span><%= label %></span>
      <% if symbol == :notifications && unread_notification_count.positive? %>
        <span class="ml-auto font-semibold"><%= unread_notification_count %></span>
      <% end %>
    <% end %>
  <% end %>
</nav>
<div class="mt-auto pt-10">
  <%= link_to edit_profile_path, class: "nav-item" do %>
    <%= icon(:people) %>
    <span><%= Current.person.name %><span class="block text-label font-normal text-ink-2">Profile</span></span>
  <% end %>
  <%= button_to session_path, method: :delete, class: "nav-item w-full text-left" do %>
    <%= icon(:sign_out) %> Sign out
  <% end %>
</div>
