<nav aria-label="Main navigation" class="grid gap-0.5">
  <% organization_navigation.each do |label, path, symbol| %>
    <%= link_to path, class: "nav-item", aria: { current: ("page" if navigation_current?(path)), label: ("Notifications, #{unread_notification_count} unread" if symbol == :notifications) } do %>
      <%= icon(symbol) %>
      <span><%= label %></span>
      <% if symbol == :notifications && unread_notification_count.positive? %>
        <span class="ml-auto font-semibold"><%= unread_notification_count %></span>
      <% end %>
    <% end %>
  <% end %>
</nav>
