<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Flockwork" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Flockwork">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="view-transition" content="same-origin">
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen <%="bg-frame" if authenticated? %>">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-panel focus:p-3">Skip to content</a>
    <% if authenticated? %>
      <div class="min-h-screen p-2 md:grid md:grid-cols-[232px_minmax(0,1fr)]">
        <aside class="sticky top-2 hidden h-[calc(100dvh-16px)] min-w-0 flex-col px-4 pb-3 pt-3.5 md:flex" aria-label="Organization">
          <%= link_to "Flockwork", home_path, class: "mb-6 px-2 font-display text-wordmark" %>
          <%= render "layouts/navigation" %>
        </aside>
        <header class="relative flex min-h-14 items-center justify-between px-2 md:hidden">
          <%= link_to "Flockwork", home_path, class: "font-display text-wordmark" %>
          <details class="group">
            <summary class="btn btn-text list-none [&::-webkit-details-marker]:hidden"><%= icon(:menu) %><span>Menu</span></summary>
            <div class="popover-in absolute inset-x-0 top-full z-30 flex flex-col rounded-panel border border-border bg-panel p-4 shadow-float">
              <%= render "layouts/navigation" %>
            </div>
          </details>
        </header>
        <div class="panel min-h-[calc(100dvh-72px)] min-w-0 md:min-h-0">
          <nav aria-label="Breadcrumbs" class="flex h-topbar-h min-w-0 items-center gap-2 border-b border-hairline px-4 text-label text-ink-2 md:px-7">
            <%= render "layouts/breadcrumbs" %>
          </nav>
          <main id="main-content" class="min-w-0 p-4 pb-10 md:p-7 md:pb-10">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="mx-auto max-w-xl px-4 py-7 sm:py-10">
        <%= link_to "Flockwork", root_path, class: "mb-10 block font-display text-wordmark" %>
        <main id="main-content"><%= yield %></main>
      </div>
    <% end %>
  </body>
</html>
