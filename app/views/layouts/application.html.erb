<!DOCTYPE html>
<html lang="en"<%= " data-dark" if appearance == "dark" %>>
  <head>
    <% if appearance == "system" %>
      <script nonce="<%= content_security_policy_nonce %>">
        {
        const darkQuery = matchMedia("(prefers-color-scheme: dark)")
        const followDevice = () => document.documentElement.toggleAttribute("data-dark", darkQuery.matches)
        followDevice()
        darkQuery.addEventListener("change", () => { if (!document.cookie.includes("appearance=")) followDevice() })
        }
      </script>
    <% end %>
    <title><%= content_for(:title) || "Flockwork" %></title>
    <meta name="theme-color" content="<%= appearance == "dark" ? "#141413" : "#F3F2EF" %>"<%= ' media="(prefers-color-scheme: light)"'.html_safe if appearance == "system" %>>
    <% if appearance == "system" %><meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)"><% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Flockwork">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Redirecting back to the same page morphs it in place and keeps the scroll position. %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="<%= icon_path(c: mark_color.delete("#")) %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="global-search" data-action="keydown@window->global-search#shortcut turbo:before-morph-element->global-search#keepOpen" style="<%= mark_color_style %>" class="min-h-screen <%="bg-frame" if authenticated? %>">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-panel focus:p-3">Skip to content</a>
    <% if authenticated? %>
      <div class="min-h-screen p-2 pb-[calc(64px+env(safe-area-inset-bottom))] md:grid md:grid-cols-[232px_minmax(0,1fr)] md:pb-2">
        <aside class="sticky top-2 hidden h-[calc(100dvh-16px)] min-w-0 flex-col px-4 pb-3 pt-3.5 md:flex" aria-label="Organization">
          <%= render "layouts/wordmark", path: home_path, class: "mb-6 px-2" %>
          <%= render "layouts/navigation" %>
          <%= render "layouts/account_menu" %>
        </aside>
        <header class="relative flex min-h-14 items-center justify-between px-2 md:hidden">
          <%= render "layouts/wordmark", path: home_path %>
          <div class="flex items-center">
            <%= link_to notifications_path, class: "relative grid size-11 place-items-center rounded-nav text-ink", aria: { label: (unread_notification_count.positive? ? "Notifications, #{unread_notification_count} unread" : "Notifications") } do %>
              <%= icon(:notifications, class: "size-5") %>
              <% if unread_notification_count.positive? %>
                <span class="absolute right-0 top-1 min-w-4 rounded-badge bg-ink px-1 text-center text-[10px] font-semibold leading-4 text-panel tabular-nums" aria-hidden="true"><%= unread_notification_count %></span>
              <% end %>
            <% end %>
            <%= render "layouts/account_menu", sidebar: false %>
          </div>
        </header>
        <div class="panel relative min-h-[calc(100dvh-72px)] min-w-0 md:min-h-0">
          <div class="header-wash <%= content_for(:wash) %>" aria-hidden="true" data-controller="wash">
            <svg><filter id="wash-grain"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" stitchTiles="stitch"/><feColorMatrix values="0 0 0 0 .08 0 0 0 0 .08 0 0 0 0 .07 0 0 0 .1 0"/></filter><rect width="100%" height="100%" filter="url(#wash-grain)"/></svg>
          </div>
          <nav aria-label="Breadcrumbs" class="relative flex h-topbar-h min-w-0 items-center gap-2 border-b border-ink/6 px-4 text-label text-ink-2 md:px-7">
            <%= render "layouts/breadcrumbs" %>
            <%= link_to search_path, class: "search-trigger ml-auto", data: { action: "global-search#open" }, aria: { label: "Search Flockwork", keyshortcuts: "Meta+k Control+k" } do %>
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
              <span>Search</span><kbd data-global-search-target="shortcut">⌘ K</kbd>
            <% end %>
          </nav>
          <main id="main-content" class="relative min-w-0 p-4 pb-10 md:p-7 md:pb-10">
            <%= yield %>
          </main>
        </div>
        <%= render "layouts/tab_bar" %>
      </div>
      <%= render "layouts/toasts" %>
      <%= render "layouts/confirm_dialog" %>
      <%= render "search/palette" %>
    <% else %>
      <header class="public-header">
        <%= render "layouts/wordmark", path: root_path %>
        <nav aria-label="Main navigation">
          <%= link_to "Explore the demo", new_demo_session_path %>
          <%= link_to "Sign in", new_sign_in_request_path %>
        </nav>
      </header>
      <% if controller_name == "landing" %>
        <main id="main-content" class="marketing"><%= yield %></main>
        <footer class="public-footer"><span>A shared space for the work of church.</span><%= link_to "Flockwork", root_path %></footer>
      <% else %>
        <%# Sign-in, sign-up and invitation pages: the form beside the recorded sign-up scene. %>
        <main id="main-content" class="auth-split">
          <div class="auth-form">
            <% if flash[:alert] %><p class="auth-error" role="alert"><%= flash[:alert] %></p><% end %>
            <%= yield %>
          </div>
          <div class="auth-art" aria-hidden="true">
            <%= render "landing/scene", name: "auth", width: 600, height: 820, alt: "" %>
          </div>
        </main>
      <% end %>
    <% end %>
  </body>
</html>
