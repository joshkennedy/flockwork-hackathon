<!DOCTYPE html>
<html lang="en"<%= " data-dark" if appearance == "dark" %>>
  <head>
    <%= render "layouts/device_theme" %>
    <title><%= content_for(:title) || "Flockwork" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Flockwork">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Redirecting back to the same page morphs it in place and keeps the scroll position. %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
    <% unless marketing_page? %><meta name="robots" content="noindex"><% end %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="<%= icon_path(c: mark_color.delete("#")) %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="global-search" data-action="keydown@window->global-search#shortcut turbo:before-morph-element->global-search#keepOpen" style="<%= mark_color_style %>" class="min-h-screen <%="bg-frame" if authenticated? && !marketing_page? %>">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-panel focus:p-3">Skip to content</a>
    <% if authenticated? && !marketing_page? %>
      <div class="app-shell relative min-h-screen pb-[calc(64px+env(safe-area-inset-bottom))] md:pb-0">
        <div class="app-bar-shell" data-controller="app-bar">
          <header class="app-bar">
            <%= render "layouts/wordmark", path: home_path %>
            <%= render "layouts/navigation" %>
            <div class="flex items-center md:gap-1 md:justify-self-end">
              <%= link_to search_path, class: "search-trigger rounded-full md:h-9 md:px-3.5 max-md:size-11 max-md:justify-center max-md:border-0 max-md:bg-transparent max-md:p-0 max-md:text-ink", data: { action: "global-search#open" }, aria: { label: "Search Flockwork", keyshortcuts: "Meta+k Control+k" } do %>
                <%= icon(:search, class: "max-md:size-5") %>
                <span class="max-md:hidden">Search</span><kbd data-global-search-target="shortcut">⌘ K</kbd>
              <% end %>
              <%= render "layouts/notifications_menu" %>
              <%= render "layouts/account_menu" %>
            </div>
          </header>
        </div>
        <%# The page is a sheet on the frame at every width; the wash tints its top. %>
        <div class="page-surface">
          <div class="header-wash <%= content_for(:wash) %>" aria-hidden="true" data-controller="wash">
            <svg><filter id="wash-grain"><feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" stitchTiles="stitch"/><feColorMatrix values="0 0 0 0 .08 0 0 0 0 .08 0 0 0 0 .07 0 0 0 .1 0"/></filter><rect width="100%" height="100%" filter="url(#wash-grain)"/></svg>
          </div>
          <main id="main-content" class="relative mx-auto min-w-0 max-w-page-w p-4 pb-10 md:px-7 md:pb-12 md:pt-12">
            <%# Top-level pages name themselves in their heading; only pages inside a Project show where they sit. %>
            <% if content_for?(:breadcrumbs) || @project&.persisted? %>
              <nav aria-label="Breadcrumbs" class="mb-4 flex min-w-0 items-center gap-2 text-label text-ink-2">
                <%= render "layouts/breadcrumbs" %>
              </nav>
            <% end %>
            <%= yield %>
          </main>
        </div>
        <%= render "layouts/tab_bar" %>
      </div>
      <%= render "layouts/toasts" %>
      <%= render "layouts/confirm_dialog" %>
      <%= render "search/palette" %>
    <% else %>
      <%= render "landing/header" %>
      <% if marketing_page? %>
        <main id="main-content" class="marketing"><%= yield %></main>
        <%= render "landing/footer" %>
      <% else %>
        <%# Sign-in, sign-up and invitation pages: the form beside the recorded sign-up scene. %>
        <main id="main-content" class="auth-split">
          <div class="auth-form">
            <% if flash[:alert] %><p class="auth-error" role="alert"><%= flash[:alert] %></p><% end %>
            <%= yield %>
          </div>
          <div class="auth-art" aria-hidden="true">
            <%= render "landing/scene", name: "auth", width: 600, height: 820, alt: "" %>
          </div>
        </main>
      <% end %>
    <% end %>
  </body>
</html>
