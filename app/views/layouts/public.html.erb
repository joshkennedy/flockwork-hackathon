<!DOCTYPE html>
<html lang="en"<%= " data-dark" if appearance == "dark" %>>
  <head>
    <%= render "layouts/device_theme" %>
    <title><%= content_for(:title) || "Flockwork" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="<%= icon_path(c: mark_color.delete("#")) %>" type="image/svg+xml">
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# Plain navigation keeps the #slot_ anchor on redirects, which a Turbo fetch would drop. JS is here for the toasts. %>
  <body style="<%= mark_color_style %>" class="min-h-screen bg-page" data-turbo="false" data-public-layout>
    <div class="mx-auto w-full max-w-3xl px-4 py-7 sm:py-10">
      <div class="mb-10 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <%= render "layouts/wordmark", path: root_path %>
        <%= yield :account %>
      </div>
      <main><%= yield %></main>
    </div>
    <%= render "layouts/toasts" %>
  </body>
</html>
