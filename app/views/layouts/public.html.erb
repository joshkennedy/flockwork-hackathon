<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Project" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body class="min-h-screen bg-page">
    <div class="mx-auto w-full max-w-3xl px-4 py-7 sm:py-10">
      <%= link_to "Flockwork", root_path, class: "mb-10 block font-display text-wordmark" %>
      <main><%= yield %></main>
    </div>
  </body>
</html>
