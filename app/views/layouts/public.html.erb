<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Project" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="<%= icon_path(c: mark_color.delete("#")) %>" type="image/svg+xml">
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body style="--color-mark: <%= mark_color %>" class="min-h-screen bg-page">
    <div class="mx-auto w-full max-w-3xl px-4 py-7 sm:py-10">
      <%= render "layouts/wordmark", path: root_path, class: "mb-10" %>
      <main><%= yield %></main>
    </div>
  </body>
</html>
