<!DOCTYPE html>
<html lang="en"<%= " data-dark" if appearance == "dark" %>>
  <head>
    <%= render "layouts/device_theme" %>
    <title><%= content_for(:title) || "Flockwork" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="<%= icon_path(c: mark_color.delete("#")) %>" type="image/svg+xml">
    <link rel="manifest" href="<%= web_app_manifest_path %>">
    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "public" %>
    <%= render "layouts/analytics" %>
  </head>
  <%# Plain navigation keeps the #slot_ anchor on redirects, which a Turbo fetch would drop. JS is here for the toasts. %>
  <body style="<%= mark_color_style %>" class="min-h-screen bg-page" data-turbo="false" data-public-layout>
    <%= render "layouts/demo_notice" if @organization&.demo? %>
    <%# The sign-in steps narrow the whole column, wordmark row included, to their 480px question from 640px up. %>
    <div class="mx-auto w-full <%= controller_name == "guest_sign_ins" ? "sm:max-w-[512px]" : "max-w-3xl" %> px-4 py-7 sm:py-10">
      <div class="mb-10 flex items-center justify-between gap-4">
        <%= render "layouts/wordmark", path: root_path, class: "shrink-0" %>
        <%= yield :account %>
      </div>
      <main><%= yield %></main>
    </div>
    <%= render "layouts/toasts" %>
  </body>
</html>
