<%= form_with model: [ project, list, list_column ], class: "space-y-7" do |form| %>
  <% if list_column.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger">
      <p class="font-semibold">Fix these to continue:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% list_column.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 block w-full field" %>
  </div>

  <div>
    <%= form.label :column_type, "Type", class: "block text-label font-medium text-ink" %>
    <%= form.select :column_type, ListColumn.column_types.keys.map { |type| [ type.humanize, type ] }, {}, class: "mt-2 block w-full field" %>
  </div>

  <%= form.submit list_column.persisted? ? "Save Column" : "Add Column", class: "btn btn-primary" %>
<% end %>
