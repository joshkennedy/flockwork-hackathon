<% content_for :title, "Edit column - #{@list.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "Back to #{@project.name}", @project, class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
  <span aria-hidden="true" class="text-ink-3">/</span>
  <span class="truncate text-ink"><%= content_for(:title) %></span>
<% end %>

<div class="w-full max-w-2xl">

  <h1 class="mt-7 text-ink">Edit <%= @list_column.name %></h1>

  <div class="mt-7">
    <%= render "form", project: @project, list: @list, list_column: @list_column %>
  </div>
</div>
