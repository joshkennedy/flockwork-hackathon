<% content_for :title, "Add column - #{@list.name}" %>

<div class="mx-auto w-full max-w-2xl">
  <%= link_to "Back to #{@project.name}", @project, class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>

  <h1 class="mt-8 text-3xl font-bold text-stone-950">Add column to <%= @list.name %></h1>

  <div class="mt-8">
    <%= render "form", project: @project, list: @list, list_column: @list_column %>
  </div>
</div>
