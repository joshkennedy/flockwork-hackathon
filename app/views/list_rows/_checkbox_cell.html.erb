<%= turbo_frame_tag dom_id(list_row, "column_#{column.id}") do %>
  <% checked = list_row.cells[column.id.to_s] == true %>
  <%= button_to toggle_checkbox_project_list_list_row_path(project, list, list_row),
    method: :patch,
    params: { column_id: column.id },
    aria: { label: checked ? "Mark #{column.name} incomplete" : "Mark #{column.name} complete" },
    class: "inline-flex size-7 items-center justify-center border border-stone-500 bg-white text-base font-bold leading-none text-stone-900 hover:bg-stone-100" do %>
    <span aria-hidden="true"><%= checked ? "✓" : "" %></span>
  <% end %>
<% end %>
