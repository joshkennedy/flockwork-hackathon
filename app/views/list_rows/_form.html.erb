<%= form_with model: [ project, list, list_row ], class: "space-y-7",
      data: { turbo_frame: ("_top" unless request.headers["Turbo-Frame"] == "list-form") } do |form| %>
  <% if list_row.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
      <p class="font-semibold">Fix these to continue:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% list_row.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% list.columns.each do |column| %>
    <% field_name = "list_row[cells][#{column.id}]" %>
    <% field_id = "list_row_cells_#{column.id}" %>
    <div>
      <%= label_tag field_id, column.name, class: "block text-label font-medium text-ink" %>
      <% case column.column_type %>
      <% when "number" %>
        <%= number_field_tag field_name, list_row.cells[column.id.to_s], id: field_id, step: "any", class: "mt-2 block w-full field" %>
      <% when "date" %>
        <%= date_field_tag field_name, list_row.cells[column.id.to_s], id: field_id, class: "mt-2 block w-full field" %>
      <% when "checkbox" %>
        <%= hidden_field_tag field_name, "0", id: nil %>
        <%= check_box_tag field_name, "1", list_row.cells[column.id.to_s] == true, id: field_id, class: "mt-3 size-5 border-hairline text-ink focus:border-ink" %>
      <% when "person" %>
        <%= select_tag field_name, options_from_collection_for_select(list.project.people.order(:name), :id, :name, list_row.cells[column.id.to_s]), include_blank: "Choose a Team member", id: field_id, class: "mt-2 block w-full field" %>
      <% else %>
        <%= text_field_tag field_name, list_row.cells[column.id.to_s], id: field_id, class: "mt-2 block w-full field" %>
      <% end %>
    </div>
  <% end %>

  <%= form.submit list_row.persisted? ? "Save Row" : "Add Row", class: "btn btn-primary" %>
<% end %>
