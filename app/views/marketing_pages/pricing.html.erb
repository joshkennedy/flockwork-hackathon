<% faqs = [
  [ "Is Flockwork really free?", "Yes. Flockwork is free during beta, with every current project planning tool included and no card required." ],
  [ "What happens after the beta?", "Pricing will come later. Churches will get an email before anything is charged, and nobody will be billed automatically." ],
  [ "Is there a limit on people or projects?", "Flockwork does not promise a specific people or project limit during beta. Write to us if your church expects an unusually large workspace." ],
  [ "Who owns our church’s data?", "Your church’s workspace and the information its people add belong to your church. Write to us for a copy, a correction or a deletion." ],
  [ "Can we leave?", "Yes. Write to hello@getflockwork.com and we will delete your workspace. A delete control in the app is on the way." ]
] %>
<% marketing_head(@page, type: "SoftwareApplication", faqs: faqs, node: { applicationCategory: "BusinessApplication", operatingSystem: "Web", offers: { "@type": "Offer", price: "0", priceCurrency: "USD" } }) %>

<section class="lp-page-hero lp-pricing-hero" aria-labelledby="pricing-title">
  <div>
    <h1 id="pricing-title">Free during beta.</h1>
    <p>Plan the work in one place, so your church spends less time chasing details and more time serving people.</p>
  </div>
</section>

<section class="lp-section lp-plan-section" aria-labelledby="plan-title">
  <div class="lp-plan">
    <div>
      <p class="lp-plan-price">$0</p>
      <p class="lp-plan-terms">For your whole church, while Flockwork is in beta. No card.</p>
      <div class="lp-plan-actions">
        <%= link_to "Plan Your First Project", sign_up_path, class: "btn btn-primary" %>
        <%= link_to "Or look around the demo", new_demo_session_path, class: "link" %>
      </div>
    </div>
    <div class="lp-plan-inside">
      <h2 id="plan-title">Everything’s included.</h2>
      <ul>
        <% [ [ "signup_sheet", "Sign-up sheets" ], [ "tasks", "Tasks" ], [ "schedule", "Schedule" ], [ "budget", "Budget" ], [ "messages", "Messages" ], [ "docs", "Docs & files" ], [ "list", "Lists" ], [ "people", "People" ], [ "planner", "The Planner" ], [ "oversight", "Oversight" ] ].each do |tool, label| %>
          <li><%= planner_tool_icon(tool, size: 20) %><%= label %></li>
        <% end %>
      </ul>
    </div>
  </div>
  <p class="lp-pricing-note">Pricing comes later. Churches will get an email before anything is charged, and nobody is billed automatically.</p>
</section>

<figure class="lp-photo">
  <%= image_tag "marketing/photos/#{@page.photo}.webp", width: 1152, height: 768, loading: "lazy", alt: "Three church leaders planning together around a laptop, notebooks and coffee" %>
</figure>

<%= render "landing/faq", faqs: faqs, title: "Pricing questions." %>
<%= render "landing/close", title: "Start while it’s free." %>
