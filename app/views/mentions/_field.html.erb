<div class="min-w-0" data-controller="mention-picker" data-mention-picker-url-value="<%= mentionable_people_project_path(project) %>">
  <p id="<%= input_id %>_label" class="text-sm font-semibold text-stone-900"><%= label %></p>
  <%= form.rich_text_area :body,
        id: input_id,
        required: true,
        autofocus: local_assigns.fetch(:autofocus, false),
        class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-3 text-stone-950 focus:border-stone-950 focus:outline-none",
        aria: { labelledby: "#{input_id}_label" },
        data: { mention_picker_target: "editor" } %>

  <label class="mt-3 block text-sm text-stone-700">
    <span class="font-medium">Mention someone</span>
    <input type="search"
           id="<%= input_id %>_mention_query"
           name="mention_query"
           autocomplete="off"
           placeholder="Type a name"
           class="mt-1 block w-full bg-white px-3 py-2 text-stone-950 outline outline-1 -outline-offset-1 outline-stone-400 focus:outline-2 focus:-outline-offset-2 focus:outline-stone-950"
           data-mention-picker-target="query"
           data-action="input->mention-picker#search">
  </label>
  <div hidden class="mt-2 bg-white p-2" aria-live="polite" data-mention-picker-target="results"></div>
</div>
