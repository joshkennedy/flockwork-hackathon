<div class="min-w-0" data-controller="mention-picker" data-mention-picker-url-value="<%= mentionable_people_project_path(project) %>">
  <p id="<%= input_id %>_label" class="text-meta font-semibold text-ink"><%= label %></p>
  <%= form.rich_text_area :body,
        id: input_id,
        required: true,
        autofocus: local_assigns.fetch(:autofocus, false),
        class: "mt-2 block w-full field",
        aria: { labelledby: "#{input_id}_label" },
        data: { mention_picker_target: "editor" } %>

  <label class="mt-3 block text-label text-ink-2">
    <span class="font-medium">Mention someone</span>
    <input type="search"
           id="<%= input_id %>_mention_query"
           name="mention_query"
           autocomplete="off"
           placeholder="Type a name"
           class="field w-full"
           data-mention-picker-target="query"
           data-action="input->mention-picker#search">
  </label>
  <div hidden class="mt-2 rounded-panel bg-panel p-2 shadow-float" aria-live="polite" data-mention-picker-target="results"></div>
</div>
