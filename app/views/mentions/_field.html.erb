<div class="min-w-0" data-controller="mention-picker" data-mention-picker-url-value="<%= mentionable_people_project_path(project) %>">
  <p id="<%= input_id %>_label" class="text-meta font-semibold text-ink"><%= label %></p>
  <%= form.rich_text_area :body,
        id: input_id,
        required: true,
        autofocus: local_assigns.fetch(:autofocus, false),
        class: "mt-2 block w-full field",
        aria: { labelledby: "#{input_id}_label", describedby: "#{input_id}_mention_hint" },
        data: { mention_picker_target: "editor", action: "trix-selection-change->mention-picker#search" } %>
  <p id="<%= input_id %>_mention_hint" class="mt-1 text-label text-ink-2">Type @ to mention someone</p>
  <div hidden id="<%= input_id %>_mention_results" role="listbox" aria-label="People to mention" class="mt-2 rounded-panel bg-panel p-2 shadow-float" data-mention-picker-target="results"></div>
</div>
