<% content_for :title, "Draft a message" %>
<h1>Draft a message</h1>
<p class="mt-2 text-meta text-ink-2">Nothing is posted until you choose Post Message.</p>
<% if @error %><span hidden data-toast-entry data-toast-kind="alert"><%= @error %></span><% end %>
<% unless @message.body.present? %>
<%= form_with url: project_message_draft_path(@project), class: "mt-5 space-y-3", data: { turbo: false } do |form| %>
  <%= form.label :purpose, "Draft type", for: "draft_purpose", class: "text-meta font-semibold" %>
  <% draft_purposes = ProjectMessageDraft::PURPOSES.map do |value, label| %>
    <% [ value == "open_spots" && !@open_spots_available ? "#{label} (none in the next 7 days)" : label, value ] %>
  <% end %>
  <%= form.select :purpose, draft_purposes, { selected: @purpose, disabled: ("open_spots" unless @open_spots_available) }, id: "draft_purpose", class: "field w-full" %>
  <%= form.submit "Generate Draft", class: "btn btn-secondary" %>
<% end %>
<% end %>
<% if @message.body.present? %>
<div class="mt-6">
  <%= render "messages/plain_form", project: @project, message: @message, label: "Review your message", submit_label: "Post Message", class_name: "message-composer" %>
</div>
<% end %>
<p class="mt-4"><%= link_to "Back to Messages", project_path(@project, anchor: "tab-messages"), class: "link" %></p>
