<% content_for :title, "My Tasks" %>

<div class="mx-auto w-full max-w-2xl">
  <nav>
    <%= link_to Current.workspace.name, workspace_path(Current.workspace), class: "inline-flex min-h-11 items-center text-sm font-semibold text-stone-600 hover:text-stone-950" %>
  </nav>

  <header class="mt-6">
    <h1 class="text-4xl font-bold tracking-tight text-stone-950">My Tasks</h1>
    <p class="mt-3 text-base leading-7 text-stone-600">Open work across your Projects, ordered by due date.</p>
  </header>

  <% if @tasks.any? %>
    <ul class="mt-8 space-y-4">
      <% @tasks.each do |task| %>
        <li data-task-title="<%= task.title %>" class="bg-[#e7ede3] p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-stone-600"><%= task.project.name %></p>
              <h2 class="mt-1 text-lg font-bold text-stone-950"><%= task.title %></h2>
              <% if task.due_on.present? %>
                <p class="mt-2 text-sm text-stone-700">Due <%= task.due_on.to_fs(:long) %></p>
              <% else %>
                <p class="mt-2 text-sm text-stone-600">No due date</p>
              <% end %>
            </div>
            <%= button_to "Done",
                  mark_done_project_task_path(task.project, task, return_to: "my_tasks"),
                  class: "min-h-12 shrink-0 bg-[#1f291f] px-5 py-3 text-sm font-bold text-white hover:bg-[#354235]" %>
          </div>
          <% if task.details.present? %>
            <div class="mt-4 text-sm leading-6 text-stone-700"><%= task.details %></div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-10 bg-[#e7ede3] p-6 text-stone-700">You have no open Tasks.</p>
  <% end %>
</div>
