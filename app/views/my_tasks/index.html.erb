<% content_for :title, "My Tasks" %>

<div class="w-full max-w-2xl">
  <%= page_header "My Tasks", subtitle: "Open work across your Projects, ordered by due date." %>

  <% if @tasks.any? %>
    <ul class="mt-7 space-y-4">
      <% @tasks.each do |task| %>
        <li data-task-title="<%= task.title %>" class="tile-raised p-4">
          <div class="flex flex-col items-start justify-between gap-4 sm:flex-row">
            <div class="min-w-0">
              <p class="text-meta font-semibold text-ink-2"><%= task.project.name %></p>
              <h2 class="mt-1 text-ink"><%= task.title %></h2>
              <% if task.due_on.present? %>
                <p class="mt-2 text-meta text-ink-2">Due <%= task.due_on.to_fs(:long) %></p>
              <% else %>
                <p class="mt-2 text-meta text-ink-2">No due date</p>
              <% end %>
            </div>

          </div>
          <% if task.details.present? %>
            <div class="mt-4 text-meta leading-normal text-ink-2"><%= task.details %></div>
          <% end %>
            <%= button_to "Done",
                  mark_done_project_task_path(task.project, task, return_to: "my_tasks"),
                  class: "mt-4 btn btn-primary" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <section class="mt-7" data-my-tasks-empty>
      <h2>Nothing on your plate</h2>
      <% if @open_slots_by_project.any? %>
        <p class="mt-2 text-ink-2">These still need someone this week.</p>
        <%= render "shared/open_needs", open_slots_by_project: @open_slots_by_project %>
      <% else %>
        <p class="mt-2 text-ink-2">Every spot this week is covered. <%= link_to "See open Teams", get_involved_path, class: "font-medium text-ink underline underline-offset-2" %></p>
      <% end %>
    </section>
  <% end %>
</div>
