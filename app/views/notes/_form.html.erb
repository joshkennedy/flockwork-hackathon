<% field_prefix = "#{dom_id(notable)}_note" %>
<%= form_with url: form_url, scope: :note, class: "mt-4 space-y-3", data: { note_form: true } do |form| %>
  <%= form.hidden_field :notable_type, value: notable.class.name, id: nil %>
  <%= form.hidden_field :notable_id, value: notable.id, id: nil %>

  <div>
    <%= form.label :body, "New note", for: "#{field_prefix}_body", class: "block text-sm font-semibold text-stone-900" %>
    <%= form.text_area :body, id: "#{field_prefix}_body", required: true, rows: 3, class: "mt-1 block w-full border border-stone-400 bg-white px-3 py-2 text-sm text-stone-950" %>
  </div>

  <div class="flex flex-wrap items-end gap-3">
    <div>
      <%= form.label :visibility, for: "#{field_prefix}_visibility", class: "block text-sm font-semibold text-stone-800" %>
      <%= form.select :visibility,
        visibilities.map { |visibility| [ Note::VISIBILITY_LABELS.fetch(visibility), visibility ] },
        {}, id: "#{field_prefix}_visibility", class: "mt-1 border border-stone-400 bg-white px-3 py-2 text-sm" %>
    </div>
    <%= form.submit "Add note", class: "cursor-pointer bg-[#1f291f] px-4 py-2 text-sm font-semibold text-white hover:bg-[#354235]" %>
  </div>
<% end %>
