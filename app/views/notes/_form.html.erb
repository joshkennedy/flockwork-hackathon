<% field_prefix = "#{dom_id(notable)}_note" %>
<%# Always open: a note is one thought, so the field is there to type into instead of behind an "Add note" button. %>
<%= form_with url: form_url, scope: :note, class: "mt-4 space-y-2", data: { note_form: true } do |form| %>
  <%= form.hidden_field :notable_type, value: notable.class.name, id: nil %>
  <%= form.hidden_field :notable_id, value: notable.id, id: nil %>

  <%= form.label :body, "New note", for: "#{field_prefix}_body", class: "sr-only" %>
  <%= form.text_area :body, id: "#{field_prefix}_body", required: true, rows: 2, placeholder: "Add a note…", class: "block w-full field" %>

  <div class="flex flex-wrap items-center justify-end gap-2">
    <%= form.label :visibility, "Visible to", for: "#{field_prefix}_visibility", class: "text-meta text-ink-2" %>
    <%= form.select :visibility,
      visibilities.map { |visibility| [ Note::VISIBILITY_LABELS.fetch(visibility), visibility ] },
      {}, id: "#{field_prefix}_visibility", class: "field" %>
    <%= form.submit "Save Note", class: "btn btn-secondary" %>
  </div>
<% end %>
