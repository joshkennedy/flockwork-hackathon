<%# Kinds with their own body live in kinds/; every other kind falls back to the generic one. %>
<% partial = "notification_mailer/kinds/#{@notification.kind}" %>
<%= render lookup_context.exists?(partial, [], true) ? partial : "notification_mailer/kinds/generic" %>

<% content_for :footer do %>
  You get emails for <%= Notification::KINDS.fetch(@notification.kind).fetch(:label) %>. <%= link_to "Change your email preferences", settings_url(anchor: "settings-notifications"), style: "color:#9A9893;text-decoration:underline" %>
<% end %>
