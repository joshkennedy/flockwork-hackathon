<% content_for :title, "Notifications" %>

<div class="w-full max-w-3xl">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <%= link_to "← #{Current.workspace.name}", workspace_path(Current.workspace), class: "text-meta text-ink-2 hover:text-ink-2" %>
      <h1 class="mt-1 text-ink">Notifications</h1>
    </div>
    <% if @notifications.any?(&:unread?) %>
      <%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "btn btn-text" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <ol class="mt-7 space-y-3">
      <% @notifications.each do |notification| %>
        <li data-notification-id="<%= notification.id %>" class="border-b border-hairline py-4 <%="font-semibold" if notification.unread? %>">
          <div class="flex flex-wrap items-start justify-between gap-5">
            <div class="min-w-0">
              <%= link_to notification.message, project_path(notification.project), class: "text-ink hover:text-black" %>
              <p class="mt-1 text-label font-normal text-ink-2"><%= time_ago_in_words(notification.created_at) %> ago</p>
            </div>
            <% if notification.unread? %>
              <%= button_to "Mark read", mark_read_notification_path(notification), method: :patch, class: "shrink-0 btn btn-text" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-7 text-ink-2">You have no notifications yet.</p>
  <% end %>
</div>
