<% content_for :title, "Notifications" %>

<div class="w-full max-w-3xl mx-auto">
  <div class="flex items-end justify-between gap-4">
    <div>
      <%= link_to "← #{Current.workspace.name}", workspace_path(Current.workspace), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <h1 class="mt-1 text-3xl font-bold text-gray-900">Notifications</h1>
    </div>
    <% if @notifications.any?(&:unread?) %>
      <%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "text-sm font-medium text-gray-700 hover:text-gray-950 cursor-pointer" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <ol class="mt-8 space-y-3">
      <% @notifications.each do |notification| %>
        <li data-notification-id="<%= notification.id %>" class="rounded-lg bg-[#f1f4eb] px-4 py-4 <%= "font-semibold" if notification.unread? %>">
          <div class="flex items-start justify-between gap-5">
            <div class="min-w-0">
              <%= link_to notification.message, project_path(notification.project), class: "text-gray-900 hover:text-black" %>
              <p class="mt-1 text-xs font-normal text-gray-500"><%= time_ago_in_words(notification.created_at) %> ago</p>
            </div>
            <% if notification.unread? %>
              <%= button_to "Mark read", mark_read_notification_path(notification), method: :patch, class: "shrink-0 text-sm font-normal text-gray-600 hover:text-gray-950 cursor-pointer" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-8 text-gray-600">You have no notifications yet.</p>
  <% end %>
</div>
