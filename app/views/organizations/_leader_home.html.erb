<div class="mt-7 grid gap-7 lg:grid-cols-[minmax(0,1fr)_320px]">
  <section class="min-w-0" aria-labelledby="your-projects-heading" data-home-section="your-projects">
    <h2 id="your-projects-heading">Your Projects</h2>
    <p class="text-meta text-ink-2">The one thing each needs next.</p>
    <% if @projects.any? %>
      <ul class="mt-3 grid gap-2">
        <% @projects.each do |project| %>
          <% guidance = project_guidance(project, @person) %>
          <% planned = project_planned?(project) %>
          <li class="tile-raised flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <%= link_to project.name, project_path(project), class: "font-semibold text-ink" %>
              <p class="mt-0.5 text-meta text-ink-2">
                <% if guidance %><span class="badge-need"><%= guidance[:title] %></span><% else %><%= planned ? "On track" : "Nothing planned yet" %><% end %>
                <%= "· #{project_date_range(project.starts_on, project.ends_on)}" if project.starts_on || project.ends_on %>
              </p>
            </div>
            <% if guidance&.dig(:kind) == :spots %>
              <%= link_to "Fill spots", project_path(project), class: "btn btn-secondary btn-sm shrink-0" %>
            <% elsif guidance&.dig(:kind) == :tasks %>
              <%= link_to "Assign tasks", project_path(project, anchor: "tab-tasks"), class: "btn btn-secondary btn-sm shrink-0" %>
            <% elsif !planned && Policy.can?(@person, :plan, project) %>
              <%= link_to "Plan it", new_project_planner_session_path(project), class: "btn btn-secondary btn-sm shrink-0" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-ink-2">None of the Projects you lead are active right now.</p>
    <% end %>
  </section>

  <aside class="min-w-0">
    <%= render "organizations/your_week" %>
  </aside>
</div>
