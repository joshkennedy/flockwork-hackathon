<% content_for :wash, "wash-volunteer" %>
<div class="mt-7 grid max-w-2xl gap-7">
  <section aria-labelledby="your-projects-heading" data-home-section="your-projects">
    <h2 id="your-projects-heading">Your Projects</h2>
    <% if @projects.any? %>
      <ul class="mt-3 divide-y divide-hairline border-y border-hairline">
        <% @projects.each do |project| %>
          <li>
            <%= link_to project_path(project), class: "flex items-center justify-between gap-4 py-3 hover:bg-ghost-fill" do %>
              <span class="font-semibold text-ink"><%= project.name %></span>
              <span class="text-meta text-ink-2"><%= project_date_range(project.starts_on, project.ends_on) if project.starts_on || project.ends_on %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-meta text-ink-2">You’re not on an active Project right now.</p>
    <% end %>
  </section>

  <section aria-labelledby="open-needs-heading" data-home-section="open-needs">
    <h2 id="open-needs-heading">Still needed on your Projects</h2>
    <% if @open_slots_by_project.any? %>
      <%= render "shared/open_needs", open_slots_by_project: @open_slots_by_project %>
    <% else %>
      <p class="mt-2 text-meta text-ink-2">Every spot this week is filled.</p>
    <% end %>
  </section>

  <section class="border-t border-border pt-7" aria-labelledby="get-involved-heading" data-home-section="get-involved">
    <h2 id="get-involved-heading">Other ways to help</h2>
    <% if @open_teams.any? %>
      <ul class="mt-3 grid gap-2">
        <% @open_teams.each do |project| %>
          <li class="panel flex flex-col gap-3 p-4">
            <div class="min-w-0">
              <% if project.starts_on || project.ends_on %>
                <p class="text-label text-ink-2"><%= project_date_range(project.starts_on, project.ends_on) %></p>
              <% end %>
              <p class="font-semibold text-ink"><%= project.name %></p>
              <% if project.description.present? %>
                <p class="mt-0.5 text-meta text-ink-2"><%= project.description %></p>
              <% end %>
            </div>
            <%= link_to "See What’s Needed", project_path(project), class: "btn btn-secondary self-start max-sm:w-full", aria: { label: "See What’s Needed for #{project.name}" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-meta text-ink-2">No open Teams right now.</p>
    <% end %>
  </section>
</div>
