<%# An empty section is one line, heading and sentence together, so the role's own view starts higher. %>
<section class="<%= @my_tasks.any? ? "mt-7" : "mt-6" %>" aria-labelledby="your-tasks-heading" data-home-section="your-tasks">
  <div class="flex flex-wrap items-baseline gap-x-3">
    <h2 id="your-tasks-heading">Your Tasks</h2>
    <% if @my_tasks.empty? %><p class="text-meta text-ink-2">No Tasks assigned to you right now.</p><% end %>
  </div>
  <% if @my_tasks.any? %>
    <ul class="mt-3 divide-y divide-hairline border-y border-hairline">
      <% @my_tasks.each do |task| %>
        <li data-task-title="<%= task.title %>" class="flex items-start gap-3 py-3">
          <%= button_to mark_done_project_task_path(task.project, task, return_to: "home"), class: "task-check mt-0.5", form_class: "shrink-0", aria: { label: "Mark #{task.title} done" } do %>
            <%= icon(:check, class: "task-check-glyph") %>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ink"><%= task.title %></p>
            <p class="text-meta text-ink-2"><%= task.project.name %><% if task.due_on %> · <time datetime="<%= task.due_on.iso8601 %>" title="<%= task.due_on.to_fs(:long) %>" class="<%= "font-medium text-ink" if task.due_on < Date.current %>"><%= task_due_label(task.due_on) %></time><% end %></p>
            <% if task.details.present? %>
              <p class="mt-1 line-clamp-2 text-meta leading-normal text-ink-2"><%= task.details.to_plain_text %></p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="<%= @my_slots.any? || @my_tasks.any? ? "mt-7" : "mt-3" %>" aria-labelledby="coming-up-heading" data-home-section="coming-up">
  <div class="flex flex-wrap items-baseline gap-x-3">
    <h2 id="coming-up-heading">Coming up</h2>
    <% if @my_slots.empty? %><p class="text-meta text-ink-2">No sign-up spots ahead for you.</p><% end %>
  </div>
  <% if @my_slots.any? %>
    <ul class="mt-3 divide-y divide-hairline border-y border-hairline">
      <% @my_slots.each do |slot| %>
        <li>
          <%= link_to project_path(slot.project), class: "flex items-start gap-3 py-3 hover:bg-ghost-fill" do %>
            <%= icon(:check, class: "mt-0.5 text-sunlit") %>
            <span class="min-w-0">
              <span class="block font-semibold text-ink"><%= slot.date == Date.current ? "Today" : slot.date.strftime("%A, %B %-d") %> · <%= slot.label %></span>
              <span class="block text-meta text-ink-2"><%= slot.project.name %><%= " · #{slot.starts_at_time.strftime("%-l:%M %p")}" if slot.starts_at_time %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
