<section aria-labelledby="your-week-heading" data-home-section="your-week">
  <h2 id="your-week-heading">Coming up for you</h2>
  <% if @my_slots.any? || @my_tasks.any? %>
    <ul class="mt-3 divide-y divide-hairline border-y border-hairline">
      <% @my_slots.each do |slot| %>
        <li>
          <%= link_to project_path(slot.project), class: "flex items-start gap-3 py-3 hover:bg-ghost-fill" do %>
            <%= icon(:check, class: "mt-0.5 text-sunlit") %>
            <span class="min-w-0">
              <span class="block font-semibold text-ink"><%= slot.date == Date.current ? "Today" : slot.date.strftime("%A, %B %-d") %> · <%= slot.label %></span>
              <span class="block text-meta text-ink-2"><%= slot.project.name %><%= " · #{slot.starts_at_time.strftime("%-l:%M %p")}" if slot.starts_at_time %></span>
            </span>
          <% end %>
        </li>
      <% end %>
      <% @my_tasks.each do |task| %>
        <li>
          <%= link_to project_path(task.project), class: "flex items-start gap-3 py-3 hover:bg-ghost-fill" do %>
            <span class="mt-0.5 size-4 shrink-0 rounded-badge border-[1.5px] border-border-strong" aria-hidden="true"></span>
            <span class="min-w-0">
              <span class="block font-semibold text-ink"><%= task.title %></span>
              <span class="block text-meta text-ink-2"><%= task.project.name %><%= " · Due #{task.due_on.strftime("%B %-d")}" if task.due_on %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= link_to "All my Tasks", my_tasks_path, class: "mt-3 inline-block text-meta font-medium text-ink-2 hover:text-ink" if @my_tasks.any? %>
  <% else %>
    <p class="mt-2 text-meta text-ink-2">Nothing on your plate right now.</p>
  <% end %>
</section>
