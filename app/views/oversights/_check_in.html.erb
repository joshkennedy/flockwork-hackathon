<div class="mt-2 text-meta text-ink-2">
  <% if last %>
    <p>Checked in <%= last.on.strftime("%b %-d") %> by <%= person_pill(last.checked_in_by, fallback: "a former Leader") %></p>
    <% if last.note.present? && Policy.can?(Current.person, :view_note, last) %>
      <p class="mt-1">Admin note: <%= last.note %></p>
    <% end %>
  <% else %>
    <p>No check-in logged yet.</p>
  <% end %>

  <%= form_with url: person_check_ins_path(person), class: "mt-3 flex flex-wrap items-center gap-2" do %>
    <%= submit_tag "Log a check-in", class: "btn btn-secondary" %>
    <details>
      <summary class="cursor-pointer hover:text-ink">Date or note</summary>
      <div class="mt-2 flex flex-wrap gap-2">
        <%= date_field_tag "check_in[on]", Date.current, max: Date.current, aria: { label: "Date of check-in" }, class: "field" %>
        <%= text_field_tag "check_in[note]", nil, maxlength: CheckIn::NOTE_LIMIT, placeholder: "Private note, Admins only", aria: { label: "Note" }, class: "field" %>
      </div>
    </details>
  <% end %>
</div>
