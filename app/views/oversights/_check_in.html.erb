<div class="text-meta text-ink-2">
  <% if last&.note.present? && Policy.can?(Current.person, :view_note, last) %>
    <p class="mb-3">Private note: <%= last.note %></p>
  <% end %>

  <%= form_with url: person_check_ins_path(person), class: "mt-3 grid gap-2" do %>
    <div class="flex flex-wrap gap-2">
      <%= date_field_tag "check_in[on]", Date.current, max: Date.current, aria: { label: "Date of check-in" }, class: "field" %>
      <%= text_field_tag "check_in[note]", nil, maxlength: CheckIn::NOTE_LIMIT, placeholder: "Private note, Admins only", aria: { label: "Note" }, class: "field min-w-0 flex-1" %>
    </div>
    <p>Logging this removes <%= person.name %> from this list for <%= CheckIn::RECENT_DAYS %> days.</p>
    <div><%= submit_tag "Log a Check-In", class: "btn btn-secondary" %></div>
  <% end %>
</div>
