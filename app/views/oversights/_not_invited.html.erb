<li class="flex items-center justify-between gap-4 py-3" data-never-asked-person="<%= person.name %>">
  <%= link_to edit_person_path(person), class: "flex min-w-0 items-center gap-2.5 font-semibold" do %><%= avatar(person) %><span class="min-w-0"><%= person.name %></span><% end %>
  <%= link_to "View person", edit_person_path(person), class: "btn btn-secondary shrink-0" %>
</li>
