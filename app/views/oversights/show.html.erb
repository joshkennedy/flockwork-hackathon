<% content_for :title, "Oversight" %>

<div class="w-full">
  <%= page_header "#{pluralize(@overextended_people.length, "Person", plural: "People")} may need a check-in", subtitle: "#{pluralize(@never_asked_people.length, "Person", plural: "People")} #{@never_asked_people.length == 1 ? "hasn’t" : "haven’t"} been asked yet." %>

  <div class="mt-7 grid gap-7 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <section aria-labelledby="overextended-heading">
      <h2 id="overextended-heading">May need a check-in</h2>
      <p class="mt-2 text-meta text-ink-2">Check-in threshold: <%= pluralize(Current.organization.overextended_limit, "Active Project") %>, with no recent check-in.</p>
      <% if @overextended_people.any? %>
        <ul class="mt-3 grid gap-2">
          <% @overextended_people.each do |person| %>
            <li class="rounded-tile border border-border bg-panel p-4" data-overextended-person="<%= person.name %>" data-serving-load="<%= person.serving_load %>">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <%= person_name_link(person, class: "flex min-w-0 items-center gap-2.5 font-semibold") %>
                  <p class="mt-2 text-meta leading-normal text-ink-2"><%= @summaries[person.id] %></p>
                </div>
                <% if Current.person.admin? %><%= link_to "View Person", person_path(person), class: "btn btn-secondary btn-sm shrink-0", aria: { label: "View Person for #{person.name}" } %><% end %>
              </div>
              <% if Policy.can?(Current.person, :log_check_in, person) %>
                <div class="mt-3 border-t border-hairline pt-3">
                  <%= render "check_in", person: person, last: @last_check_ins[person.id], summary: @summaries[person.id] %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-5 text-ink-2">Nobody is at the current limit.</p>
      <% end %>
    </section>

    <section aria-labelledby="never-asked-heading">
      <h2 id="never-asked-heading">Not yet asked</h2>
      <% if @never_asked_people.any? %>
        <ul class="mt-2 divide-y divide-hairline">
          <%= render partial: "not_invited", collection: @never_asked_people.first(3), as: :person %>
        </ul>
        <% if @never_asked_people.length > 3 %>
          <details class="mt-2">
            <%= disclosure_summary "Show #{@never_asked_people.length - 3} more", class: "text-label text-ink-2" %>
            <ul class="mt-2 divide-y divide-hairline">
              <%= render partial: "not_invited", collection: @never_asked_people.drop(3), as: :person %>
            </ul>
          </details>
        <% end %>
      <% else %>
        <p class="mt-5 text-ink-2">Everyone has been invited or joined a Team.</p>
      <% end %>
    </section>
  </div>

  <% if @away_ranges.any? %>
    <section class="mt-7" aria-labelledby="away-heading">
      <h2 id="away-heading">Away</h2>
      <p class="mt-2 text-meta text-ink-2">Dates only. A note the person wrote stays with them.</p>
      <ul class="mt-2 divide-y divide-hairline">
        <% @away_ranges.each do |away| %>
          <li class="flex items-center justify-between gap-4 py-3" data-away-person="<%= away.person.name %>">
            <%= person_name_link(away.person, class: "flex min-w-0 items-center gap-2.5 font-semibold") %>
            <span class="shrink-0 text-meta text-ink-2"><%= away.away_label %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% highlight = @involvement&.max_by { |entry| entry[:slots] } %>
  <% if highlight && highlight[:slots].positive? %>
    <div class="tile-raised mt-7 flex items-start gap-3 px-6 py-5">
      <%= icon(:kept, class: "mt-0.5 text-sunlit") %>
      <div>
        <h2 data-thank-you>Thank you, <%= highlight[:person].name.split.first %>: <%= pluralize(highlight[:slots], "Slot") %> this year.</h2>
        <p class="mt-2 text-meta text-ink-2"><%= @involvement_year %>: <%= pluralize(highlight[:projects], "Project") %> joined · <%= pluralize(highlight[:tasks], "Task") %> completed</p>
      </div>
    </div>
  <% end %>

  <% if Current.person.admin? %>
    <p class="mt-7 border-t border-hairline pt-5 text-meta text-ink-2">
      Check-in threshold: <%= pluralize(Current.organization.overextended_limit, "Project") %>.
      <%= link_to "Change in Settings", settings_path(anchor: "settings-church"), class: "link" %>
    </p>
  <% end %>

  <% if @involvement %>
  <section class="mt-7" aria-labelledby="involvement-heading">
    <h2 id="involvement-heading" class="text-ink">Involvement in <%= @involvement_year %></h2>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-meta border-collapse text-left">
        <thead>
          <tr class="border-b border-hairline text-meta text-ink-2">
            <th scope="col" class="py-3 pr-4 font-semibold">Person</th>
            <th scope="col" class="px-2 py-3 text-right font-semibold">Projects</th>
            <th scope="col" class="px-2 py-3 text-right font-semibold">Tasks</th>
            <th scope="col" class="py-3 pl-4 text-right font-semibold">Slots</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <% @involvement.each do |entry| %>
            <tr data-involvement-person="<%= entry[:person].name %>"
                data-projects="<%= entry[:projects] %>"
                data-tasks="<%= entry[:tasks] %>"
                data-slots="<%= entry[:slots] %>">
              <th scope="row" class="py-4 pr-4 font-semibold text-ink">
                <%= link_to entry[:person].name, person_path(entry[:person]), class: "hover:text-ink" %>
              </th>
              <td class="px-2 py-4 text-right text-ink-2"><%= entry[:projects] %></td>
              <td class="px-2 py-4 text-right text-ink-2"><%= entry[:tasks] %></td>
              <td class="py-4 pl-4 text-right text-ink-2"><%= entry[:slots] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  <% end %>
</div>
