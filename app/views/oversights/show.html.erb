<% content_for :title, "Oversight" %>

<div class="mx-auto w-full max-w-4xl">
  <%= link_to "← #{Current.workspace.name}", workspace_path(Current.workspace), class: "text-sm font-medium text-stone-600 hover:text-stone-950" %>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-stone-950">Oversight</h1>

  <section class="mt-12" aria-labelledby="overextended-heading">
    <div class="flex flex-col gap-6 border-b border-stone-300 pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="overextended-heading" class="text-2xl font-bold text-stone-950">Overextended</h2>
        <p class="mt-2 max-w-2xl leading-7 text-stone-700">People serving on <%= Current.workspace.overextended_limit %> or more Active Projects.</p>
      </div>

      <%= form_with model: Current.workspace, url: oversight_path, method: :patch, class: "flex items-end gap-3" do |form| %>
        <div>
          <%= form.label :overextended_limit, "Serving load limit", class: "block text-sm font-semibold text-stone-700" %>
          <%= form.number_field :overextended_limit, min: 1, required: true, class: "mt-1 w-24 border border-stone-400 bg-white px-3 py-2 text-stone-950" %>
          <% if Current.workspace.errors[:overextended_limit].any? %>
            <p class="mt-1 text-sm font-medium text-red-800" role="alert"><%= Current.workspace.errors.full_messages_for(:overextended_limit).to_sentence %></p>
          <% end %>
        </div>
        <%= form.submit "Save", class: "cursor-pointer bg-[#1f291f] px-4 py-2 font-bold text-white hover:bg-[#354235]" %>
      <% end %>
    </div>

    <% if @overextended_people.any? %>
      <ul class="divide-y divide-stone-300">
        <% @overextended_people.each do |person| %>
          <li class="flex items-center justify-between gap-6 py-4" data-overextended-person="<%= person.name %>" data-serving-load="<%= person.serving_load %>">
            <%= link_to person.name, edit_person_path(Current.workspace, person), class: "font-semibold text-stone-950 hover:text-[#52634d]" %>
            <span class="text-sm text-stone-700"><%= pluralize(person.serving_load, "Active Project") %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="py-6 text-stone-600">Nobody is at the current limit.</p>
    <% end %>
  </section>

  <section class="mt-16" aria-labelledby="never-asked-heading">
    <h2 id="never-asked-heading" class="text-2xl font-bold text-stone-950">Never asked</h2>
    <p class="mt-2 max-w-2xl leading-7 text-stone-700">People with no Invitation or Team history.</p>

    <% if @never_asked_people.any? %>
      <ul class="mt-6 divide-y divide-stone-300 border-y border-stone-300">
        <% @never_asked_people.each do |person| %>
          <li class="py-4" data-never-asked-person="<%= person.name %>">
            <%= link_to person.name, edit_person_path(Current.workspace, person), class: "font-semibold text-stone-950 hover:text-[#52634d]" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-6 text-stone-600">Everyone has been invited or joined a Team.</p>
    <% end %>
  </section>

  <section class="mt-16" aria-labelledby="involvement-heading">
    <h2 id="involvement-heading" class="text-2xl font-bold text-stone-950">Involvement in <%= @involvement_year %></h2>
    <p class="mt-2 max-w-2xl leading-7 text-stone-700">Projects joined, Tasks completed, and Slots claimed this year.</p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[36rem] border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-stone-800 text-sm text-stone-700">
            <th scope="col" class="py-3 pr-4 font-semibold">Person</th>
            <th scope="col" class="px-4 py-3 text-right font-semibold">Projects</th>
            <th scope="col" class="px-4 py-3 text-right font-semibold">Tasks</th>
            <th scope="col" class="py-3 pl-4 text-right font-semibold">Slots</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-300">
          <% @involvement.each do |entry| %>
            <tr data-involvement-person="<%= entry[:person].name %>"
                data-projects="<%= entry[:projects] %>"
                data-tasks="<%= entry[:tasks] %>"
                data-slots="<%= entry[:slots] %>">
              <th scope="row" class="py-4 pr-4 font-semibold text-stone-950">
                <%= link_to entry[:person].name, edit_person_path(Current.workspace, entry[:person]), class: "hover:text-[#52634d]" %>
              </th>
              <td class="px-4 py-4 text-right text-stone-700"><%= entry[:projects] %></td>
              <td class="px-4 py-4 text-right text-stone-700"><%= entry[:tasks] %></td>
              <td class="py-4 pl-4 text-right text-stone-700"><%= entry[:slots] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
