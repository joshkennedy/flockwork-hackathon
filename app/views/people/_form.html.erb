<%= form_with model: person, url: person.persisted? ? person_path(person) : people_path, class: "mt-7 space-y-4" do |form| %>
  <% if person.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-meta text-danger">
      <%= person.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-label font-medium text-ink-2" %>
    <%= form.text_field :name, required: true, class: "mt-1 block w-full field" %>
  </div>

  <div>
    <%= form.label :email, class: "block text-label font-medium text-ink-2" %>
    <%= form.email_field :email, class: "mt-1 block w-full field" %>
    <p class="mt-1 text-label text-ink-2">Optional. Leave blank if this person should not sign in.</p>
  </div>

  <div>
    <%= form.label :phone, class: "block text-label font-medium text-ink-2" %>
    <%= form.telephone_field :phone, class: "mt-1 block w-full field" %>
  </div>

  <% if person.persisted? %>
    <div>
      <div class="flex items-center gap-2">
        <%= form.check_box :admin, class: "rounded border-hairline" %>
        <%= form.label :admin, "Admin", class: "text-label font-medium text-ink-2" %>
      </div>
      <p class="mt-1 text-label text-ink-2">Admins can manage People and Settings.</p>
    </div>
  <% end %>

  <%= form.submit submit_label, class: "btn btn-primary" %>
<% end %>
