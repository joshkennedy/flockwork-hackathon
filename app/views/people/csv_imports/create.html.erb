<% content_for :title, "Import results · #{Current.workspace.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "← People", people_path, class: "text-meta text-ink-2 hover:text-ink-2" %>
  <span aria-hidden="true" class="text-ink-3">/</span>
  <span class="truncate text-ink"><%= content_for(:title) %></span>
<% end %>

<div class="w-full max-w-2xl">
  <h1 class="mt-1 text-ink">Import results</h1>

  <p class="mt-4 text-ink">
    <%= @result.created_count %> created,
    <%= @result.updated_count %> updated,
    <%= @result.rejected_rows.size %> rejected
  </p>

  <% if @result.rejected_rows.any? %>
    <table class="mt-6 w-full text-left text-meta border-b border-hairline overflow-hidden">
      <thead class="bg-frame text-ink-2">
        <tr>
          <th class="px-4 py-2 font-medium">Line</th>
          <th class="px-4 py-2 font-medium">Reason</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline">
        <% @result.rejected_rows.each do |line_number, reason| %>
          <tr>
            <td class="px-4 py-2 text-ink"><%= line_number %></td>
            <td class="px-4 py-2 text-ink-2"><%= reason %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
