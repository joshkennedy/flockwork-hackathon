<% content_for :title, "Import CSV — #{Current.workspace.name}" %>

<div class="w-full max-w-lg mx-auto">
  <%= link_to "← People", people_path(Current.workspace), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="mt-1 text-3xl font-bold text-gray-900">Import CSV</h1>
  <p class="mt-2 text-sm text-gray-600">Upload a CSV with name, email, and phone columns. Existing People are matched by email.</p>

  <% if (alert = flash[:alert] || flash.now[:alert]).present? %>
    <p class="mt-4 text-sm text-red-800"><%= alert %></p>
  <% end %>

  <%= form_with url: people_csv_import_path(Current.workspace), method: :post, multipart: true, class: "mt-6 space-y-4" do |form| %>
    <%= form.file_field :csv_file, accept: ".csv,text/csv", required: true, class: "block w-full text-sm text-gray-700" %>
    <%= form.submit "Import", class: "rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
  <% end %>
</div>
