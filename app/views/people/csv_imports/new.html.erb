<% content_for :title, "Import CSV · #{Current.organization.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "People", people_path, class: "shrink-0 whitespace-nowrap hover:text-ink" %>
  <span aria-hidden="true" class="shrink-0 text-ink-3">/</span>
  <span class="min-w-0 truncate text-ink" aria-current="page"><%= breadcrumb_label %></span>
<% end %>

<div class="w-full max-w-2xl">
  <%= page_header "Import CSV", subtitle: "Upload a CSV with name, email, and phone columns. An optional skills column accepts comma-separated skills. Existing People are matched by email." %>

  <% alert = flash[:alert] %>
  <% flash.delete(:alert) %>
  <% if alert.present? %>
    <span hidden data-toast-entry data-toast-kind="alert"><%= alert %></span>
  <% end %>

  <%= form_with url: people_csv_import_path, method: :post, multipart: true, class: "mt-6 space-y-4",
        data: { controller: "upload", upload_key_value: "people-csv", action: "turbo:submit-start->upload#start turbo:submit-end->upload#finish direct-upload:start->upload#start direct-upload:progress->upload#progress direct-upload:error->upload#directError" } do |form| %>
    <div>
      <%= form.label :csv_file, "CSV file", class: "block text-label font-medium text-ink-2" %>
      <%= form.file_field :csv_file, accept: ".csv,text/csv", required: true, class: "mt-1 block w-full text-meta text-ink-2", data: { upload_target: "input" } %>
    </div>
    <%= form.submit "Import", class: "btn btn-primary" %>
  <% end %>
</div>
