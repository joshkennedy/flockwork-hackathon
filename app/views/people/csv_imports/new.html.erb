<% content_for :title, "Import CSV · #{Current.workspace.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "← People", people_path(Current.workspace), class: "text-meta text-ink-2 hover:text-ink-2" %>
  <span aria-hidden="true" class="text-ink-3">/</span>
  <span class="truncate text-ink"><%= content_for(:title) %></span>
<% end %>

<div class="w-full max-w-lg">
  <h1 class="mt-1 text-ink">Import CSV</h1>
  <p class="mt-2 text-meta text-ink-2">Upload a CSV with name, email, and phone columns. Existing People are matched by email.</p>

  <% if (alert = flash[:alert] || flash.now[:alert]).present? %>
    <p role="alert" class="mt-4 text-meta text-danger"><%= alert %></p>
  <% end %>

  <%= form_with url: people_csv_import_path(Current.workspace), method: :post, multipart: true, class: "mt-6 space-y-4" do |form| %>
    <%= form.file_field :csv_file, accept: ".csv,text/csv", required: true, class: "block w-full text-meta text-ink-2" %>
    <%= form.submit "Import", class: "btn btn-primary" %>
  <% end %>
</div>
