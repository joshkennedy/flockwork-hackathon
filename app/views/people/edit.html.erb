<% content_for :title, "Edit #{@person.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "People", people_path, class: "shrink-0 whitespace-nowrap hover:text-ink" %>
  <span aria-hidden="true" class="shrink-0 text-ink-3">/</span>
  <%= link_to @person.name, person_path(@person), class: "min-w-0 truncate hover:text-ink" %>
  <span aria-hidden="true" class="shrink-0 text-ink-3">/</span>
  <span class="min-w-0 truncate text-ink" aria-current="page">Edit details</span>
<% end %>

<div class="w-full max-w-2xl">
  <div class="flex items-center gap-4">
    <%= avatar(@person, size: :lg) %>
    <div class="min-w-0 flex-1"><%= page_header @person.name, subtitle: "Edit details" %></div>
  </div>

  <%= render "form", person: @person, submit_label: "Save changes" %>
</div>
