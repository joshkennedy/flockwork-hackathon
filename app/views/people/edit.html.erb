<% content_for :title, "Edit #{@person.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "← People", people_path, class: "text-meta text-ink-2 hover:text-ink-2" %>
  <span aria-hidden="true" class="text-ink-3">/</span>
  <span class="truncate text-ink"><%= content_for(:title) %></span>
<% end %>

<div class="w-full max-w-lg">
  <h1 class="mt-1 text-ink">Edit <%= @person.name %></h1>

  <%= render "form", person: @person, submit_label: "Save changes" %>

  <%= render "shared/involvement_timeline", involvement: @involvement, title: "Involvement" %>

  <section class="tool-section mt-7" aria-labelledby="person-notes-heading">
    <h2 id="person-notes-heading" class="text-ink">Notes</h2>
    <%= render "notes/list", notes: @person_notes %>
    <%= render "notes/form",
      notable: @person,
      visibilities: @note_visibilities,
      form_url: person_notes_path(@person) %>
  </section>
</div>
