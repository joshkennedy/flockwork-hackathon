<% content_for :title, "Edit #{@person.name}" %>

<div class="w-full max-w-lg mx-auto">
  <%= link_to "← People", people_path(Current.workspace), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <h1 class="mt-1 text-3xl font-bold text-gray-900">Edit <%= @person.name %></h1>

  <%= render "form", person: @person, submit_label: "Save changes" %>

  <%= render "shared/involvement_timeline", involvement: @involvement, title: "Involvement" %>

  <section class="mt-12 bg-[#e7ede3] p-6" aria-labelledby="person-notes-heading">
    <h2 id="person-notes-heading" class="text-xl font-bold text-stone-950">Notes</h2>
    <%= render "notes/list", notes: @person_notes %>
    <%= render "notes/form",
      notable: @person,
      visibilities: @note_visibilities,
      form_url: person_notes_path(Current.workspace, @person) %>
  </section>
</div>
