<% content_for :title, "People · #{Current.organization.name}" %>

<div class="w-full max-w-5xl">
  <%= page_header "People" do %>
    <%= link_to "Planning Center", planning_center_directory_path, class: "btn btn-secondary" %>
    <%= link_to "Import CSV", new_people_csv_import_path, class: "btn btn-secondary" %>
    <%= link_to "Add person", new_person_path, class: "btn btn-primary" %>
  <% end %>

  <ul class="mt-7 divide-y divide-hairline border-b border-hairline">
    <% @people.each do |person| %>
      <li class="flex items-center justify-between gap-4 py-3">
        <div class="flex min-w-0 items-center gap-3">
          <%= avatar(person) %>
          <div class="min-w-0">
          <p class="font-medium text-ink">
            <%= person.name %>
            <% if person.admin? %>
              <span class="ml-2 text-label font-normal text-ink-2">Admin</span>
            <% end %>
          </p>
          <p class="text-meta text-ink-2">
            <% if person.email.present? %>
              <%= person.email %>
            <% else %>
              Can't sign in (no email)
            <% end %>
            <% if person.phone.present? %>
              · <%= person.phone %>
            <% end %>
          </p>
          </div>
        </div>

        <%= link_to "Edit", edit_person_path(person), class: "text-meta font-medium text-ink-2 hover:text-ink" %>
      </li>
    <% end %>
  </ul>
</div>
