<% content_for :title, "People — #{Current.workspace.name}" %>

<div class="w-full max-w-2xl mx-auto">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to "← #{Current.workspace.name}", workspace_path(Current.workspace), class: "text-sm text-gray-500 hover:text-gray-700" %>
      <h1 class="mt-1 text-3xl font-bold text-gray-900">People</h1>
    </div>

    <div class="flex shrink-0 gap-2">
      <%= link_to "Import CSV", new_people_csv_import_path(Current.workspace), class: "rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-50" %>
      <%= link_to "Add person", new_person_path(Current.workspace), class: "rounded-md bg-gray-900 px-3 py-2 text-sm font-medium text-white hover:bg-gray-800" %>
    </div>
  </div>

  <ul class="mt-8 divide-y divide-gray-200 border border-gray-200 rounded-lg">
    <% @people.each do |person| %>
      <li class="flex items-center justify-between gap-4 px-4 py-3">
        <div>
          <p class="font-medium text-gray-900">
            <%= person.name %>
            <% if person.admin? %>
              <span class="ml-2 text-xs font-normal text-gray-500">Admin</span>
            <% end %>
          </p>
          <p class="text-sm text-gray-600">
            <% if person.email.present? %>
              <%= person.email %>
            <% else %>
              Can't sign in (no email)
            <% end %>
            <% if person.phone.present? %>
              · <%= person.phone %>
            <% end %>
          </p>
        </div>

        <%= link_to "Edit", edit_person_path(Current.workspace, person), class: "text-sm font-medium text-gray-700 hover:text-gray-900" %>
      </li>
    <% end %>
  </ul>
</div>
