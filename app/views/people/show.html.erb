<% content_for :title, @person.name %>

<div class="mx-auto w-full max-w-3xl">
  <header class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-start gap-4">
      <%= avatar(@person, size: :lg) %>
      <div class="min-w-0">
        <h1 class="text-ink"><%= @person.name %></h1>
        <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-body text-ink-2">
          <% if @person.email.present? %>
            <%= link_to @person.email, "mailto:#{@person.email}", class: "link break-all" %>
          <% end %>
          <% if @person.phone.present? %>
            <%= link_to @person.phone, "tel:#{@person.phone.gsub(/[^\d+]/, "")}", class: "link whitespace-nowrap" %>
          <% end %>
        </p>
        <% if @person.pending_email.present? %>
          <p class="mt-2 text-meta text-ink-2">Pending: <span class="break-all text-ink"><%= @person.pending_email %></span>, waiting for confirmation</p>
        <% end %>
        <div class="mt-3">
          <%= person_chips(@person, leader: @leads_active_project, away_until: @away_until, never_asked: @never_asked) %>
        </div>
        <% if @person.skills.any? %>
          <p class="mt-3 text-meta text-ink-2">Skills · <span class="text-ink"><%= skill_list(@person.skills) %></span></p>
        <% end %>
      </div>
    </div>
    <div data-controller="slideout" class="flex shrink-0 items-center gap-2 self-start sm:self-auto">
      <%= link_to "Edit Details", edit_person_path(@person), class: "btn btn-secondary", data: { action: "slideout#open" } %>
      <% unless @person == Current.person || Current.organization.demo? %>
        <%= actions_menu("Person actions") do %>
          <%= button_to "Remove Person", person_path(@person), method: :delete, class: "menu-danger",
                form: { data: { turbo_confirm: "Remove “#{@person.name}”? Their Team memberships and sign-ups will be removed. Assigned tasks will become unassigned." } } %>
        <% end %>
      <% end %>
      <dialog class="slideout" aria-labelledby="edit-person-heading" data-slideout-target="dialog" data-action="click->slideout#backdrop">
        <div class="slideout-panel">
          <div class="flex items-center justify-between gap-4">
            <h2 id="edit-person-heading" class="text-ink">Edit details</h2>
            <button type="button" class="btn btn-icon" aria-label="Close dialog" data-action="slideout#close"><%= icon(:close) %></button>
          </div>
          <%= turbo_frame_tag "edit-person", src: edit_person_path(@person), loading: :lazy do %>
            <p class="mt-6 text-meta text-ink-2">Loading…</p>
          <% end %>
        </div>
      </dialog>
    </div>
  </header>

  <section class="tool-section mt-7" aria-labelledby="serving-heading">
    <h2 id="serving-heading" class="text-ink">Serving now</h2>
    <% if @serving_memberships.any? %>
      <ul class="mt-3 divide-y divide-hairline">
        <% @serving_memberships.each do |membership| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <%= link_to membership.project.name, project_path(membership.project), class: "font-semibold text-ink" %>
            <span class="shrink-0 text-meta text-ink-2"><%= membership.role.humanize %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-ink-2">Not serving on an Active Project right now.</p>
    <% end %>
  </section>

  <%= render "shared/involvement_timeline", involvement: @involvement, title: "History", section_class: "tool-section mt-7" %>

  <% if @past_memberships.any? %>
    <section class="mt-7" aria-labelledby="past-projects-heading">
      <h3 id="past-projects-heading" class="text-ink">Past Projects</h3>
      <ul class="mt-3 divide-y divide-hairline">
        <% @past_memberships.each do |membership| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <%= link_to membership.project.name, project_path(membership.project), class: "font-semibold text-ink" %>
            <span class="shrink-0 text-meta text-ink-2"><%= membership.role.humanize %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="tool-section mt-7" aria-labelledby="check-ins-heading">
    <h2 id="check-ins-heading" class="text-ink">Check-ins</h2>
    <% if @last_check_in %>
      <p class="mt-3 text-ink-2">Checked in <%= short_date(@last_check_in.on) %> by <%= person_pill(@last_check_in.checked_in_by, fallback: "a former Leader") %></p>
      <% if @last_check_in.note.present? && Policy.can?(Current.person, :view_note, @last_check_in) %>
        <p class="mt-2 text-meta text-ink-2">Admin note: <%= @last_check_in.note %></p>
      <% end %>
    <% else %>
      <p class="mt-3 text-ink-2">No check-in logged yet.</p>
    <% end %>

    <% if Policy.can?(Current.person, :log_check_in, @person) %>
      <%= form_with url: person_check_ins_path(@person), class: "mt-4 grid gap-3" do %>
        <%= hidden_field_tag :return_to, "person", id: nil %>
        <div class="flex flex-wrap gap-2">
          <%= date_field_tag "check_in[on]", Date.current, max: Date.current, aria: { label: "Date of check-in" }, class: "field" %>
          <% if Policy.can?(Current.person, :view_note, CheckIn.new(organization: Current.organization, person: @person)) %>
            <%= text_field_tag "check_in[note]", nil, maxlength: CheckIn::NOTE_LIMIT, placeholder: "Private note, Admins only", aria: { label: "Note" }, class: "field min-w-0 flex-1" %>
          <% end %>
        </div>
        <p class="text-meta text-ink-2">Logging this removes <%= @person.name %> from May need a check-in for <%= CheckIn::RECENT_DAYS %> days.</p>
        <div><%= submit_tag "Log a Check-In", class: "btn btn-secondary" %></div>
      <% end %>
    <% end %>
  </section>

  <section class="tool-section mt-7" aria-labelledby="away-heading">
    <h2 id="away-heading" class="text-ink">Away dates</h2>
    <p class="mt-2 text-meta text-ink-2">Dates only. A note the person wrote stays with them.</p>
    <% if @away_dates.any? %>
      <ul class="mt-3 divide-y divide-hairline">
        <% @away_dates.each do |away| %>
          <li class="py-3 text-ink" data-away-range><%= away.away_label %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-ink-2">No away dates coming up.</p>
    <% end %>
  </section>

  <section class="tool-section mt-7" aria-labelledby="person-notes-heading" data-controller="slideout">
    <h2 id="person-notes-heading" class="text-ink">Notes</h2>
    <%= render "notes/list", notes: @person_notes, person: @person %>
    <%= render "notes/form",
      notable: @person,
      visibilities: @note_visibilities,
      form_url: person_notes_path(@person) %>
    <dialog class="slideout" aria-labelledby="edit-note-heading" data-slideout-target="dialog" data-action="click->slideout#backdrop">
      <div class="slideout-panel">
        <div class="flex items-center justify-between gap-4">
          <h2 id="edit-note-heading" class="text-ink">Edit note</h2>
          <button type="button" class="btn btn-icon" aria-label="Close dialog" data-action="slideout#close"><%= icon(:close) %></button>
        </div>
        <%= turbo_frame_tag "note-form", data: { slideout_target: "frame", action: "turbo:submit-end->slideout#submitted" } do %>
          <p class="mt-6 text-meta text-ink-2">Loading…</p>
        <% end %>
      </div>
    </dialog>
  </section>
</div>
