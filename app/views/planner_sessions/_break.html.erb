<div role="alert" class="rounded-control bg-sunlit-soft px-4 py-3">
  <p class="font-semibold text-ink"><%= PlannerSession::ERROR_MESSAGE %></p>
  <p class="mt-1 text-meta text-ink-2">Your answers and anything already in the preview are kept.</p>
  <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3">
    <%= button_to "Retry", retry_generation_project_planner_session_path(project, planner_session), params: { expected_revision: planner_session.generation_revision }, class: "btn btn-secondary" %>
    <%= button_to "Keep going by hand", save_and_leave_project_planner_session_path(project, planner_session), class: "btn btn-text", form: { data: { turbo_frame: "_top" } } %>
  </div>
</div>
