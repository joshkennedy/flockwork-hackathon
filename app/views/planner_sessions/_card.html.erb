<%= turbo_frame_tag dom_id(planner_session, :card) do %>
  <section
    class="min-w-0"
    aria-labelledby="planner-question"
    data-voice-planner-target="cardState"
    data-voice-state="<%= planner_session.status %>"
    data-voice-card="<%= planner_session.current_card&.fetch("question", nil) %>">
    <% if planner_session.last_error.present? %>
      <p role="alert" class="mb-7 rounded-control bg-danger-soft px-4 py-3 text-danger"><%= PlannerSession::ERROR_MESSAGE %></p>
    <% end %>

    <% if planner_session.current_card.present? %>
      <h1 id="planner-question" class="max-w-3xl text-ink"><%= planner_session.current_card.fetch("question") %></h1>

      <div class="mt-7 grid gap-2" data-controller="planner-answers" data-action="keydown@window->planner-answers#choose">
        <% planner_session.current_card.fetch("options").each_with_index do |option, index| %>
          <%= button_to answer_project_planner_session_path(project, planner_session), params: { answer: option }, class: "answer-tile", aria: { label: option }, data: { turbo_submits_with: "Thinking…", planner_answers_target: "answer" } do %>
            <span class="min-w-0 flex-1"><%= option %></span>
            <span aria-hidden="true" class="text-label text-ink-3"><%= index + 1 %></span>
          <% end %>
        <% end %>
      </div>

      <%= form_with url: answer_project_planner_session_path(project, planner_session), class: "mt-7" do |form| %>
        <%= form.label :answer, "Or answer in your own words", class: "block text-label font-medium text-ink" %>
        <div class="mt-2 flex min-w-0 flex-col gap-3 sm:flex-row">
          <%= render layout: "shared/dictation_button", locals: { wrapper_class: "flex min-w-0 flex-1 items-center gap-2" } do %>
            <%= form.text_field :answer, required: true, data: { dictation_target: "field" }, class: "block min-w-0 flex-1 field" %>
          <% end %>
          <%= form.submit "Answer", class: "btn btn-primary", data: { turbo_submits_with: "Thinking…" } %>
        </div>
      <% end %>

      <div hidden data-voice-planner-target="launcher" class="mt-5">
        <p class="text-meta text-ink-2">Your audio is sent to xAI. Describe the work without names or private care details.</p>
        <button type="button" class="mt-2 btn btn-secondary" data-action="voice-planner#start" data-voice-planner-target="startButton">
          <%= icon(:mic) %>
          <span>Talk It Through</span>
        </button>
      </div>
    <% elsif planner_session.reviewing? %>
      <h1 id="planner-question" class="text-ink">Your plan is ready to review</h1>
      <p class="mt-4 text-ink-2">Check every Suggestion before anything is added to the Project.</p>
      <%= link_to "Review Suggestions", review_project_planner_session_path(project, planner_session), data: { turbo_frame: "_top" }, class: "mt-7 btn btn-primary" %>
    <% elsif planner_session.last_error.present? %>
      <h1 id="planner-question" class="text-ink">The Planner is paused</h1>
      <p class="mt-4 text-ink-2">Review the Suggestions already created, or return to the Project and keep building by hand.</p>
    <% else %>
      <h1 id="planner-question" class="text-ink">Thinking…</h1>
      <p class="mt-4 text-ink-2">The Planner is shaping the next question and updating your Suggestions.</p>
    <% end %>

    <% if planner_session.asking? %>
      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 text-meta font-semibold">
        <%= link_to "Skip to Review", skip_to_review_project_planner_session_path(project, planner_session), data: { turbo_method: :post, turbo_frame: "_top" }, class: "btn btn-secondary" %>
        <%= link_to "Leave Planner", abandon_project_planner_session_path(project, planner_session), data: { turbo_method: :post, turbo_frame: "_top" }, class: "text-ink-2 hover:text-ink" %>
      </div>
    <% end %>
  </section>
<% end %>
