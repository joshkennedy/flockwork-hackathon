<%= turbo_frame_tag dom_id(planner_session, :meal_builder), data: {
  controller: "meal-planner",
  meal_planner_busy_value: planner_session.generation_busy?,
  meal_planner_url_value: project_planner_session_path(project, planner_session)
} do %>
  <% pending_answer = planner_session.pending_answer&.fetch("text", nil) %>
  <% removed_item = planner_session.pending_items.select { |item| item["removed"] }.max_by { |item| item["removed_revision"].to_i } %>
  <% visible_items = planner_session.visible_pending_items %>
  <% recently_added_items = planner_session.recently_added_items %>
  <% general_planner = !planner_session.meal_planner? %>
  <% pending_errors = general_planner ? planner_session.pending_item_errors : {} %>
  <% visible_pending_errors = planner_session.reviewing? ? pending_errors : {} %>
  <% needs_start_date = planner_session.reviewing? && project.starts_on.blank? &&
    visible_items.any? { |item| item.key?("day_offset") && item.dig("fields", item["kind"] == "task" ? "due_on" : "date").blank? && !item.fetch("user_edits", {}).key?(item["kind"] == "task" ? "due_on" : "date") } %>
  <% addable = if general_planner
    visible_items.any? && pending_errors.blank? && visible_items.none? { |item| item["conflict"].present? }
  else
    visible_items.any? && visible_items.all? { |item| item.dig("fields", "date").present? && item["conflict"].blank? }
  end %>
  <% current_step = if planner_session.pending_answer.present?
    planner_session.pending_answer.fetch("step_index") + 1
  else
    [ planner_session.steps.length + 1, PlannerSession::MAX_GENERATED_QUESTIONS ].min
  end %>
  <% voice_phase = if planner_session.reviewing?
    "reviewing"
  elsif planner_session.last_error.present?
    "error"
  elsif planner_session.current_card.blank?
    "waiting"
  elsif planner_session.generation_busy?
    "busy"
  elsif planner_session.ready_to_continue?
    "ready"
  else
    "choose"
  end %>

  <%# This frame swaps without the layout, so the alert shows here; delete keeps the layout toast from repeating it. %>
  <% alert = flash[:alert] %>
  <% flash.delete(:alert) %>
  <% if alert.present? %>
    <p role="alert" class="mb-5 rounded-control bg-danger-soft px-4 py-3 text-danger"><%= alert %></p>
  <% end %>

  <% content_for :wash, "wash-none" %>
  <section class="meal-builder" aria-labelledby="meal-project-heading">
    <% if planner_session.generation_busy? %>
      <span data-meal-planner-target="busy" hidden></span>
    <% end %>
    <header class="meal-builder-header">
      <div class="min-w-0">
        <h1 id="meal-project-heading" class="text-ink"><%= project.name %></h1>
      </div>

      <details class="meal-builder-rename <%= "invisible" if planner_session.generation_busy? %>">
        <%= disclosure_summary "Project Details", class: "btn btn-text" %>
        <%= form_with url: planning_details_project_planner_session_path(project, planner_session), method: :patch, class: "meal-builder-popover popover-in" do |form| %>
          <%= form.hidden_field :expected_revision, value: planner_session.generation_revision %>
          <%= form.label :name, "Project name", class: "block text-label font-medium text-ink" %>
          <%= form.text_field :name, name: "project[name]", value: project.name, required: true, class: "mt-2 block w-full field" %>
          <%= form.label :starts_on, general_planner ? "Start date" : "First meal date", class: "mt-4 block text-label font-medium text-ink" %>
          <%= form.date_field :starts_on, name: "project[starts_on]", value: project.starts_on, class: "mt-2 block w-full field" %>
          <%= form.submit "Save Details", class: "mt-3 btn btn-secondary", data: { turbo_submits_with: "Saving…" } %>
        <% end %>
      </details>
    </header>

    <div class="meal-builder-organization">
      <section class="meal-builder-guide" aria-labelledby="meal-guide-heading"
        data-voice-planner-target="cardState"
        data-voice-state="<%= planner_session.status %>"
        data-voice-card="<%= planner_session.current_card&.fetch("question", nil) %>"
        data-voice-revision="<%= planner_session.generation_revision %>"
        data-voice-phase="<%= voice_phase %>">
        <% if planner_session.generation_stalled? %>
          <p role="status" class="mb-3 text-ink-2">Planning is taking longer than usual. Your existing preview is saved.</p>
          <%= button_to "Retry Planning", retry_generation_project_planner_session_path(project, planner_session), params: { expected_revision: planner_session.generation_revision }, class: "mb-4 btn btn-secondary" %>
        <% end %>
        <% if planner_session.reviewing? %>
          <p class="text-meta text-ink-2">Ready to finish</p>
          <h2 id="meal-guide-heading" class="mt-2 text-lg font-semibold text-ink"><%= general_planner ? "Here’s what will be added" : "Here’s your meal train" %></h2>
          <p class="mt-3 text-ink-2"><%=
            general_planner ? pluralize(planner_session.pending_item_count, "item") + " will be added to the Project." : pluralize(planner_session.pending_item_count, "meal slot") + " will be added to the Sign-up sheet."
          %></p>
          <%= render "planner_sessions/meal_answers", project:, planner_session: %>

          <% if needs_start_date %>
            <%= form_with url: planning_details_project_planner_session_path(project, planner_session), method: :patch, namespace: "review_date", class: "mt-5" do |form| %>
              <%= form.hidden_field :expected_revision, value: planner_session.generation_revision %>
              <%= form.label :starts_on, general_planner ? "Project start date" : "First meal date", class: "block text-label font-medium text-ink" %>
              <div class="mt-2 flex flex-col gap-3 sm:flex-row">
                <%= form.date_field :starts_on, id: "starts_on", name: "project[starts_on]", required: true,
                  class: "block min-w-0 flex-1 field", aria: { describedby: dom_id(planner_session, :start_date_hint) } %>
                <%= form.submit "Set Date", class: "btn btn-secondary", data: { turbo_submits_with: "Setting Date…" } %>
              </div>
              <p id="<%= dom_id(planner_session, :start_date_hint) %>" class="mt-2 text-meta text-ink-2"><%= general_planner ? "Items are dated from this day." : "Every meal slot is dated from this day." %></p>
            <% end %>
          <% end %>

          <%= form_with url: accept_project_planner_session_path(project, planner_session), method: :post,
            class: "mt-5", data: { turbo_frame: "_top" } do |form| %>
            <%= form.hidden_field :expected_revision, value: planner_session.generation_revision %>
            <%= form.label :name, "Project name", class: "block text-label font-medium text-ink" %>
            <%= form.text_field :name, name: "project[name]", value: project.name, required: true, class: "mt-2 block w-full field" %>
            <%= form.button "Add to Project", class: "mt-4 btn btn-primary", disabled: !addable,
              aria: ({ describedby: dom_id(planner_session, :add_note) } unless addable),
              data: { turbo_submits_with: "Adding #{pluralize(planner_session.pending_item_count, "Item")}…" } %>
          <% end %>

          <% unless addable %>
            <% add_note_id = dom_id(planner_session, :add_note) %>
            <p id="<%= add_note_id %>" class="mt-3 text-meta text-ink-2"><%=
              if visible_items.empty?
                general_planner ? "Restore a removed item before adding." : "Restore a removed meal before adding."
              elsif visible_items.any? { |item| item["conflict"].present? }
                "Resolve the highlighted change before adding."
              elsif needs_start_date
                general_planner ? "Set the start date above to add these items." : "Set the first meal date above to add these slots."
              elsif general_planner
                safe_join(planner_acceptance_blockers(visible_items, pending_errors).map { |blocker|
                  link_to(blocker.fetch(:text), "##{blocker.fetch(:id)}", class: "link", data: { turbo: false })
                }, "; ")
              else
                "Fix the highlighted meals before adding."
              end
            %></p>
          <% end %>
        <% else %>
          <div data-voice-planner-target="questionnaire">
          <% if planner_session.current_card.present? %>
          <%# The tile below is the catch-all, so a model-written "Something else" or "Other" option would duplicate it. %>
          <% options = planner_session.current_card.fetch("options", []).grep_v(/\A\s*(something else|other)\W*\z/i) %>
          <% custom_answer = pending_answer.present? && options.exclude?(pending_answer) %>
          <p class="text-meta text-ink-2">Question <%= current_step %> of <%= PlannerSession::MAX_GENERATED_QUESTIONS %></p>
          <h2 id="meal-guide-heading" class="mt-2 text-lg font-semibold leading-snug text-ink"><%= planner_session.current_card.fetch("question") %></h2>

          <div hidden data-voice-planner-target="launcher" class="mt-4">
            <button type="button" class="voice-planner-launch" data-action="voice-planner#start" data-voice-planner-target="startButton">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-sunlit"><%= icon(:mic, size: 20, class: "text-ink") %></span>
              <span><span class="block font-semibold">Talk It Through</span><span class="block text-meta font-normal text-ink-2">Hands-free, one question at a time</span></span>
            </button>
          </div>

          <div class="mt-5 grid gap-2" data-controller="planner-answers" data-action="keydown@window->planner-answers#choose">
            <% options.each_with_index do |option, index| %>
              <% selected = option == pending_answer %>
              <%= button_to select_answer_project_planner_session_path(project, planner_session), params: { answer: option, expected_revision: planner_session.generation_revision }, class: "answer-tile meal-answer-tile", aria: { pressed: selected }, disabled: planner_session.generation_busy?, data: { turbo_submits_with: "Preparing…", planner_answers_target: "answer" } do %>
                <span class="meal-answer-radio" aria-hidden="true"></span>
                <span class="min-w-0 flex-1"><%= option %></span>
                <span class="hidden text-label text-ink-3 sm:inline" aria-hidden="true"><%= index + 1 %></span>
              <% end %>
            <% end %>

            <details class="meal-own-answer" <%= "open" if custom_answer %>>
              <summary class="answer-tile meal-answer-tile" aria-pressed="<%= custom_answer %>" aria-disabled="<%= planner_session.generation_busy? %>"
                data-planner-answers-target="answer" data-action="click->planner-answers#preventDisabled">
                <span class="meal-answer-radio" aria-hidden="true"></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate"><%= custom_answer ? pending_answer : "Something else…" %></span>
                  <% if custom_answer %>
                    <span class="block text-meta text-ink-2">Change your answer</span>
                  <% end %>
                </span>
                <span class="hidden text-label text-ink-3 sm:inline" aria-hidden="true"><%= options.size + 1 %></span>
              </summary>
              <%= form_with url: select_answer_project_planner_session_path(project, planner_session), class: "meal-own-answer-form" do |form| %>
                <%= form.hidden_field :expected_revision, value: planner_session.generation_revision %>
                <%= form.label :answer, "Your answer", class: "block text-label font-medium text-ink" %>
                <div class="mt-2 flex flex-col gap-3 sm:flex-row">
                  <%= form.text_field :answer, required: true, value: pending_answer, disabled: planner_session.generation_busy?, class: "block min-w-0 flex-1 field" %>
                  <%= form.submit "Use Answer", disabled: planner_session.generation_busy?, class: "btn btn-secondary", data: { turbo_submits_with: "Preparing…" } %>
                </div>
              <% end %>
            </details>
          </div>

          <p class="mt-2 text-label text-ink-2">Audio goes to xAI. Leave out names and care details.</p>

          <% unless planner_session.generation_busy? %>
          <div class="mt-5 empty:hidden"><% if planner_session.last_error.present? %>
              <%= render "planner_sessions/break", project:, planner_session: %>
            <% elsif planner_session.ready_to_continue? %>
              <p class="meal-builder-status" data-meal-planner-target="status">Preview updated. Change your choice or continue.</p>
            <% elsif pending_answer.blank? %>
              <p class="meal-builder-status" data-meal-planner-target="status">Choose an answer to continue.</p>
            <% end %></div>
          <% end %>

          <% if visible_items.any? %>
            <% mobile_item = visible_items.first %>
            <% mobile_last_item = visible_items.last %>
            <% mobile_fields = mobile_item.fetch("fields") %>
            <% mobile_last_fields = mobile_last_item.fetch("fields") %>
            <% mobile_date = Date.iso8601(mobile_fields["date"]) rescue nil %>
            <% mobile_last_date = Date.iso8601(mobile_last_fields["date"]) rescue nil %>
            <div class="meal-mobile-update">
              <p class="font-semibold text-ink"><%= pluralize(visible_items.size, general_planner ? "item" : "meal slot") %> taking shape</p>
              <p class="mt-1 text-meta text-ink-2"><% if general_planner %>
                <%= planner_tool_label(planner_pending_tool(mobile_item)) %> · <%= planner_pending_summary(mobile_item) %>
              <% else %><%= mobile_fields.fetch("label", "Meal") %> · <%=
                if mobile_date
                  [ mobile_date.to_fs(:long), mobile_last_date&.to_fs(:long) ].compact.uniq.join(" to ")
                else
                  "Day #{mobile_item.fetch("day_offset", 0).to_i + 1} to Day #{mobile_last_item.fetch("day_offset", visible_items.size - 1).to_i + 1}"
                end
              %><% end %></p>
              <a href="#meal-preview" class="mt-2 inline-flex min-h-11 items-center text-meta font-semibold text-ink">View all</a>
            </div>
          <% end %>

          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
            <%= button_to "Continue", continue_planning_project_planner_session_path(project, planner_session), params: { expected_revision: planner_session.generation_revision }, class: "btn btn-primary", disabled: !planner_session.ready_to_continue?, data: { turbo_submits_with: "Continuing…" } %>
            <% if visible_items.any? && !planner_session.generation_busy? %>
              <%= button_to "Finish with This", finish_planning_project_planner_session_path(project, planner_session), params: { expected_revision: planner_session.generation_revision }, class: "btn btn-text" %>
            <% end %>
          </div>
          <% else %>
          <% if planner_session.last_error.present? %>
            <h2 id="meal-guide-heading" class="text-lg font-semibold text-ink">The first choice isn’t ready yet</h2>
            <div class="mt-4"><%= render "planner_sessions/break", project:, planner_session: %></div>
          <% else %>
            <h2 id="meal-guide-heading" class="text-lg font-semibold text-ink">Preparing your first choice…</h2>
            <p class="mt-3 meal-builder-status">The Planner is shaping questions around <%= general_planner ? "this Project" : "this meal train" %>.</p>
          <% end %>
          <% end %>
          </div>

          <section hidden data-voice-planner-target="panel" class="voice-planner-panel" aria-label="Voice planning">
            <p class="text-meta text-ink-2">Question <%= current_step %> of <%= PlannerSession::MAX_GENERATED_QUESTIONS %></p>
            <div class="voice-orb" data-voice-planner-target="orb" aria-hidden="true">
              <span class="voice-orb-ring voice-orb-ring-outer"></span>
              <span class="voice-orb-ring voice-orb-ring-middle"></span>
              <span class="voice-orb-ring voice-orb-ring-inner"></span>
              <span class="voice-orb-core"></span>
            </div>
            <p class="voice-orb-status" data-voice-planner-target="status" aria-live="polite">Listening…</p>
            <div class="voice-captions" aria-live="polite">
              <p class="text-sm leading-[21px] text-ink-2"><span class="block text-meta">You</span> <span data-voice-planner-target="userCaption">Listening…</span></p>
              <p class="text-xl leading-7 text-ink"><span class="block text-meta text-ink-2">Planner</span> <span data-voice-planner-target="assistantCaption">Waiting to speak…</span></p>
            </div>
            <% if voice_phase == "choose" && recently_added_items.any? %>
              <% recent_summaries = recently_added_items.first(3).map { |item| planner_pending_summary(item) } %>
              <% recent_summaries << "and #{recently_added_items.size - 3} more" if recently_added_items.size > 3 %>
              <p class="text-meta text-ink-2">Added · <%= safe_join(recent_summaries, " · ") %></p>
            <% end %>
            <button type="button" class="btn btn-primary voice-planner-end" data-action="voice-planner#end">End Conversation</button>
          </section>
        <% end %>

        <% unless planner_session.accepted? %>
          <%# The quiet exits share one row; an open Back takes the full width so its answers read below. %>
          <div class="meal-builder-exits mt-6 flex-wrap items-start gap-x-4 border-t border-hairline pt-3">
            <% if planner_session.asking? && (planner_session.pending_answer&.fetch("step_index", 0) || planner_session.steps.length).positive? %>
              <details class="open:basis-full">
                <%= disclosure_summary "Back to Earlier Choices", class: "-ms-2 btn btn-text" %>
                <%= render "planner_sessions/meal_answers", project:, planner_session:, previous_only: true %>
              </details>
            <% end %>
            <%= button_to "Save and Leave", save_and_leave_project_planner_session_path(project, planner_session), class: "-ms-3 btn btn-text",
              form: { data: { turbo_frame: "_top" } } %>
          </div>
        <% end %>
        <%= render "planner_sessions/privacy", voice_notice: false %>
      </section>

      <% if general_planner %>
        <%= render "planner_sessions/project_preview", project:, planner_session:, visible_items:, removed_item:, pending_errors: visible_pending_errors %>
      <% else %>
        <%= render "planner_sessions/meal_preview", project:, planner_session:, visible_items:, removed_item: %>
      <% end %>
    </div>
  </section>
<% end %>
