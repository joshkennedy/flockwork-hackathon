<section id="meal-preview" class="meal-preview" aria-labelledby="meal-preview-heading" aria-busy="<%= planner_session.generation_busy? %>"
  data-controller="preview-changes" data-preview-changes-key-value="<%= dom_id(planner_session) %>">
  <div class="meal-preview-heading">
    <div>
      <h2 id="meal-preview-heading" class="text-ink">Sign-up sheet</h2>
      <p class="mt-1 text-meta text-ink-2"><%= visible_items.any? ? pluralize(visible_items.size, "meal slot") : "The first meal will appear here" %></p>
    </div>
    <% if visible_items.any? %>
      <a href="#meal-preview-list" class="meal-preview-view-all text-meta font-semibold text-ink-2">View all</a>
    <% end %>
  </div>

  <div class="mt-4">
    <% if visible_items.any? %>
      <div id="meal-preview-list" class="meal-preview-list">
        <% visible_items.each_with_index do |item, index| %>
          <%= render "planner_sessions/meal_slot", project:, planner_session:, item:, index: %>
        <% end %>
      </div>
    <% else %>
      <div class="meal-preview-empty">
        <p class="font-semibold text-ink">Your choices shape the Sign-up sheet.</p>
        <p class="mt-1 text-meta text-ink-2">Dated meal slots will stay visible here before anything is added.</p>
      </div>
    <% end %>

    <% if removed_item.present? %>
      <div class="mt-4 flex flex-wrap items-center gap-3 rounded-control bg-ghost-fill px-3 py-2 text-meta text-ink-2">
        <span>Meal removed.</span>
        <%= button_to "Undo", pending_item_project_planner_session_path(project, planner_session), method: :patch,
          params: { item: { id: removed_item.fetch("id"), decision: "restore" }, expected_revision: planner_session.generation_revision },
          disabled: planner_session.generation_busy?, class: "font-semibold text-ink hover:text-ink-hover disabled:text-ink-3" %>
      </div>
    <% end %>
  </div>
</section>
