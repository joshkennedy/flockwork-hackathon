<% definitions = Planner::PendingItems.fields_for(item.fetch("kind")) %>
<% Planner::PendingItems.editable_fields(item.fetch("kind")).each do |field_name| %>
  <% definition = definitions.fetch(field_name) %>
  <% value = fields[field_name] %>
  <% field_id = "pending_#{item.fetch('id')}_#{field_name}" %>
  <% input_name = "item[fields][#{field_name}]" %>
  <% required = !Array(definition.fetch(:schema).fetch(:type)).include?("null") %>
  <% errors = Array(field_errors[field_name]) %>
  <% error_id = "#{field_id}_error" %>
  <% accessibility = errors.any? ? { invalid: true, describedby: error_id } : {} %>
  <% field_class = class_names("mt-2 block w-full field", "field-error": errors.any?) %>

  <% if definition.fetch(:input) == :columns %>
    <%= render "planner_sessions/list_columns_editor", item:, value: Array(value), field_id:, errors:, error_id: %>
  <% else %>
    <div>
      <%= label_tag field_id, definition.fetch(:label), class: "block text-label font-medium text-ink" %>
      <% if field_name == "schedule_item_source_key" %>
        <%= select_tag input_name, options_for_select([[ "No Schedule item", "" ]] + planner_schedule_item_options(planner_session, value), value), id: field_id, class: field_class, aria: accessibility %>
      <% else %>
      <% case definition.fetch(:input) %>
      <% when :textarea %>
        <%= text_area_tag input_name, value, id: field_id, rows: 3, required:, class: field_class, aria: accessibility %>
      <% when :select %>
        <% options = definition.fetch(:options).map { |option_value, label| [ label, option_value ] } %>
        <%= select_tag input_name, options_for_select(options, value), id: field_id, required:, class: field_class, aria: accessibility %>
      <% else %>
        <%= tag.input type: definition.fetch(:input), name: input_name, id: field_id, value:, required:, min: definition[:min], step: definition[:step], class: field_class, aria: accessibility %>
      <% end %>
      <% end %>
      <% if errors.any? %>
        <p id="<%= error_id %>" class="mt-1 text-meta text-danger"><%= errors.to_sentence %></p>
      <% end %>
    </div>
  <% end %>
<% end %>
