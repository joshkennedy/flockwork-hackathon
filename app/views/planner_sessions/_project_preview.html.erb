<section id="meal-preview" class="meal-preview" aria-labelledby="meal-preview-heading" aria-busy="<%= planner_session.generation_busy? %>"
  data-controller="preview-changes" data-preview-changes-key-value="<%= dom_id(planner_session) %>">
  <div class="meal-preview-heading">
    <div>
      <h2 id="meal-preview-heading" class="text-ink">Project preview</h2>
      <p class="mt-1 text-meta text-ink-2"><%= visible_items.any? ? "Suggestions · not added yet · #{pluralize(visible_items.size, "item")}" : "Your Project will take shape here" %></p>
    </div>
    <% if visible_items.any? %>
      <a href="#meal-preview-list" class="meal-preview-view-all text-meta font-semibold text-ink-2" aria-label="View all items">View all</a>
    <% end %>
  </div>

  <div class="mt-4">
    <% if visible_items.any? %>
      <div id="meal-preview-list" class="planner-tool-groups">
        <% visible_items.group_by { |item| planner_pending_tool(item) }.each do |tool, items| %>
          <section class="planner-tool-group" aria-labelledby="pending-tool-<%= tool %>">
            <h3 id="pending-tool-<%= tool %>" class="planner-tool-heading"><%= planner_tool_label(tool) %></h3>
            <div class="meal-preview-list">
              <% items.each do |item| %>
                <%= render "planner_sessions/pending_item", project:, planner_session:, item:, pending_errors: %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% elsif !planner_session.generation_busy? %>
      <div class="meal-preview-empty">
        <p>Choose what matters first.</p>
        <p class="mt-1 text-meta text-ink-2">Tasks, dates, costs, and lists will stay visible here before anything is added.</p>
      </div>
    <% end %>

    <% if planner_session.generation_busy? %>
      <div class="meal-building">
        <p class="meal-builder-status" data-meal-planner-target="status"><span class="meal-pulse-dot bg-sunlit" aria-hidden="true"></span>Drafting your plan…</p>
        <% [ [ :budget, "text-tool-budget" ], [ :tasks, "text-tool-tasks" ], [ :schedule, "text-tool-schedule" ] ].each_with_index do |(glyph, color), index| %>
          <div class="flex items-center gap-2" aria-hidden="true">
            <%= icon(glyph, class: "#{color} opacity-50") %>
            <div class="meal-skeleton <%= "meal-skeleton-short" if index == 2 %>"></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if removed_item.present? %>
      <div class="mt-4 flex flex-wrap items-center gap-3 rounded-control bg-ghost-fill px-3 py-2 text-meta text-ink-2">
        <span>Item removed.</span>
        <%= button_to "Undo", pending_item_project_planner_session_path(project, planner_session), method: :patch,
          params: { item: { id: removed_item.fetch("id"), decision: "restore" }, expected_revision: planner_session.generation_revision },
          disabled: planner_session.generation_busy?, class: "font-semibold text-ink hover:text-ink-hover disabled:text-ink-3" %>
      </div>
    <% end %>
  </div>
</section>
