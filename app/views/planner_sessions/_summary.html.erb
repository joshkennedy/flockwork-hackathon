<%= turbo_frame_tag dom_id(planner_session, :summary) do %>
  <aside class="bg-[#e7ede3] p-6" aria-labelledby="planner-summary-heading">
    <h2 id="planner-summary-heading" class="text-lg font-bold text-stone-950">Suggestions</h2>

    <% if planner_session.suggestions.any? %>
      <div class="mt-5 space-y-5">
        <% planner_session.suggestions.group_by { |suggestion| suggestion.fetch("kind") }.each do |kind, suggestions| %>
          <section aria-label="<%= Planner::SuggestionKinds.label(kind) %>">
            <h3 class="font-semibold text-stone-950"><%= Planner::SuggestionKinds.label(kind) %> <span class="text-stone-600"><%= suggestions.length %></span></h3>
            <ul class="mt-2 space-y-2">
              <% suggestions.each do |suggestion| %>
                <li class="text-sm text-stone-700"><%= Planner::SuggestionKinds.summary(suggestion) %></li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 text-sm leading-6 text-stone-600">Suggestions will appear here as the plan takes shape.</p>
    <% end %>
  </aside>
<% end %>
