<% content_for :title, "Plan #{@project.name}" %>

<div class="w-full max-w-2xl">

  <header>
    <h1 class="text-ink">What are you planning?</h1>
    <p class="mt-4 max-w-xl text-body-phone sm:text-body leading-normal text-ink-2">Give the Planner one sentence. It will ask a few focused questions and build Suggestions for you to review.</p>
  </header>

  <%= form_with model: [ @project, @planner_session ], class: "mt-7 space-y-6" do |form| %>
    <% if @planner_session.errors.any? %>
      <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger">
        <p class="font-semibold">Please add a description.</p>
      </div>
    <% end %>

    <div>
      <%= form.label :description, "Describe this plan in one sentence", class: "block text-label font-medium text-ink" %>
      <%= render layout: "shared/dictation_button", locals: { wrapper_class: "mt-2 flex w-full items-center gap-2" } do %>
        <%= form.text_field :description, required: true, autofocus: true, data: { dictation_target: "field" }, class: "block min-w-0 flex-1 field", placeholder: "Prepare the final week before our neighborhood meal." %>
      <% end %>
    </div>

    <%= form.submit "Start Planning", class: "btn btn-primary" %>
  <% end %>
  <%= render "privacy" %>
</div>
