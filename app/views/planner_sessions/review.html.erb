<% content_for :title, "Review Suggestions" %>

<div class="w-full max-w-4xl">
  <h1>Review Suggestions</h1>
  <p class="mt-3 max-w-2xl text-ink-2">Keep what fits, edit what needs work, and drop the rest. People and open roles stay unassigned.</p>

  <% if @planner_session.last_error.present? %>
    <p role="alert" class="mt-5 text-danger"><%= PlannerSession::ERROR_MESSAGE %></p>
  <% end %>

  <% if @planner_session.suggestions.any? %>
    <div class="mt-7 space-y-3">
      <% @planner_session.suggestions.each do |suggestion| %>
        <% kept = %w[kept edited].include?(suggestion.fetch("status")) %>
        <section id="suggestion-<%= suggestion.fetch("id") %>" class="suggestion tile-ghost p-4 <%="kept" if kept %>" aria-label="<%= Planner::SuggestionKinds.label(suggestion.fetch("kind")) %> Suggestion: <%= Planner::SuggestionKinds.summary(suggestion) %>">
          <p class="flex items-start gap-2">
            <% if kept %><%= icon(:kept, class: "kept-check mt-0.5 text-sunlit") %><% end %>
            <span><%= Planner::SuggestionKinds.summary(suggestion) %></span>
          </p>
          <p class="mt-2 text-label text-ink-2"><%= Planner::SuggestionKinds.label(suggestion.fetch("kind")).singularize %> Suggestion · Currently <%= suggestion.fetch("status").humanize.downcase %></p>
          <details class="mt-2" <%= "open" unless kept %>>
            <%= disclosure_summary(kept ? "Edit Kept Suggestion" : "Edit Suggestion", class: "text-label text-ink-2") %>
            <%= form_with url: suggestion_project_planner_session_path(@project, @planner_session), method: :patch, class: "mt-4 space-y-4" do |form| %>
              <%= form.hidden_field :id, name: "suggestion[id]", value: suggestion.fetch("id"), id: nil %>
              <%= render "suggestion_fields", suggestion: %>
              <div class="flex flex-wrap gap-2">
                <%= form.button "Keep", name: "suggestion[decision]", value: "keep", class: "btn btn-text" %>
                <%= form.button "Save Edit", name: "suggestion[decision]", value: "edit", class: "btn btn-text" %>
                <%= form.button "Drop", name: "suggestion[decision]", value: "drop", class: "btn btn-danger" %>
              </div>
            <% end %>
          </details>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-ink-2">There are no Suggestions to accept. You can return to the Project and keep building by hand.</p>
  <% end %>

  <div class="mt-7 flex flex-wrap items-center gap-3">
    <%= button_to "Accept All Kept and Edited", accept_project_planner_session_path(@project, @planner_session), params: { mode: "kept" }, class: "btn btn-primary" %>
    <%= button_to "Accept All", accept_project_planner_session_path(@project, @planner_session), params: { mode: "all" }, class: "btn btn-text" %>
  </div>
  <%= render "privacy" %>
</div>
