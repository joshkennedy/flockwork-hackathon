<% content_for :title, "Profile" %>

<div class="w-full max-w-4xl">
  <div class="flex items-center gap-4">
    <%= avatar(@person, size: :lg) %>
    <div class="min-w-0 flex-1"><%= page_header "Profile" %></div>
  </div>

  <%# Vertical tabs, one section in view at a time. Details and Notifications share one form, so either Save keeps both. %>
  <% sections = [ [ "details", "Details", :user ], [ "notifications", "Notifications", :notifications ], [ "away", "When you're away", :schedule ], [ "appearance", "Appearance", :settings ], [ "involvement", "Your Involvement", :heart ] ] %>
  <div class="mt-7 grid gap-6 md:grid-cols-[200px_minmax(0,1fr)] md:gap-10" data-controller="tabs">
    <nav class="flex gap-1 overflow-x-auto md:flex-col md:gap-0.5" aria-label="Profile sections">
      <% sections.each_with_index do |(name, label, symbol), index| %>
        <%= link_to "#profile-#{name}", class: "nav-item shrink-0", aria: { current: index.zero? }, data: { tabs_target: "tab", tabs_name: name, action: "tabs#select" } do %>
          <%= icon(symbol) %><span><%= label %></span>
        <% end %>
      <% end %>
    </nav>

    <div class="min-w-0 max-w-xl">
      <%= form_with model: @person, url: profile_path, method: :patch do |form| %>
        <% if @person.errors.any? %>
          <div role="alert" class="mb-4 rounded-control bg-danger-soft px-4 py-3 text-meta text-danger">
            <%= @person.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <section id="profile-details" class="space-y-4" data-tabs-target="panel" data-tabs-name="details" aria-label="Details">
          <div>
            <%= form.label :name, class: "block text-label font-medium text-ink-2" %>
            <%= form.text_field :name, required: true, class: "mt-1 block w-full field" %>
          </div>

          <div>
            <p class="block text-meta font-medium text-ink-2">Email</p>
            <p class="mt-1 text-meta text-ink-2"><%= @person.email.presence || "Can't sign in (no email)" %></p>
          </div>

          <div>
            <%= form.label :phone, class: "block text-label font-medium text-ink-2" %>
            <%= form.telephone_field :phone, class: "mt-1 block w-full field" %>
          </div>

          <%= render "shared/skills_field", form:, attribute: :skills, legend: "Your skills",
            hint: "Leaders may suggest you for Projects that need these. They see only the skills that match." %>

          <%= form.submit "Save Changes", class: "btn btn-primary" %>
        </section>

        <section id="profile-notifications" class="space-y-4" data-tabs-target="panel" data-tabs-name="notifications" aria-label="Notifications" hidden>
          <fieldset>
            <legend class="text-body-phone sm:text-body font-semibold text-ink">Notification delivery</legend>
            <p id="notification-channels-hint" class="mt-1 text-meta text-ink-2">Choose any combination for each type. Leave a row unchecked to turn it off. Changes apply to new notifications.</p>
            <table class="mt-5 w-full table-fixed text-meta" aria-describedby="notification-channels-hint">
              <caption class="sr-only">Delivery channels for each notification type</caption>
              <colgroup><col class="w-[46%]"><col><col><col></colgroup>
              <thead>
                <tr class="text-label text-ink-2">
                  <th scope="col" class="pb-2 text-left font-medium">Notify me about</th>
                  <th scope="col" class="pb-2 text-center font-medium">In-app</th>
                  <th scope="col" class="pb-2 text-center font-medium">Email</th>
                  <th scope="col" class="pb-2 text-center font-medium">SMS</th>
                </tr>
              </thead>
              <tbody>
                <% Notification::KINDS.each do |kind, settings| %>
                  <tr>
                    <th scope="row" class="py-2 pr-2 text-left font-normal text-ink"><%= settings.fetch(:label) %></th>
                    <% Person::NOTIFICATION_CHANNELS.each do |channel, attribute| %>
                      <td class="py-2 text-center align-middle">
                        <%= hidden_field_tag "person[#{attribute}][#{kind}]", "0", id: nil %>
                        <label class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center">
                          <%= check_box_tag "person[#{attribute}][#{kind}]", "1", @person.notification_for?(channel, kind), id: "person_#{attribute}_#{kind}", class: "size-4 rounded border-hairline text-ink focus:border-ink" %>
                          <span class="sr-only"><%= settings.fetch(:label) %> via <%= channel == "in_app" ? "in-app" : channel.upcase %></span>
                        </label>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </fieldset>

          <div class="space-y-2 text-meta text-ink-2">
            <p>SMS number: <span class="font-medium text-ink"><%= @person.phone.presence || "Not set" %></span>.
              <%= link_to "Change phone", "#profile-details", class: "link", data: { action: "tabs#select", tabs_name: "details" } %>
            </p>
            <p>Use a number with its country code, such as +12025550100. Enabling SMS opts you in to these Flockwork texts. Message and data rates may apply. Reply STOP to opt out.</p>
          </div>

          <%= form.submit "Save Changes", class: "btn btn-primary" %>
        </section>
      <% end %>

      <div id="profile-away" data-tabs-target="panel" data-tabs-name="away" hidden>
        <%= render "away_dates", section_class: "" %>
      </div>

      <div id="profile-appearance" data-tabs-target="panel" data-tabs-name="appearance" hidden>
        <fieldset class="space-y-3" data-controller="appearance" data-action="change->appearance#pick">
          <legend class="text-body-phone font-semibold text-ink sm:text-body">Appearance on this device</legend>
          <p class="text-meta text-ink-2">Only this browser changes. Your church's theme color stays the same.</p>
          <div class="grid grid-cols-3 gap-2 sm:max-w-md">
            <% [["Light", "light"], ["Dark", "dark"], ["Match device", "system"]].each do |label, value| %>
              <label class="tile-raised flex cursor-pointer items-center justify-center px-3 py-2.5 text-button has-[:checked]:border-ink has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ink">
                <%= radio_button_tag :appearance, value, appearance == value, class: "sr-only" %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>

      <div id="profile-involvement" data-tabs-target="panel" data-tabs-name="involvement" hidden>
        <%= render "shared/involvement_timeline", involvement: @involvement, title: "Your Involvement", section_class: "" %>
      </div>
    </div>
  </div>
</div>
