<% content_for :title, "Project Debrief" %>

<div class="w-full max-w-xl">
  <%= page_header "Project Debrief" %>
  <p class="mt-4 text-body text-ink-2"><%= @project.name %> is done. Leave two short notes for next time, or skip this step.</p>
  <p class="mt-3 text-meta text-ink-2">Leaders and Admins can edit these answers. Duplicating this Project carries them into a Leader-only note. The Planner may use redacted answers from finished Projects. Keep names and private details out.</p>

  <%= form_with model: @debrief, url: project_debrief_path(@project), method: :patch, class: "mt-6 space-y-5" do |form| %>
    <% if @debrief.errors.any? %>
      <p role="alert" class="text-meta text-danger"><%= @debrief.errors.full_messages.to_sentence %></p>
    <% end %>
    <div>
      <%= form.label :what_worked, "What worked?", class: "block text-label font-medium text-ink-2" %>
      <%= form.text_area :what_worked, rows: 4, maxlength: 2000, class: "field mt-1 block w-full" %>
    </div>
    <div>
      <%= form.label :change_next_time, "What would you change next time?", class: "block text-label font-medium text-ink-2" %>
      <%= form.text_area :change_next_time, rows: 4, maxlength: 2000, class: "field mt-1 block w-full" %>
    </div>
    <%= form.submit "Save Debrief", class: "btn btn-primary" %>
  <% end %>
  <p class="mt-5"><%= link_to "Skip for Now", project_path(@project), class: "link" %></p>
</div>
