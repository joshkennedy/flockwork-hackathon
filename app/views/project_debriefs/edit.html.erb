<% content_for :title, "Project debrief" %>

<div class="w-full max-w-xl">
  <%= page_header "Project debrief" %>
  <p class="mt-3 text-meta text-ink-2">Leaders and Admins can edit these. Duplicating this Project carries them into a Leader-only Note. The Planner may use redacted answers, so keep names and private details out.</p>

  <%= form_with model: @debrief, url: project_debrief_path(@project), method: :patch, class: "mt-6 space-y-5" do |form| %>
    <% if @debrief.errors.any? %>
      <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
        <p class="font-semibold">Fix these to continue:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
          <% @debrief.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div>
      <%= form.label :what_worked, "What worked?", class: "block text-label font-medium text-ink-2" %>
      <%= form.text_area :what_worked, rows: 4, maxlength: 2000, class: "field mt-2 block w-full" %>
    </div>
    <div>
      <%= form.label :change_next_time, "What would you change next time?", class: "block text-label font-medium text-ink-2" %>
      <%= form.text_area :change_next_time, rows: 4, maxlength: 2000, class: "field mt-2 block w-full" %>
    </div>
    <%= form.submit "Save Debrief", class: "btn btn-primary" %>
  <% end %>
  <p class="mt-5"><%= link_to "Skip for Now", project_path(@project), class: "link" %></p>
</div>
