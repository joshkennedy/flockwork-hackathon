<% content_for :title, "Duplicate #{@source.name}" %>

<div class="w-full max-w-2xl">
  <%= link_to @source.name, project_path(@source), class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
  <h1 class="mt-5 text-ink">Duplicate <%= @source.name %></h1>
  <p class="mt-3 text-ink-2">Choose when the new Project starts. Every dated item will move by the same amount.</p>

  <%= form_with model: @project_duplicate, url: project_duplicate_path(@source), class: "mt-7 space-y-6" do |form| %>
    <% if @project_duplicate.errors.any? %>
      <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger">
        <p class="font-semibold">Please fix the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
          <% @project_duplicate.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-label font-medium text-ink" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 block w-full field" %>
    </div>

    <div>
      <%= form.label :start_on, "Start date", class: "block text-label font-medium text-ink" %>
      <%= form.date_field :start_on, required: true, class: "mt-2 block w-full field" %>
    </div>

    <%= form.submit "Duplicate Project", class: "btn btn-primary" %>
  <% end %>
</div>
