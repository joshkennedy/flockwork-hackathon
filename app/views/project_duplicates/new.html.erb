<% content_for :title, "Duplicate #{@source.name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "Projects", projects_path, class: "shrink-0 whitespace-nowrap hover:text-ink" %>
  <span aria-hidden="true" class="shrink-0 text-ink-3">/</span>
  <%= link_to @source.name, project_path(@source), class: "min-w-0 truncate hover:text-ink" %>
  <span aria-hidden="true" class="shrink-0 text-ink-3">/</span>
  <span class="min-w-0 truncate text-ink" aria-current="page">Duplicate</span>
<% end %>

<div class="w-full max-w-2xl">
  <%= page_header "Duplicate #{@source.name}", subtitle: "Every dated item moves by the same amount." %>

  <%= form_with model: @project_duplicate, url: project_duplicate_path(@source), class: "mt-7 space-y-6" do |form| %>
    <% if @project_duplicate.errors.any? %>
      <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
        <p class="font-semibold">Fix these to continue:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
          <% @project_duplicate.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-label font-medium text-ink" %>
      <%= form.text_field :name, required: true, maxlength: Project::NAME_MAX_LENGTH, autofocus: true, class: "mt-2 block w-full field" %>
    </div>

    <div>
      <%= form.label :start_on, "Start date", class: "block text-label font-medium text-ink" %>
      <%= form.date_field :start_on, required: true, class: "mt-2 block w-full field" %>
    </div>

    <%= form.submit "Duplicate Project", class: "btn btn-primary" %>
  <% end %>
</div>
