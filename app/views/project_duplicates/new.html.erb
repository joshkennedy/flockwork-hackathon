<% content_for :title, "Duplicate #{@source.name}" %>

<div class="mx-auto w-full max-w-2xl">
  <%= link_to @source.name, project_path(@source), class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>
  <h1 class="mt-5 text-4xl font-bold tracking-tight text-stone-950">Duplicate <%= @source.name %></h1>
  <p class="mt-3 text-stone-600">Choose when the new Project starts. Every dated item will move by the same amount.</p>

  <%= form_with model: @project_duplicate, url: project_duplicate_path(@source), class: "mt-10 space-y-6" do |form| %>
    <% if @project_duplicate.errors.any? %>
      <div class="border-l-4 border-red-700 bg-red-50 px-5 py-4 text-red-950">
        <p class="font-semibold">Please fix the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          <% @project_duplicate.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-sm font-semibold text-stone-900" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :start_on, "Start date", class: "block text-sm font-semibold text-stone-900" %>
      <%= form.date_field :start_on, required: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>

    <%= form.submit "Duplicate Project", class: "cursor-pointer bg-[#1f291f] px-5 py-3 text-sm font-semibold text-white hover:bg-[#354235]" %>
  <% end %>
</div>
