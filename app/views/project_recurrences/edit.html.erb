<% content_for :title, "Repeat Project" %>

<div class="w-full max-w-xl">
  <%= page_header "Repeat Project" %>
  <p class="mt-4 text-body text-ink-2">Repeat <%= @project.name %> from its original start date. Flockwork creates each copy up to seven days ahead, with Tasks, Slots, Skills, and Lists. People and assignments are not copied.</p>
  <% if (@recurrence.anchor_on || @project.starts_on).blank? %>
    <p class="mt-4 text-body text-danger">Set a Project start date before turning on repetition.</p>
    <%= link_to "Edit Project", edit_project_path(@project), class: "btn btn-primary mt-4" %>
  <% else %>
    <p class="mt-4 text-meta text-ink-2">Dates repeat from <%= (@recurrence.anchor_on || @project.starts_on).strftime("%B %-d, %Y") %>. Copies are created only while this Project is active and the person who saved this rule can still lead it.</p>
    <%= form_with model: @recurrence, url: project_recurrence_path(@project), method: :patch, class: "mt-6 space-y-5" do |form| %>
      <% if @recurrence.errors.any? %>
        <p role="alert" class="text-meta text-danger"><%= @recurrence.errors.full_messages.to_sentence %></p>
      <% end %>
      <div>
        <%= form.label :frequency, "Repeat", class: "block text-label font-medium text-ink-2" %>
        <%= form.select :frequency, [ [ "Weekly", "weekly" ], [ "Monthly", "monthly" ] ], {}, class: "field mt-1 block w-full" %>
      </div>
      <div class="flex items-start gap-3">
        <%= form.check_box :enabled, class: "mt-1" %>
        <%= form.label :enabled, "Create upcoming copies automatically", class: "text-body text-ink" %>
      </div>
      <p class="text-meta text-ink-2">Turning this off keeps copies already created. Monthly copies keep the original day when possible.</p>
      <%= form.submit "Save Repetition", class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>
