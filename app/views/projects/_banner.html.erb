<% has_banner = project.banner.attached? %>
<% if has_banner || editable %>
  <% show_banner = project.banner_ready? %>
  <% small = show_banner && project.banner_small? %>
  <div class="mb-6 space-y-3">
    <% if has_banner && (show_banner || editable) %>
      <% chip = "inline-flex min-h-control-h items-center justify-center rounded-full bg-panel/90 px-3 text-button shadow-secondary backdrop-blur-md motion-safe:transition-colors hover:bg-panel focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
      <% width, height = project.banner.blob.metadata.values_at("width", "height") %>
      <% editor = editable ? tag.attributes(data: { controller: "banner-upload banner-focus", action: "dragover->banner-upload#over dragleave->banner-upload#leave drop->banner-upload#drop keydown->banner-focus#key focusout->banner-focus#collapse", banner_focus_width_value: width, banner_focus_height_value: height }) : "" %>
      <figure <%= editor %> class="group/banner relative isolate flex aspect-[3/1] items-center justify-center overflow-hidden rounded-panel border border-border bg-frame max-sm:aspect-[2/1]">
        <% if show_banner %>
          <% wide = url_for(project.banner_variant(:wide)) %>
          <% alt = project.banner_alt_text.presence || "#{project.name} banner" %>
          <% if small %>
            <%# Too small to crop up to banner size: show the photo whole on a blurred copy of itself instead of upscaling it. %>
            <img src="<%= wide %>" alt="" aria-hidden="true" class="absolute inset-0 size-full scale-110 object-cover opacity-60 blur-2xl">
            <img src="<%= wide %>" alt="<%= alt %>" class="relative max-h-full max-w-full object-contain">
          <% else %>
            <picture class="block size-full">
              <source media="(max-width: 639px)" srcset="<%= url_for(project.banner_variant(:phone)) %>">
              <img src="<%= wide %>" alt="<%= alt %>" class="block size-full object-cover">
            </picture>
          <% end %>
        <% end %>

        <% if editable %>
          <% if show_banner %>
            <%# Reposition mode: the full-resolution photo covers the banner, and object-position moves with the focal point. %>
            <div data-banner-focus-target="layer" hidden tabindex="0" role="group" aria-label="Banner photo. Drag, or use the arrow keys, to reposition it."
                 class="absolute inset-0 cursor-grab touch-none select-none overflow-hidden active:cursor-grabbing focus-visible:-outline-offset-4 focus-visible:outline-2 focus-visible:outline-ink"
                 data-action="pointerdown->banner-focus#start pointermove->banner-focus#move pointerup->banner-focus#stop pointercancel->banner-focus#stop">
              <img src="<%= url_for(project.banner_reposition_variant) %>" alt="" draggable="false" loading="lazy" class="pointer-events-none size-full object-cover">
            </div>
          <% end %>

          <div class="pointer-events-none absolute inset-0 hidden items-center justify-center bg-panel/80 text-heading text-ink group-data-[dragging]/banner:flex">
            <span class="rounded-control border-2 border-dashed border-ink bg-panel px-4 py-3">Drop to replace the banner</span>
          </div>

          <div data-banner-focus-target="view" class="absolute right-3 top-3 flex max-w-[calc(100%-1.5rem)] flex-wrap pointer-coarse:bottom-3 pointer-coarse:top-auto justify-end gap-1.5 opacity-0 motion-safe:transition-opacity group-hover/banner:opacity-100 group-focus-within/banner:opacity-100 group-data-[open]/banner:opacity-100">
            <button type="button" class="<%= chip %> text-ink" data-action="banner-upload#pick">Replace</button>
            <% if show_banner %>
              <button type="button" class="<%= chip %> text-ink" data-banner-focus-target="repositionButton" data-action="banner-focus#reposition">Reposition</button>
              <button type="button" class="<%= chip %> text-ink" data-banner-focus-target="altButton" popovertarget="banner-alt-popover">Alt Text</button>
            <% end %>
            <%= button_to "Remove", project_banner_path(project), method: :delete, form_class: "contents",
                  class: "#{chip} text-danger", form: { data: { turbo_confirm: "Remove this banner photo? Its focal point and alt text go with it." } } %>
          </div>

          <button type="button" aria-label="Edit banner" data-banner-focus-target="touchEdit" data-action="banner-focus#toggleToolbar"
                  class="absolute right-3 top-3 hidden size-9 items-center justify-center rounded-full bg-panel/90 text-ink shadow-secondary backdrop-blur-md pointer-coarse:flex">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4 fill-current"><path d="M13.6 2.9a1.9 1.9 0 0 1 2.7 2.7L7.2 15.7l-3.5.8.8-3.5 9.1-10.1Z"/></svg>
          </button>

          <% if show_banner %>
            <div data-banner-focus-target="edit" hidden role="group" aria-label="Reposition the banner" class="absolute inset-x-3 bottom-3 rounded-panel bg-panel/90 p-2 pl-3 shadow-float backdrop-blur-md">
              <%= form_with model: project, url: project_banner_path(project), method: :patch, class: "flex flex-wrap items-center justify-between gap-2" do |form| %>
                <p class="text-meta text-ink">Drag to reposition</p>
                <div class="flex flex-wrap items-center gap-2">
                  <div class="inline-flex gap-0.5 rounded-control bg-frame p-0.5" role="group" aria-label="Crop preview">
                    <button type="button" data-ratio="3" aria-pressed="true" data-banner-focus-target="ratio" data-action="banner-focus#crop" class="rounded-[4px] px-2.5 py-1 text-meta text-ink aria-pressed:bg-panel aria-pressed:shadow-secondary">Desktop</button>
                    <button type="button" data-ratio="2" aria-pressed="false" data-banner-focus-target="ratio" data-action="banner-focus#crop" class="rounded-[4px] px-2.5 py-1 text-meta text-ink aria-pressed:bg-panel aria-pressed:shadow-secondary">Phone</button>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" data-action="banner-focus#cancel">Cancel</button>
                  <%= form.hidden_field :banner_focus_x, data: { banner_focus_target: "x" } %>
                  <%= form.hidden_field :banner_focus_y, data: { banner_focus_target: "y" } %>
                  <%= form.submit "Save Banner", class: "btn btn-primary min-h-control-h w-auto" %>
                </div>
              <% end %>
            </div>

            <%# Alt text is optional: the AI suggests one in the background, and this popover lets an editor confirm, change or clear it. %>
            <div id="banner-alt-popover" popover data-banner-focus-target="altPopover" data-action="toggle->banner-focus#positionAlt"
                 class="m-0 w-72 max-w-[calc(100vw-2rem)] rounded-panel border border-border bg-panel p-4 text-ink shadow-float">
              <%= form_with model: project, url: project_banner_path(project), method: :patch, class: "grid gap-2" do |form| %>
                <%= form.label :banner_alt_text, "Alt text", class: "text-label font-medium text-ink" %>
                <%= form.text_field :banner_alt_text, value: project.banner_alt_text || project.banner_alt_suggestion, maxlength: 200, class: "field w-full", data: { banner_focus_target: "altField" } %>
                <% if project.banner_alt_text.nil? && project.banner_alt_suggestion %>
                  <p class="text-meta text-ink-2">Suggested by AI. Check it, then save to use it as the alt text.</p>
                <% end %>
                <p class="text-meta text-ink-2">Read aloud by screen readers. Describe the photo in a few words, or clear it to use the project name.</p>
                <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                  <button type="button" class="btn btn-text" data-action="banner-focus#clearAlt">Clear Alt Text</button>
                  <%= form.submit "Save Alt Text", class: "btn btn-secondary" %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%# Hidden form that the Replace button and drops submit through. %>
          <%= form_with model: project, url: project_banner_path(project), method: :patch, multipart: true, class: "hidden",
                data: { controller: "upload", upload_key_value: "project-banner-#{project.id}", action: "turbo:submit-start->upload#start turbo:submit-end->upload#finish direct-upload:start->upload#start direct-upload:progress->upload#progress direct-upload:error->upload#directError" } do |form| %>
            <%= form.file_field :banner, accept: Project::BANNER_TYPES.join(","), tabindex: -1, class: "sr-only", data: { banner_upload_target: "input", upload_target: "input", action: "change->banner-upload#submit" } %>
          <% end %>
        <% end %>

        <% unless show_banner %>
          <p class="text-meta text-ink-2">This photo can't be shown yet.</p>
        <% end %>
      </figure>
      <% if small %>
        <p class="text-meta text-ink-2">This photo is small for a banner, so it sits on a soft blurred background. A larger photo fills the banner edge to edge.</p>
      <% end %>
    <% elsif editable %>
      <%= render "projects/banner_upload", project: project %>
    <% end %>
  </div>
<% end %>
