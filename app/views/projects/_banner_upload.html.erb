<%# The ⋯ menu's Add Banner item: choosing a file submits it, and the server checks the real type and size. %>
<%= form_with model: project, url: project_banner_path(project), method: :patch, multipart: true,
      data: { controller: "banner-upload upload", upload_key_value: "project-banner-#{project.id}", action: "turbo:submit-start->upload#start turbo:submit-end->upload#finish direct-upload:start->upload#start direct-upload:progress->upload#progress direct-upload:error->upload#directError" } do |form| %>
  <button type="button" data-action="banner-upload#pick">Add Banner</button>
  <%= form.file_field :banner, accept: Project::BANNER_TYPES.join(","), tabindex: -1, class: "sr-only", data: { banner_upload_target: "input", upload_target: "input", action: "change->banner-upload#submit" } %>
<% end %>
