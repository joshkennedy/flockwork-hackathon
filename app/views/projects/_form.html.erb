<%= form_with model: project, class: "space-y-7" do |form| %>
  <% if project.errors.any? %>
    <div class="border-l-4 border-red-700 bg-red-50 px-5 py-4 text-red-950">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-semibold text-stone-900" %>
    <%= form.text_field :name, required: true, autofocus: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold text-stone-900" %>
    <p class="mt-1 text-sm text-stone-600">One sentence about the work this Team is planning.</p>
    <%= form.text_area :description, rows: 3, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :starts_on, "Start date", class: "block text-sm font-semibold text-stone-900" %>
      <%= form.date_field :starts_on, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>
    <div>
      <%= form.label :ends_on, "End date", class: "block text-sm font-semibold text-stone-900" %>
      <%= form.date_field :ends_on, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>
  </div>

  <fieldset>
    <legend class="text-lg font-semibold text-stone-950">Tools</legend>
    <p class="mt-1 text-sm text-stone-600">Choose what this Project needs.</p>
    <div class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <%= form.collection_check_boxes :enabled_tools, Project::TOOLS, :to_s, ->(tool) { Project::TOOL_LABELS.fetch(tool) } do |checkbox| %>
        <%= checkbox.label(class: "flex cursor-pointer items-center gap-3 py-1 text-sm font-medium text-stone-800") do %>
          <%= checkbox.check_box(class: "size-4 accent-stone-950") %>
          <%= checkbox.text %>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <%= form.submit class: "cursor-pointer bg-[#1f291f] px-5 py-3 text-sm font-semibold text-white hover:bg-[#354235]" %>
<% end %>
