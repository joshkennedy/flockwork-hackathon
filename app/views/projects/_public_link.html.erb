<% if Policy.can?(Current.person, :manage_public_link, project) %>
  <section class="mt-3" aria-labelledby="public-link-heading">
    <h2 id="public-link-heading" class="text-ink">Public link</h2>
    <p class="mt-2 text-meta text-ink-2">Share a view-only link with people who are not signed in. Team names and private Tools stay hidden.</p>

    <% if project.public_token.present? %>
      <label class="mt-4 block text-label font-semibold text-ink" for="public-link-url">Public URL</label>
      <input
        id="public-link-url"
        type="text"
        readonly
        value="<%= public_project_url(project.public_token) %>"
        class="field w-full"
        onclick="this.select()"
      >
      <div class="mt-4 flex flex-wrap gap-3">
        <%= button_to "Reset link", reset_public_link_project_path(project), class: "btn btn-secondary" %>
        <%= button_to "Turn off", disable_public_link_project_path(project), class: "btn btn-danger" %>
      </div>
    <% else %>
      <%= button_to "Turn on Public link", enable_public_link_project_path(project), class: "mt-4 btn btn-secondary" %>
    <% end %>
  </section>
<% end %>
