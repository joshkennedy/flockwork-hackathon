<% if Policy.can?(Current.person, :manage_public_link, project) %>
  <section class="mt-10 max-w-3xl border border-stone-300 bg-white p-6" aria-labelledby="public-link-heading">
    <h2 id="public-link-heading" class="text-lg font-bold text-stone-950">Public link</h2>
    <p class="mt-2 text-sm text-stone-600">Share a view-only link with people who are not signed in. Team names and private Tools stay hidden.</p>

    <% if project.public_token.present? %>
      <label class="mt-4 block text-sm font-semibold text-stone-800" for="public-link-url">Public URL</label>
      <input
        id="public-link-url"
        type="text"
        readonly
        value="<%= public_project_url(project.public_token) %>"
        class="mt-2 w-full border border-stone-400 bg-stone-50 px-3 py-2 text-sm text-stone-900"
        onclick="this.select()"
      >
      <div class="mt-4 flex flex-wrap gap-3">
        <%= button_to "Reset link", reset_public_link_project_path(project), class: "border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>
        <%= button_to "Turn off", disable_public_link_project_path(project), class: "border border-red-300 px-4 py-2 text-sm font-semibold text-red-800 hover:bg-red-50" %>
      </div>
    <% else %>
      <%= button_to "Turn on Public link", enable_public_link_project_path(project), class: "mt-4 bg-[#1f291f] px-4 py-2 text-sm font-semibold text-white hover:bg-[#354235]" %>
    <% end %>
  </section>
<% end %>
