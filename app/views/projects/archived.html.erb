<%= turbo_stream_from Current.organization, :dashboard %>
<% content_for :title, "Archived Projects" %>

<div class="w-full">
  <%= page_header "Archived Projects" %>

  <nav class="mt-5 tab-bar" aria-label="Project lists">
    <%= link_to "Active", projects_path, class: "tab-link" %>
    <%= link_to "Archived", archived_projects_path, class: "tab-link", aria: { current: "page" } %>
    <% if Policy.can?(Current.person, :view_deleted, Project) %>
      <%= link_to "Deleted", deleted_projects_path, class: "tab-link" %>
    <% end %>
  </nav>

  <% if @projects.any? %>
    <ul class="mt-7 border-t border-border">
      <% @projects.each do |project| %>
        <li>
          <%= link_to project_path(project), class: "grid gap-x-5 gap-y-1 border-b border-hairline px-1 py-3.5 hover:bg-ghost-fill sm:grid-cols-[minmax(0,1fr)_11rem_10rem] sm:items-center" do %>
            <div class="min-w-0">
              <h2 class="text-ink"><%= project.name %></h2>
              <% if project.description.present? %>
                <span class="mt-0.5 block text-meta text-ink-2"><%= project.description %></span>
              <% end %>
            </div>
            <span class="text-meta text-ink-2"><%= project.starts_on || project.ends_on ? project_date_range(project.starts_on, project.ends_on) : "No dates yet" %></span>
            <span class="text-meta text-ink-2">Archived <%= project.archived_at.strftime("%b %-d") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-7 text-ink-2">No archived Projects.</p>
  <% end %>
</div>
