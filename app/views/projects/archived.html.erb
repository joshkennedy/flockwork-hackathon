<% content_for :title, "Archived Projects" %>

<div class="w-full max-w-4xl">
  <div>
    <%= link_to "Projects", projects_path, class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
    <h1 class="mt-4 text-ink">Archived Projects</h1>
  </div>

  <nav class="mt-6 flex flex-wrap gap-4 text-meta font-semibold">
    <%= link_to "Active", projects_path, class: "text-ink-2 hover:text-ink" %>
    <%= link_to "Archived", archived_projects_path, class: "text-ink" %>
    <% if Policy.can?(Current.person, :view_deleted, Project) %>
      <%= link_to "Deleted", deleted_projects_path, class: "text-ink-2 hover:text-ink" %>
    <% end %>
  </nav>

  <% if @projects.any? %>
    <div class="mt-7 divide-y divide-hairline border-y border-hairline">
      <% @projects.each do |project| %>
        <%= link_to project_path(project), class: "group block py-6" do %>
          <h2 class="text-ink group-hover:text-ink-2"><%= project.name %></h2>
          <% if project.description.present? %>
            <p class="mt-2 text-ink-2"><%= project.description %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-ink-2">No archived Projects.</p>
  <% end %>
</div>
