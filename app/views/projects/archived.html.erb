<% content_for :title, "Archived Projects" %>

<div class="mx-auto w-full max-w-4xl">
  <div>
    <%= link_to "Projects", projects_path, class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-stone-950">Archived Projects</h1>
  </div>

  <nav class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
    <%= link_to "Active", projects_path, class: "text-stone-600 hover:text-stone-950" %>
    <%= link_to "Archived", archived_projects_path, class: "text-stone-950" %>
    <% if Policy.can?(Current.person, :view_deleted, Project) %>
      <%= link_to "Deleted", deleted_projects_path, class: "text-stone-600 hover:text-stone-950" %>
    <% end %>
  </nav>

  <% if @projects.any? %>
    <div class="mt-10 divide-y divide-stone-300 border-y border-stone-300">
      <% @projects.each do |project| %>
        <%= link_to project_path(project), class: "group block py-6" do %>
          <h2 class="text-xl font-bold text-stone-950 group-hover:text-stone-600"><%= project.name %></h2>
          <% if project.description.present? %>
            <p class="mt-2 text-stone-600"><%= project.description %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-12 text-stone-600">No archived Projects.</p>
  <% end %>
</div>
