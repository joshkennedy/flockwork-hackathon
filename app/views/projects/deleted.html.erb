<% content_for :title, "Deleted Projects" %>

<div class="w-full max-w-5xl">
  <%= page_header "Deleted Projects" %>

  <nav class="mt-5 flex flex-wrap gap-4 text-meta font-semibold" aria-label="Project lists">
    <%= link_to "Active", projects_path, class: "tab-link" %>
    <%= link_to "Archived", archived_projects_path, class: "tab-link" %>
    <%= link_to "Deleted", deleted_projects_path, class: "tab-link", aria: { current: "page" } %>
  </nav>

  <% if @projects.any? %>
    <div class="mt-7 divide-y divide-hairline border-y border-hairline">
      <% @projects.each do |project| %>
        <div class="flex flex-wrap items-center justify-between gap-4 py-6">
          <div>
            <h2 class="text-ink"><%= project.name %></h2>
            <% if project.description.present? %>
              <p class="mt-2 text-ink-2"><%= project.description %></p>
            <% end %>
          </div>
          <%= button_to "Restore", restore_project_path(project), class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-ink-2">No deleted Projects.</p>
  <% end %>
</div>
