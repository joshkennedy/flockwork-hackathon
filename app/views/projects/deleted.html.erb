<%= turbo_stream_from Current.organization, :dashboard %>
<% content_for :title, "Deleted Projects" %>

<div class="w-full">
  <%= page_header "Deleted Projects" %>

  <nav class="mt-5 tab-bar" aria-label="Project lists">
    <%= link_to "Active", projects_path, class: "tab-link" %>
    <%= link_to "Archived", archived_projects_path, class: "tab-link" %>
    <%= link_to "Deleted", deleted_projects_path, class: "tab-link", aria: { current: "page" } %>
  </nav>

  <% if @projects.any? %>
    <ul class="mt-7 border-t border-border">
      <% @projects.each do |project| %>
        <li class="grid gap-x-5 gap-y-2 border-b border-hairline px-1 py-3.5 sm:grid-cols-[minmax(0,1fr)_10rem_auto] sm:items-center">
          <div class="min-w-0">
            <h2 class="text-ink"><%= project.name %></h2>
            <% if project.description.present? %>
              <p class="mt-0.5 text-meta text-ink-2"><%= project.description %></p>
            <% end %>
          </div>
          <span class="text-meta text-ink-2">Deleted <%= project.deleted_at.strftime("%b %-d") %></span>
          <%= button_to "Restore", restore_project_path(project), class: "btn btn-secondary btn-sm" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-7 text-ink-2">No deleted Projects.</p>
  <% end %>
</div>
