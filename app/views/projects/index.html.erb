<%= turbo_stream_from Current.organization, :dashboard %>
<% content_for :title, "Projects" %>

<div class="w-full">
  <%= page_header "Projects" do %>
    <%= link_to "Start a Project", new_project_path, class: "btn btn-primary" if Policy.can?(Current.person, :create, Project) %>
  <% end %>

  <nav class="mt-5 tab-bar" aria-label="Project lists">
    <%= link_to "Active", projects_path, class: "tab-link", aria: { current: "page" } %>
    <%= link_to "Archived", archived_projects_path, class: "tab-link" %>
    <% if Policy.can?(Current.person, :view_deleted, Project) %>
      <%= link_to "Deleted", deleted_projects_path, class: "tab-link" %>
    <% end %>
  </nav>

  <% if @projects.any? %>
    <% today = Date.current %>
    <% groups = @projects.group_by do |project|
         if project.done_at.present? then "Done"
         elsif project.starts_on.nil? && project.ends_on.nil? then "No dates yet"
         elsif (project.starts_on || project.ends_on) > today then "Coming up"
         elsif (project.ends_on || project.starts_on) < today then "Ended"
         else "Happening now"
         end
       end %>
    <% [ "Happening now", "Coming up", "No dates yet", "Ended", "Done" ].each do |group| %>
      <% next unless groups[group] %>
      <section class="mt-7" aria-labelledby="group-<%= group.parameterize %>">
        <h2 id="group-<%= group.parameterize %>" class="border-b border-border pb-2 text-label text-ink-2"><%= group %></h2>
        <ul>
          <% groups[group].sort_by { |project| date = project.starts_on || project.ends_on; [ date ? 0 : 1, date || today, project.name ] }.each do |project| %>
            <% guidance = project_guidance(project, Current.person) %>
            <li>
              <%= link_to project_path(project), class: class_names("grid items-center gap-x-4 gap-y-1 border-b border-hairline px-1 py-3 hover:bg-ghost-fill", project.banner_ready? ? "grid-cols-[auto_minmax(0,1fr)] sm:grid-cols-[auto_minmax(0,1fr)_11rem_14rem]" : "sm:grid-cols-[minmax(0,1fr)_11rem_14rem]") do %>
                <%= render "projects/thumbnail", project: project %>
                <div class="min-w-0">
                  <h3 class="<%= project.done_at ? "text-ink-2" : "text-ink" %>"><%= project.name %></h3>
                  <% if project.description.present? && !project.done_at %>
                    <span class="mt-0.5 block text-meta text-ink-2"><%= project.description %></span>
                  <% end %>
                </div>
                <span class="<%= class_names("text-meta text-ink-2", "max-sm:col-start-2": project.banner_ready?) %>"><%= project.starts_on || project.ends_on ? project_date_range(project.starts_on, project.ends_on) : "No dates yet" %></span>
                <span class="<%= class_names("max-sm:col-start-2": project.banner_ready?) %>">
                  <%# Done rows sit under the Done heading, so they carry no status of their own. %>
                  <% if project.done_at %>
                  <% elsif guidance %>
                    <span class="badge-need"><%= guidance[:title] %></span>
                  <% else %>
                    <span class="text-meta text-ink-2"><%= project_planned?(project) ? "On track" : "Nothing planned yet" %></span>
                  <% end %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <p class="mt-7 text-ink-2">No Projects yet.</p>
  <% end %>
</div>
