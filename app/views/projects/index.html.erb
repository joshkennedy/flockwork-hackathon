<% content_for :title, "Projects" %>

<div class="w-full max-w-4xl">
  <div class="flex items-end justify-between gap-5">
    <div>
      <%= link_to Current.workspace.name, workspace_path(Current.workspace), class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
      <h1 class="mt-4 text-ink">Projects</h1>
    </div>
    <%= link_to "Start a Project", new_project_path, class: "btn btn-primary" %>
  </div>

  <nav class="mt-6 flex flex-wrap gap-4 text-meta font-semibold" aria-label="Project lists">
    <%= link_to "Active", projects_path, class: "tab-link", aria: { current: "page" } %>
    <%= link_to "Archived", archived_projects_path, class: "tab-link" %>
    <% if Policy.can?(Current.person, :view_deleted, Project) %>
      <%= link_to "Deleted", deleted_projects_path, class: "tab-link" %>
    <% end %>
  </nav>

  <% if @projects.any? %>
    <div class="mt-7 divide-y divide-hairline border-y border-hairline">
      <% @projects.each do |project| %>
        <%= link_to project_path(project), class: "group block py-6" do %>
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-ink group-hover:text-ink-2"><%= project.name %></h2>
            <% if project.done_at.present? %>
              <span class="rounded-badge bg-frame px-2 py-0.5 text-label font-semibold text-ink">Done</span>
            <% end %>
          </div>
          <% if project.description.present? %>
            <p class="mt-2 text-ink-2"><%= project.description %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-ink-2">No Projects yet.</p>
  <% end %>
</div>
