<% content_for :title, "Start a Project" %>

<div class="w-full max-w-5xl">
  <%= page_header "Start a Project" %>

  <% if @manual_project %>
    <p class="mt-2 max-w-2xl text-ink-2">Set up the Project yourself. You can add or change its Tools later.</p>
    <div class="mt-7 max-w-2xl"><%= render "form", project: @project %></div>
  <% elsif @custom_planning %>
    <section class="mt-7 max-w-2xl" aria-labelledby="custom-project-heading">
      <h2 id="custom-project-heading" class="text-ink">What are you organizing?</h2>
      <p class="mt-2 text-ink-2">Give the Planner one short sentence. Its first question will build on what you share.</p>

      <%= form_with url: start_planner_projects_path, method: :post, class: "mt-6 space-y-6" do |form| %>
        <%= form.hidden_field :planning_kind, value: "other" %>
        <% if @description_error %>
          <p role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger"><%= @description_error %></p>
        <% end %>
        <div>
          <%= form.label :description, "Describe it in one sentence", class: "block text-label font-medium text-ink" %>
          <%= form.text_field :description, name: "planner_session[description]", value: params.dig(:planner_session, :description), required: true, maxlength: 280, autofocus: true, class: "mt-2 block w-full field", placeholder: "Organize a spring cleanup." %>
        </div>
        <%= form.submit "Start Planning", class: "btn btn-primary", data: { turbo_submits_with: "Creating Project…" } %>
      <% end %>

      <%= render "planner_sessions/privacy" %>
    </section>
  <% else %>
    <section class="project-kind-section mt-7" aria-labelledby="project-kind-heading">
      <div class="project-kind-intro">
        <h2 id="project-kind-heading" class="text-ink">What are you organizing?</h2>
        <p class="mt-2 text-ink-2 sm:col-span-2 sm:row-start-2">Pick one and the Planner will ask a few questions and draft the plan with you.</p>
      </div>
      <div class="project-kind-grid mt-5">
        <% [
          [ "Meal Train", "Line up meals for a family who needs them.", :heart, "text-tool-signup", start_meal_planner_projects_path, :post, {}, %w[signup_sheet messages] ],
          [ "Retreat", "Plan the days, the place and what to bring.", :schedule, "text-tool-schedule", start_planner_projects_path, :post, { planning_kind: "retreat" }, %w[schedule budget list] ],
          [ "Workday", "Rally hands for a day of shared work.", :tasks, "text-tool-tasks", start_planner_projects_path, :post, { planning_kind: "workday" }, %w[tasks signup_sheet list] ],
          [ "Children’s Program", "Plan the dates, helpers and supplies for kids.", :people, "text-tool-list", start_planner_projects_path, :post, { planning_kind: "children_program" }, %w[schedule signup_sheet list] ],
          [ "Class", "Plan each session, its teacher and materials.", :docs, "text-tool-docs", start_planner_projects_path, :post, { planning_kind: "class" }, %w[schedule signup_sheet docs] ],
          [ "Something Else", "Describe it in one sentence and we'll shape it.", :plus, "text-ink-2", new_project_path, :get, { planning_kind: "other" }, [] ]
        ].each do |title, description, glyph, color, path, method, parameters, tools| %>
          <%= button_to path, method:, params: parameters, class: class_names("project-kind-tile", "project-kind-ghost": tools.empty?), data: ({ turbo_submits_with: "Creating Project…" } unless method == :get) do %>
            <span class="project-kind-title flex items-center gap-2 text-ink"><%= icon(glyph, size: 24, class: color) %><%= title %></span>
            <span class="mt-1 block text-meta text-ink-2"><%= description %></span>
            <% if tools.any? %>
              <span class="mt-2 block text-meta text-ink-2"><%= {
                "Meal Train" => "Like two weeks of dinners after a new baby",
                "Retreat" => "Like a weekend away for 40 at a camp",
                "Workday" => "Like a Saturday fixing up the playground",
                "Children’s Program" => "Like a week of VBS mornings",
                "Class" => "Like a six-week Bible study with a meal"
              }.fetch(title) %></span>
              <span class="mt-3 flex flex-wrap items-center gap-x-1 gap-y-1 text-meta text-ink-2">
                <% tools.each_with_index do |tool, index| %>
                  <% if index.positive? %><span aria-hidden="true">·</span><% end %>
                  <span class="inline-flex items-center gap-1"><%= planner_tool_icon(tool, size: 14) %><%= { "list" => "Lists", "docs" => "Docs" }.fetch(tool) { planner_tool_label(tool) } %></span>
                <% end %>
              </span>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%= link_to "Build It Myself", new_project_path(manual: true), class: "project-kind-manual btn btn-secondary btn-sm", title: "Set up the Project and its Tools yourself, with the same fields." %>
    </section>
  <% end %>
</div>
