<% content_for :title, "Start a Project" %>
<% if @manual_project %>
  <% content_for :breadcrumbs do %>
    <%= link_to "Start a Project", new_project_path, class: "shrink-0 whitespace-nowrap hover:text-ink" %>
    <span aria-hidden="true" class="shrink-0 text-ink-3">/</span>
    <span class="truncate text-ink" aria-current="page">Build It Myself</span>
  <% end %>
<% end %>

<div class="<%= @manual_project ? "w-full max-w-5xl" : "meal-builder" %>">
  <%= page_header "Start a Project" %>

  <% if @manual_project %>
    <p class="mt-2 max-w-2xl text-ink-2">Set up the Project yourself. You can add or change its Tools later.</p>
    <div class="mt-7 max-w-2xl"><%= render "form", project: @project %></div>
  <% else %>
    <% steps = [
      { title: "What are you organizing?", state: :open },
      { title: "Answer a few questions.", state: :upcoming },
      { title: "Review and add.", state: :upcoming }
    ] %>
    <div class="mt-7">
      <%= render layout: "shared/setup_steps", locals: { steps: } do %>
        <div class="project-kind-list">
          <% [
            [ "Meal Train", :heart, "text-tool-signup", start_meal_planner_projects_path, {} ],
            [ "Retreat", :schedule, "text-tool-schedule", start_planner_projects_path, { planning_kind: "retreat" } ],
            [ "Workday", :tasks, "text-tool-tasks", start_planner_projects_path, { planning_kind: "workday" } ],
            [ "Children’s Program", :people, "text-tool-list", start_planner_projects_path, { planning_kind: "children_program" } ],
            [ "Class", :docs, "text-tool-docs", start_planner_projects_path, { planning_kind: "class" } ]
          ].each do |title, glyph, color, path, parameters| %>
            <%= button_to path, method: :post, params: parameters, class: "project-kind-row", data: { turbo_submits_with: "Creating Project…" } do %>
              <%= icon(glyph, size: 20, class: color) %>
              <span><%= title %></span>
            <% end %>
          <% end %>
          <details class="project-kind-other" <%= "open" if @custom_planning || @description_error %>>
            <summary class="project-kind-row"><%= icon(:plus, size: 20, class: "text-ink-2") %><span>Something Else</span></summary>
            <%= form_with url: start_planner_projects_path, method: :post, class: "space-y-3 py-3" do |form| %>
              <%= form.hidden_field :planning_kind, value: "other" %>
              <% description_error_id = form.field_id(:description, :error) if @description_error %>
              <%= form.label :description, "Describe it in a sentence", class: "block text-label font-medium text-ink" %>
              <%= form.text_field :description, name: "planner_session[description]", value: params.dig(:planner_session, :description), required: true, maxlength: 280, class: "block w-full field", placeholder: "Organize a spring cleanup.",
                aria: { invalid: @description_error.present?, describedby: description_error_id } %>
              <% if @description_error %>
                <p id="<%= description_error_id %>" role="alert" class="text-meta text-danger"><%= @description_error %></p>
              <% end %>
              <%= form.submit "Start", class: "btn btn-primary", data: { turbo_submits_with: "Creating Project…" } %>
            <% end %>
          </details>
        </div>
        <%= link_to "Or set it up yourself", new_project_path(manual: true), class: "mt-5 inline-flex min-h-11 items-center link text-meta text-ink-2" %>
      <% end %>
    </div>
  <% end %>
</div>
