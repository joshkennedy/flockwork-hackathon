<% content_for :title, "Start a Project" %>

<div class="w-full max-w-4xl">
  <%= link_to "Projects", projects_path, class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
  <h1 class="mt-5 text-ink">Start a Project</h1>

  <% if @manual_project %>
    <p class="mt-3 max-w-2xl text-ink-2">Set up the Project yourself. You can add or change its Tools later.</p>
    <div class="mt-7 max-w-2xl"><%= render "form", project: @project %></div>
  <% else %>
    <section class="mt-7" aria-labelledby="project-kind-heading">
      <h2 id="project-kind-heading" class="text-ink">What are we organizing?</h2>
      <p class="mt-2 text-meta text-ink-2">Choose a starting point. The Planner will shape the next choices around your work.</p>

      <div class="mt-5 max-w-xl">
        <%= button_to start_meal_planner_projects_path, method: :post, class: "project-kind-tile", data: { turbo_submits_with: "Creating Project…" } do %>
          <span class="font-semibold text-ink">Meal train</span>
          <span class="mt-1 block text-meta text-ink-2">Build a dated sign-up sheet for meals.</span>
        <% end %>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-meta font-semibold">
        <%= link_to "Something else", new_project_path(manual: true), class: "btn btn-secondary" %>
        <span class="font-normal text-ink-2">Retreats, workdays, children’s programs, and any other Project continue with manual setup.</span>
      </div>
    </section>
  <% end %>
</div>
