<% content_for :title, @project.name %>

<div class="w-full max-w-5xl" data-controller="<%= 'project-arrival' if @completed_planner_session %>" data-action="turbo:load@document->project-arrival#scheduleArrival" data-project-arrival-target-id-value="tool-<%= (@completed_planner_session&.acceptance_tool || 'signup_sheet').tr('_', '-') %>">
  <% if flash[:notice].present? %>
    <p role="status" class="flash-notice mb-5 rounded-control bg-sunlit-soft px-4 py-3 text-ink"><%= flash[:notice] %></p>
  <% end %>

  <header class="max-w-4xl">
    <h1 class="text-ink"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="mt-5 text-body-phone sm:text-body leading-normal text-ink-2"><%= @project.description %></p>
    <% end %>
    <% if @project.starts_on.present? || @project.ends_on.present? %>
      <p class="mt-5 text-meta font-medium text-ink-2">
        <%= [ @project.starts_on&.to_fs(:long), @project.ends_on&.to_fs(:long) ].compact.join(" to ") %>
      </p>
    <% end %>
    <% if @project.done_at.present? %>
      <p class="mt-3 text-meta font-semibold text-ink-2">Done</p>
    <% end %>
  </header>

  <nav class="mt-5 flex flex-wrap items-center gap-4" aria-label="Project navigation">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <% if Policy.can?(Current.person, :plan, @project) %>
        <% if @resumable_planner_session.present? %>
          <%= link_to "Continue planning", project_planner_session_path(@project, @resumable_planner_session), class: "btn btn-primary" %>
        <% else %>
          <%= link_to "Plan more", new_project_planner_session_path(@project), class: "btn btn-primary" %>
        <% end %>
      <% end %>
      <% if Policy.can?(Current.person, :view_team, @project) %>
        <%= link_to "View Team", team_project_path(@project), class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
      <% elsif Policy.can?(Current.person, :join, @project) %>
        <%= button_to "Join", join_project_path(@project), class: "btn btn-primary" %>
      <% end %>
      <% if Policy.can?(Current.person, :update, @project) %>
        <%= link_to "Edit Project", edit_project_path(@project), class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
      <% end %>
      <% lifecycle_access = Policy.member?(Current.person, @project) || Current.person.admin? %>
      <% lifecycle_actions = lifecycle_access ? %i[mark_done reopen archive unarchive destroy].select { |action| Policy.can?(Current.person, action, @project) } : [] %>
      <% can_duplicate = Policy.can?(Current.person, :duplicate, @project) %>
      <% if can_duplicate || lifecycle_actions.any? %>
        <details class="relative" data-project-more>
          <summary class="btn btn-text list-none [&::-webkit-details-marker]:hidden">More</summary>
          <div class="popover-in absolute left-0 top-full z-30 mt-1 flex w-56 flex-col rounded-panel border border-border bg-panel p-2 shadow-float">
            <% if can_duplicate %>
              <%= link_to "Duplicate", new_project_duplicate_path(@project), class: "btn btn-text w-full justify-start" %>
            <% end %>
            <% { mark_done: [ "Mark done", mark_done_project_path(@project) ],
                 reopen: [ "Reopen", reopen_project_path(@project) ],
                 archive: [ "Archive", archive_project_path(@project) ],
                 unarchive: [ "Unarchive", unarchive_project_path(@project) ] }.slice(*lifecycle_actions).each_value do |label, path| %>
              <%= button_to label, path, class: "btn btn-text w-full justify-start" %>
            <% end %>
            <% if lifecycle_actions.include?(:destroy) %>
              <%= button_to "Delete", project_path(@project), method: :delete, class: "btn btn-danger w-full justify-start" %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </nav>

  <% can_share = Policy.can?(Current.person, :manage_public_link, @project) %>
  <% can_transfer = lifecycle_access && Policy.can?(Current.person, :transfer_ownership, @project) && @ownership_transfer_leaders.any? %>
  <% if can_share || can_transfer %>
    <%# Stays open while the Public link is on so the URL is in view. %>
    <details class="mt-5 border-t border-hairline pt-3" data-project-settings <%= "open" if @project.public_token.present? %>>
      <summary class="cursor-pointer py-2 text-meta font-semibold text-ink-2 hover:text-ink">
        Sharing and ownership<%= " · Public link on" if @project.public_token.present? %>
      </summary>
      <%= render "public_link", project: @project if can_share %>
      <% if can_transfer %>
        <%= form_with url: transfer_ownership_project_path(@project), method: :patch, class: "mt-5 flex flex-wrap items-end gap-3" do |form| %>
          <%= form.label :new_owner_id, "Transfer ownership to", class: "block text-label font-medium text-ink" %>
          <%= form.collection_select :new_owner_id, @ownership_transfer_leaders, :person_id, ->(membership) { membership.person.name }, { prompt: "Choose a Leader" }, class: "field" %>
          <%= form.submit "Transfer", class: "btn btn-secondary" %>
        <% end %>
      <% end %>
    </details>
  <% end %>

  <% if @project.enabled_tools.any? %>
    <div class="mt-7 space-y-7">
      <% @project.enabled_tools.each do |tool| %>
        <% next if tool == "recipients" && !Policy.can?(Current.person, :view_recipients, @project) %>
        <% if lookup_context.exists?(tool, ["projects/tools"], true) %>
          <%= render "projects/tools/#{tool}", project: @project %>
        <% else %>
          <section class="tool-section" aria-labelledby="tool-<%= tool %>">
            <h2 id="tool-<%= tool %>" class="text-xl font-semibold text-ink"><%= Project::TOOL_LABELS.fetch(tool) %></h2>
            <p class="mt-7 text-meta text-ink-2">Nothing here yet</p>
          </section>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if Policy.can?(Current.person, :view_notes, @project) %>
    <section class="tool-section mt-7" aria-labelledby="project-notes-heading">
      <h2 id="project-notes-heading" class="text-ink">Notes</h2>
      <%= render "notes/list", notes: @project_notes %>
      <%= render "notes/form",
        notable: @project,
        visibilities: @note_visibilities,
        form_url: project_notes_path(@project) %>
    </section>
  <% end %>
</div>
