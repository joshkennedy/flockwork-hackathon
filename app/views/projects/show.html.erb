<% content_for :title, @project.name %>

<div class="mx-auto w-full max-w-5xl">
  <nav class="flex items-center justify-between gap-4" aria-label="Project navigation">
    <%= link_to "Projects", projects_path, class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>
    <% if Policy.can?(Current.person, :update, @project) %>
      <%= link_to "Edit Project", edit_project_path(@project), class: "text-sm font-semibold text-stone-700 hover:text-stone-950" %>
    <% end %>
  </nav>

  <header class="mt-10 max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight text-stone-950 sm:text-5xl"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="mt-5 text-lg leading-8 text-stone-700"><%= @project.description %></p>
    <% end %>
    <% if @project.starts_on.present? || @project.ends_on.present? %>
      <p class="mt-5 text-sm font-medium text-stone-600">
        <%= [ @project.starts_on&.to_fs(:long), @project.ends_on&.to_fs(:long) ].compact.join(" to ") %>
      </p>
    <% end %>
  </header>

  <% if @project.enabled_tools.any? %>
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <% @project.enabled_tools.each do |tool| %>
        <% if tool == "schedule" %>
          <%= render "tool_schedule", project: @project, schedule_items_by_day: @schedule_items_by_day %>
        <% else %>
        <section class="min-h-44 bg-[#e7ede3] p-6" aria-labelledby="tool-<%= tool %>">
          <h2 id="tool-<%= tool %>" class="text-xl font-bold text-stone-950"><%= Project::TOOL_LABELS.fetch(tool) %></h2>
          <p class="mt-8 text-sm text-stone-600">Nothing here yet</p>
        </section>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
