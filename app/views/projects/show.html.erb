<% content_for :title, @project.name %>

<div class="mx-auto w-full max-w-5xl">
  <nav class="flex items-center justify-between gap-4" aria-label="Project navigation">
    <%= link_to "Projects", projects_path, class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>
    <% if Policy.can?(Current.person, :update, @project) %>
      <%= link_to "Edit Project", edit_project_path(@project), class: "text-sm font-semibold text-stone-700 hover:text-stone-950" %>
    <% end %>
  </nav>

  <header class="mt-10 max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight text-stone-950 sm:text-5xl"><%= @project.name %></h1>
    <% if @project.description.present? %>
      <p class="mt-5 text-lg leading-8 text-stone-700"><%= @project.description %></p>
    <% end %>
    <% if @project.starts_on.present? || @project.ends_on.present? %>
      <p class="mt-5 text-sm font-medium text-stone-600">
        <%= [ @project.starts_on&.to_fs(:long), @project.ends_on&.to_fs(:long) ].compact.join(" to ") %>
      </p>
    <% end %>
    <% if @project.done_at.present? %>
      <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-stone-600">Done</p>
    <% end %>
  </header>

  <div class="mt-8 flex flex-wrap gap-3">
    <% if Policy.can?(Current.person, :mark_done, @project) %>
      <%= button_to "Mark done", mark_done_project_path(@project), class: "border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>
    <% end %>
    <% if Policy.can?(Current.person, :reopen, @project) %>
      <%= button_to "Reopen", reopen_project_path(@project), class: "border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>
    <% end %>
    <% if Policy.can?(Current.person, :archive, @project) %>
      <%= button_to "Archive", archive_project_path(@project), class: "border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>
    <% end %>
    <% if Policy.can?(Current.person, :unarchive, @project) %>
      <%= button_to "Unarchive", unarchive_project_path(@project), class: "border border-stone-400 px-4 py-2 text-sm font-semibold text-stone-800 hover:bg-stone-100" %>
    <% end %>
    <% if Policy.can?(Current.person, :destroy, @project) %>
      <%= button_to "Delete", project_path(@project), method: :delete, class: "border border-red-300 px-4 py-2 text-sm font-semibold text-red-800 hover:bg-red-50" %>
    <% end %>
  </div>

  <% if Policy.can?(Current.person, :transfer_ownership, @project) && @ownership_transfer_leaders.any? %>
    <%= form_with url: transfer_ownership_project_path(@project), method: :patch, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
      <%= form.label :new_owner_id, "Transfer ownership to", class: "block text-sm font-semibold text-stone-800" %>
      <%= form.collection_select :new_owner_id, @ownership_transfer_leaders, :person_id, ->(membership) { membership.person.name }, { prompt: "Choose a Leader" }, class: "border border-stone-400 px-3 py-2 text-sm" %>
      <%= form.submit "Transfer", class: "bg-[#1f291f] px-4 py-2 text-sm font-semibold text-white hover:bg-[#354235]" %>
    <% end %>
  <% end %>

  <% if @project.enabled_tools.any? %>
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <% @project.enabled_tools.each do |tool| %>
        <% if tool == "schedule" %>
          <%= render "tool_schedule", project: @project, schedule_items_by_day: @schedule_items_by_day %>
        <% else %>
        <section class="min-h-44 bg-[#e7ede3] p-6" aria-labelledby="tool-<%= tool %>">
          <h2 id="tool-<%= tool %>" class="text-xl font-bold text-stone-950"><%= Project::TOOL_LABELS.fetch(tool) %></h2>
          <p class="mt-8 text-sm text-stone-600">Nothing here yet</p>
        </section>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
