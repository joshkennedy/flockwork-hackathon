<% content_for :title, @project.name %>
<%# Any change to this Project or its Tools refreshes (morphs) the page for everyone viewing it. %>
<%= turbo_stream_from @project %>
<% can_plan = Policy.can?(Current.person, :plan, @project) %>
<% can_join = !Policy.can?(Current.person, :view_team, @project) && Policy.can?(Current.person, :join, @project) %>
<% can_share = Policy.can?(Current.person, :manage_public_link, @project) %>
<% lifecycle_access = Policy.member?(Current.person, @project) || Current.person.admin? %>
<% lifecycle_actions = lifecycle_access ? %i[mark_done reopen archive unarchive destroy].select { |action| Policy.can?(Current.person, action, @project) } : [] %>
<% can_duplicate = Policy.can?(Current.person, :duplicate, @project) %>
<% can_update = Policy.can?(Current.person, :update, @project) %>
<% can_transfer = lifecycle_access && Policy.can?(Current.person, :transfer_ownership, @project) && @ownership_transfer_leaders.any? %>
<% can_unarchive = Policy.can?(Current.person, :unarchive, @project) %>
<%# An archived Project is read-only, so it has no open need to point at. %>
<% guidance = project_guidance(@project, Current.person) unless @project.archived_at? %>
<% claim_slot = guidance&.dig(:slot) if Policy.can?(Current.person, :claim_slot, @project) %>
<%# Exactly one ink button per view: a header action that must come first (resume, join) wins; then the guidance action; else Plan More. %>
<% header_primary = @resumable_planner_session.present? || can_join %>
<% guidance_action = guidance && ((guidance[:kind] == :spots && (can_share || claim_slot)) || guidance[:kind] == :tasks) %>
<% guidance_primary = guidance_action && !header_primary && guidance[:kind] == :spots %>
<%# When the guidance strip offers Turn On Public Link, the Sharing panel shows the link's state instead of a second button. %>
<% public_link_in_strip = guidance_action && guidance[:kind] == :spots && can_share && @project.public_token.blank? %>
<% tabs = project_tabs(@project) %>
<% tabs << "notes" if Policy.can?(Current.person, :view_notes, @project) %>
<% tabs << "team" if Policy.can?(Current.person, :view_team, @project) %>
<% default_tab = @selected_tab || (tabs & [ @completed_planner_session&.acceptance_tool ]).first || tabs.first %>
<% show_recipients = @project.enabled_tools.include?("recipients") && Policy.can?(Current.person, :view_recipients, @project) %>

<div class="w-full" data-controller="tabs<%= ' project-arrival' if @completed_planner_session %>"<%= " data-tabs-explicit-value" if @selected_tab %> data-action="turbo:load@document->project-arrival#scheduleArrival" data-project-arrival-target-id-value="tool-<%= (@completed_planner_session&.acceptance_tool || 'signup_sheet').tr('_', '-') %>">
  <%= render "projects/banner", project: @project, editable: can_update %>

  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 max-w-4xl">
      <div class="flex min-w-0 flex-wrap items-baseline gap-x-3 gap-y-1">
        <h1 class="min-w-0 text-ink"><%= @project.name %></h1>
      </div>
      <% if @project.description.present? %>
        <p class="mt-2 text-ink-2"><%= @project.description %></p>
      <% end %>
      <% if @project.done_at.present? %>
        <p class="mt-3"><span class="rounded-badge bg-frame px-2 py-1 text-label text-ink-2">Done</span></p>
      <% end %>
    </div>

    <nav class="flex shrink-0 flex-wrap items-center gap-2" aria-label="Project actions">
      <% if can_plan %>
        <% if @resumable_planner_session.present? %>
          <%= link_to @resumable_planner_session.meal_setup? ? "Finish Meal Setup" : "Continue Planning", project_planner_session_path(@project, @resumable_planner_session), class: "btn btn-primary" %>
        <% else %>
          <%= link_to "Plan More", new_project_planner_session_path(@project), class: "btn #{guidance_primary || can_join ? 'btn-secondary' : 'btn-primary'}" %>
        <% end %>
      <% end %>
      <% if can_join %>
        <%= button_to "Join", join_project_path(@project), class: "btn btn-primary" %>
      <% end %>
      <% if can_update || can_duplicate || lifecycle_actions.any? %>
        <%= actions_menu("More project actions") do %>
          <%= link_to "Rename", edit_project_path(@project) if can_update %>
          <%= link_to "Edit Project", edit_project_path(@project) if can_update %>
          <%= link_to "Duplicate", new_project_duplicate_path(@project) if can_duplicate %>
          <%= render "projects/recurrence_action", project: @project %>
          <%= render "projects/debrief_action", project: @project %>
          <% { mark_done: [ "Mark Done", mark_done_project_path(@project) ],
               reopen: [ "Reopen", reopen_project_path(@project) ],
               archive: [ "Archive", archive_project_path(@project) ],
               unarchive: [ "Unarchive", unarchive_project_path(@project) ] }.slice(*lifecycle_actions).each_value do |label, path| %>
            <%= button_to label, path %>
          <% end %>
          <% if lifecycle_actions.include?(:destroy) %>
            <hr>
            <%= button_to "Delete Project", project_path(@project), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Delete #{@project.name}? It moves to Deleted Projects, where it can be restored." } } %>
          <% end %>
        <% end %>
      <% end %>
    </nav>
  </header>

  <% if @project.archived_at? %>
    <div class="mt-6 flex flex-col gap-3 rounded-tile border border-border bg-frame px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between" data-archived-notice>
      <p class="text-ink">This Project is archived and read-only.<% if can_unarchive %> Unarchive it to make changes.<% end %></p>
      <% if can_unarchive %>
        <%= button_to "Unarchive to edit", unarchive_project_path(@project), class: "btn btn-secondary shrink-0" %>
      <% end %>
    </div>
  <% end %>

  <% status_items = project_status_items(@project) %>
  <% if status_items.any? || Policy.can?(Current.person, :view_team, @project) %>
    <dl class="status-strip mt-6">
      <% status_items.each do |label, value| %>
        <div><dt><%= label %></dt><dd><%= value %></dd></div>
      <% end %>
      <% if Policy.can?(Current.person, :view_team, @project) %>
        <div class="status-strip-linked"><dt>Team<%= link_to "", team_project_path(@project), class: "status-strip-link", aria: { label: "Team, #{pluralize(@project.memberships.size, "person")}" } %></dt><dd><%= pluralize(@project.memberships.size, "person") %></dd></div>
      <% end %>
    </dl>
  <% end %>

  <%= render "projects/risk", project: @project if can_plan && !guidance %>

  <% if guidance %>
    <div class="guidance-strip mt-3" data-project-guidance>
      <div>
        <p class="font-semibold"><%= guidance[:title] %></p>
        <% if guidance[:detail] %>
          <p class="text-meta text-ink-2"><%= guidance[:detail] %><%= " A public link shows open spots to anyone you send it to." if public_link_in_strip %></p>
        <% end %>
        <%= render "projects/risk", project: @project, inline: true if can_plan %>
      </div>
      <% if guidance_action %>
        <% button_class = "btn #{guidance_primary ? 'btn-primary' : 'btn-secondary'} shrink-0" %>
        <% if guidance[:kind] == :tasks %>
          <%= link_to "See Tasks", "#tab-tasks", class: "btn btn-secondary shrink-0", data: { action: "tabs#select", tabs_name: "tasks" } if tabs.include?("tasks") %>
        <% elsif can_share && @project.public_token.present? %>
          <button type="button" class="<%= button_class %>" data-controller="clipboard" data-clipboard-text-value="<%= public_project_url(@project.public_token) %>" data-action="clipboard#copy">Copy Public Link</button>
        <% elsif can_share %>
          <%= button_to "Turn On Public Link", enable_public_link_project_path(@project), class: button_class %>
        <% elsif claim_slot %>
          <%= button_to (claim_slot.label.downcase == "dinner" ? "I Can Bring Dinner" : "I Can Help"), project_slot_claim_path(@project, claim_slot), class: button_class, aria: { label: "Claim: #{claim_slot.label}, #{claim_slot.date.strftime("%A, %B %-d")}" } %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div>
    <% if tabs.any? %>
      <%= render "projects/section_tabs", project: @project, tabs: tabs, current: default_tab %>
    <% end %>

    <div class="mt-6 grid gap-7 <%= 'lg:grid-cols-[minmax(0,1fr)_320px]' if show_recipients || can_share || can_transfer %>">
      <div class="min-w-0">
        <% tabs.each do |tab| %>
          <div id="tab-<%= tab %>" class="tab-panel" data-tabs-target="panel" data-tabs-name="<%= tab %>" <%= "hidden" unless tab == default_tab %>>
            <% if tab == "team" %>
              <%# Two columns of its own would squeeze beside the page aside, so stack them when there is one. %>
              <%= render template: "projects/team", locals: { split: !(show_recipients || can_share || can_transfer) } %>
            <% elsif tab == "notes" %>
              <section class="tool-section" aria-labelledby="project-notes-heading">
                <h2 id="project-notes-heading" class="text-ink">Notes</h2>
                <%= render "notes/list", notes: @project_notes %>
                <% if @note_visibilities.any? %>
                  <%= render "notes/form",
                    notable: @project,
                    visibilities: @note_visibilities,
                    form_url: project_notes_path(@project) %>
                <% end %>
              </section>
            <% elsif lookup_context.exists?(tab, ["projects/tools"], true) %>
              <%= render "projects/tools/#{tab}", project: @project %>
            <% else %>
              <section class="tool-section" aria-labelledby="tool-<%= tab %>">
                <h2 id="tool-<%= tab %>" class="text-ink"><%= Project::TOOL_LABELS.fetch(tab) %></h2>
                <p class="mt-5 text-meta text-ink-2">Nothing here yet</p>
              </section>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if show_recipients || can_share || can_transfer %>
        <aside class="project-aside flex min-w-0 flex-col gap-5" aria-label="About this Project">
          <%= render "projects/tools/recipients", project: @project if show_recipients %>

          <% if can_share || can_transfer %>
            <section class="rounded-panel border border-border p-4" data-project-settings aria-labelledby="sharing-heading">
              <h2 id="sharing-heading" class="text-heading text-ink">
                Sharing and ownership<span class="font-normal text-ink-2"><%= " · Public link on" if @project.public_token.present? %></span>
              </h2>
              <%= render "public_link", project: @project, offered_above: public_link_in_strip if can_share %>
              <% if can_transfer %>
                <%= form_with url: transfer_ownership_project_path(@project), method: :patch, class: "mt-5 flex flex-wrap items-end gap-3", data: { turbo_confirm: "Transfer ownership of #{@project.name}? You won’t be its owner anymore." } do |form| %>
                  <%= form.label :new_owner_id, "Transfer ownership to", class: "block text-label font-medium text-ink" %>
                  <%= form.collection_select :new_owner_id, @ownership_transfer_leaders, :person_id, ->(membership) { membership.person.name }, { prompt: "Choose a Leader" }, class: "field" %>
                  <%= form.button "Transfer Ownership", class: "btn btn-secondary" %>
                <% end %>
              <% end %>
            </section>
          <% end %>
        </aside>
      <% end %>
    </div>
  </div>
</div>
