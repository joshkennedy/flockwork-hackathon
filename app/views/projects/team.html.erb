<%# The Team tab panel, rendered inside projects/show (the team action renders the project page with this tab selected). %>
<section class="tool-section" aria-label="Team">
  <div class="grid gap-7 <%= "lg:grid-cols-[minmax(0,1fr)_360px]" if @can_manage_team && local_assigns[:split] %>">
    <section class="min-w-0" aria-labelledby="members-heading">
      <h2 id="members-heading" class="text-ink">Members</h2>
      <ul class="mt-3 border-t border-border">
        <% @memberships.each do |membership| %>
          <li class="flex min-h-14 items-center justify-between gap-4 border-b border-hairline px-1 py-2">
            <div class="flex min-w-0 items-center gap-3">
              <%= avatar(membership.person) %>
              <div class="min-w-0">
                <span class="font-semibold text-ink"><%= membership.person.name %></span><%= tag.span(" (you)", class: "text-ink-2") if membership.person_id == Current.person.id %>
                <span class="ml-2 <%= membership.leader? ? "rounded-badge bg-frame px-2 py-0.5 text-label text-ink" : "text-meta text-ink-2" %>"><%= membership.role.humanize %></span>
              </div>
            </div>
            <% if Policy.can?(Current.person, :leave_team, membership) %>
              <%= actions_menu("Actions for #{membership.person.name}") do %>
                <%= button_to "Leave Team", project_membership_path(@project, membership), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Leave #{@project.name}?" } } %>
              <% end %>
            <% elsif Policy.can?(Current.person, :remove_member, membership) %>
              <%= actions_menu("Actions for #{membership.person.name}") do %>
                <%= button_to "Remove from Team", project_membership_path(@project, membership), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Remove #{membership.person.name} from the Team?" } } %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <% if @can_manage_team %>
      <aside class="flex min-w-0 flex-col gap-7" aria-label="Grow the Team">
        <%= render "projects/staffing_suggestions", project: @project, suggestions: @staffing_suggestions %>
        <section class="rounded-panel border border-border p-4" aria-labelledby="directory-heading">
          <h2 id="directory-heading" class="text-ink">Invite from the directory</h2>
          <%= form_with url: team_project_path(@project), method: :get, class: "mt-3", data: { controller: "live-search", turbo_frame: "directory-results", turbo_action: "replace" } do |form| %>
            <%= form.label :query, "Search by name", class: "sr-only" %>
            <%= form.search_field :query, value: params[:query], placeholder: "Search by name", autocomplete: "off", class: "w-full field", data: { action: "input->live-search#search" } %>
          <% end %>

          <%# target _top so Invite forms inside the results still do a full-page submit. %>
          <%= turbo_frame_tag "directory-results", target: "_top" do %>
          <% if @directory_people %>
            <% if @directory_people.any? %>
              <ul class="mt-3 divide-y divide-hairline">
                <% @directory_people.each do |person| %>
                  <li class="grid gap-2 py-3">
                    <div class="flex min-w-0 items-center gap-3">
                      <%= avatar(person) %>
                      <div class="min-w-0">
                        <p class="font-semibold text-ink"><%= person.name %></p>
                      </div>
                    </div>
                    <% if person.email.blank? %>
                      <button type="button" disabled class="btn btn-secondary btn-sm justify-self-start">Invite</button>
                      <p class="text-meta text-ink-2"><%= person.name %> needs an email address before you can invite them.</p>
                    <% else %>
                      <%= render "projects/invite_form", project: @project, person: %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-3 text-meta text-ink-2">No matching People who can be added to this Team.</p>
            <% end %>
          <% end %>
          <% end %>
        </section>

        <section aria-labelledby="invitations-heading">
          <h2 id="invitations-heading" class="text-ink">Invitations</h2>
          <% if @invitations.any? %>
            <ul class="mt-3 border-t border-border">
              <% @invitations.each do |invitation| %>
                <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-hairline py-3">
                  <div class="flex min-w-0 items-center gap-3">
                    <%= avatar(invitation.person) %>
                    <div class="min-w-0">
                      <p class="font-semibold text-ink"><%= invitation.person.name %></p>
                      <p class="text-meta text-ink-2"><%= invitation.role.humanize %> · <%= invitation.status.humanize %></p>
                    </div>
                  </div>
                  <% if invitation.pending? %>
                    <% invitation_link = invitation_url(invitation.generate_token_for(:access)) %>
                    <% sms_body = ERB::Util.url_encode("You're invited to help with #{@project.name} on Flockwork: #{invitation_link}") %>
                    <div class="ml-auto flex flex-wrap justify-end gap-2">
                      <button type="button" data-controller="clipboard" data-clipboard-text-value="<%= invitation_link %>" data-action="clipboard#copy" class="btn btn-secondary btn-sm">Copy Link</button>
                      <%= link_to "Send by Text", "sms:?&body=#{sms_body}", class: "btn btn-secondary btn-sm" %>
                    </div>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-2 text-meta text-ink-2">No Invitations yet.</p>
          <% end %>
        </section>
      </aside>
    <% end %>
  </div>
</section>
