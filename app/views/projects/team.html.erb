<% content_for :title, "#{@project.name} Team" %>

<div class="w-full max-w-5xl">
  <%= page_header "#{@project.name} Team" %>

  <section class="mt-7" aria-labelledby="members-heading">
    <h2 id="members-heading" class="text-ink">Members</h2>
    <ul class="mt-5 divide-y divide-hairline border-y border-hairline">
      <% @memberships.each do |membership| %>
        <li class="flex items-center justify-between gap-4 py-4">
          <div class="min-w-0">
            <span class="font-semibold text-ink"><%= membership.person.name %></span>
            <span class="ml-3 text-meta text-ink-2"><%= membership.role.humanize %></span>
          </div>
          <% if Policy.can?(Current.person, :leave_team, membership) %>
            <%= button_to "Leave Team", project_membership_path(@project, membership), method: :delete, class: "btn btn-text" %>
          <% elsif Policy.can?(Current.person, :remove_member, membership) %>
            <%= button_to "Remove", project_membership_path(@project, membership), method: :delete, class: "btn btn-danger" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @invitations %>
    <section class="mt-7" aria-labelledby="invitations-heading">
      <h2 id="invitations-heading" class="text-ink">Invitations</h2>
      <% if @invitations.any? %>
        <ul class="mt-5 divide-y divide-hairline border-y border-hairline">
          <% @invitations.each do |invitation| %>
            <li class="grid gap-3 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
              <div class="min-w-0">
                <p class="font-semibold text-ink"><%= invitation.person.name %></p>
                <p class="mt-1 text-meta text-ink-2"><%= invitation.role.humanize %> · <%= invitation.status.humanize %></p>
              </div>
              <% if invitation.pending? %>
                <% invitation_token = invitation.generate_token_for(:access) %>
                <% invitation_link = invitation_url(invitation_token) %>
                <% sms_body = ERB::Util.url_encode("You're invited to help with #{@project.name} on Flockwork: #{invitation_link}") %>
                <div class="flex flex-wrap items-center gap-4 text-meta font-semibold">
                  <button type="button" data-controller="clipboard" data-clipboard-text-value="<%= invitation_link %>" data-action="clipboard#copy" class="cursor-pointer text-ink-2 hover:text-ink">Copy link</button>
                  <%= link_to "Send by text", "sms:?&body=#{sms_body}", class: "text-ink-2 hover:text-ink" %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-5 text-ink-2">No Invitations yet.</p>
      <% end %>
    </section>
  <% end %>

  <% if @can_manage_team %>
    <section class="mt-7" aria-labelledby="directory-heading">
      <h2 id="directory-heading" class="text-ink">Invite from the directory</h2>
      <%= form_with url: team_project_path(@project), method: :get, class: "mt-5 flex max-w-xl gap-3" do |form| %>
        <%= form.label :query, "Search by name", class: "sr-only" %>
        <%= form.search_field :query, value: params[:query], placeholder: "Search by name", class: "min-w-0 flex-1 field" %>
        <%= form.submit "Search", class: "btn btn-secondary" %>
      <% end %>

      <% if @directory_people %>
        <ul class="mt-5 divide-y divide-hairline border-y border-hairline">
          <% @directory_people.each do |person| %>
            <li class="grid gap-3 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
              <div class="min-w-0">
                <p class="font-semibold text-ink"><%= person.name %></p>
                <% if person.email.blank? %>
                  <p class="mt-1 text-meta text-ink-2">No email, can't be invited</p>
                <% end %>
              </div>
              <% if person.email.blank? %>
                <button type="button" disabled class="btn btn-text">Invite</button>
              <% else %>
                <%= form_with model: [ @project, Invitation.new ], class: "flex flex-wrap items-center gap-2" do |form| %>
                  <%= form.hidden_field :person_id, value: person.id %>
                  <%= form.label :role, "Role", class: "sr-only" %>
                  <%= form.select :role, Invitation.roles.keys.map { |role| [ role.humanize, role ] }, {}, class: "field" %>
                  <%= form.submit "Invite", class: "btn btn-secondary" %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if @directory_people.empty? %>
          <p class="mt-5 text-ink-2">No matching People who can be added to this Team.</p>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
