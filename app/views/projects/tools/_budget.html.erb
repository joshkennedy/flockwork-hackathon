<% grand_totals = project.budget_grand_totals %>
<% booking_lines = project.budget_lines_by_kind(:booking) %>
<% purchase_lines = project.budget_lines_by_kind(:purchase) %>
<% booking_totals = project.budget_kind_totals(:booking) %>
<% purchase_totals = project.budget_kind_totals(:purchase) %>
<section class="tool-section" aria-labelledby="tool-budget">
  <%= render "projects/tools/planner_arrival", tool: "budget" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-budget" class="text-ink"><%= icon(:budget, class: "text-tool-budget") %> <%= Project::TOOL_LABELS.fetch("budget") %></h2>
    <% if Policy.can?(Current.person, :manage_budget, project) %>
      <div class="flex flex-wrap gap-2">
        <%= link_to new_project_budget_line_path(project, kind: "booking"), class: "btn btn-secondary btn-sm" do %><%= icon(:plus) %>Add booking<% end %>
        <%= link_to new_project_budget_line_path(project, kind: "purchase"), class: "btn btn-secondary btn-sm" do %><%= icon(:plus) %>Add purchase<% end %>
      </div>
    <% end %>
  </div>

  <dl class="mt-6 grid gap-3 sm:grid-cols-2">
    <div>
      <dt class="text-meta font-medium text-ink-2">Estimated total</dt>
      <dd class="tabular-nums text-body-phone sm:text-body font-semibold text-ink"><%= BudgetLine.format_cents(grand_totals[:estimated_cents]) %></dd>
    </div>
    <div>
      <dt class="text-meta font-medium text-ink-2">Actual total</dt>
      <dd class="tabular-nums text-body-phone sm:text-body font-semibold text-ink"><%= BudgetLine.format_cents(grand_totals[:actual_cents]) %></dd>
    </div>
  </dl>

  <%= render "projects/tools/budget_kind_group",
        project: project,
        kind_label: "Bookings",
        lines: booking_lines,
        totals: booking_totals %>

  <%= render "projects/tools/budget_kind_group",
        project: project,
        kind_label: "Purchases",
        lines: purchase_lines,
        totals: purchase_totals %>
</section>
