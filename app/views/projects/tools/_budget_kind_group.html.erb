<div class="mt-7">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-ink-2"><%= kind_label %></h3>
    <p class="text-meta text-ink-2">
      Estimated <%= BudgetLine.format_cents(totals[:estimated_cents]) %>
      · Actual <%= BudgetLine.format_cents(totals[:actual_cents]) %>
    </p>
  </div>

  <% if lines.any? %>
    <ul class="mt-3 space-y-3">
      <% lines.each do |line| %>
        <li class="border-t border-hairline pt-3 text-ink">
          <div class="flex items-start justify-between gap-3">
            <div>
              <span class="block font-semibold"><%= line.description %></span>
              <span class="mt-1 block text-meta text-ink-2">
                <%= line.estimated_cents.nil? ? "Estimate unknown" : "Estimated #{BudgetLine.format_cents(line.estimated_cents)}" %>
                · <%= line.actual_cents.nil? ? "Actual not recorded" : "Actual #{BudgetLine.format_cents(line.actual_cents)}" %>
                · <%= line.status.humanize %>
                <% if line.responsible_person.present? %>
                  · <%= person_pill(line.responsible_person) %>
                <% end %>
              </span>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-2 text-meta font-semibold">
              <% if Policy.can?(Current.person, :manage_budget, project) %>
                <%= actions_menu("Actions for #{line.description}") do %>
                  <%= link_to "Edit", edit_project_budget_line_path(project, line) %>
                  <hr>
                  <%= button_to "Delete", project_budget_line_path(project, line), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Delete “#{line.description}”? Its comments are deleted too." } } %>
                <% end %>
              <% end %>
              <% if Policy.can?(Current.person, :update_budget_line_status, line) %>
                <%= link_to "Update status", edit_project_budget_line_status_path(project, line), class: "text-ink-2 hover:text-ink" %>
              <% end %>
            </div>
          </div>
          <%= render "comments/thread", commentable: line %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-meta text-ink-2">No <%= kind_label %> yet</p>
  <% end %>
</div>
