<li class="text-ink">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
    <% if item.file? %>
      <%= link_to item.title, project_doc_item_path(project, item), class: "font-semibold text-ink hover:text-ink-2" %>
    <% elsif item.link? %>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to item.title, item.url, class: "font-semibold text-ink hover:text-ink-2", target: "_blank", rel: "noopener noreferrer" %>
        <% if item.pco? %>
          <span class="rounded-badge bg-ink px-1.5 py-0.5 text-label font-semibold text-on-ink">PCO</span>
        <% end %>
      </div>
    <% else %>
      <span class="block font-semibold"><%= item.title %></span>
      <% if item.body.present? %>
        <div class="rich-content mt-1 max-w-none text-ink-2"><%= item.body %></div>
      <% end %>
    <% end %>
    <span class="mt-1 block text-meta text-ink-2"><%= person_pill(item.author) %></span>
    </div>
    <% if Policy.can?(Current.person, :update, item) || Policy.can?(Current.person, :destroy, item) %>
      <%= actions_menu("Actions for #{item.title}") do %>
        <% if Policy.can?(Current.person, :update, item) %>
          <%= link_to "Edit", edit_project_doc_item_path(project, item), data: { action: "slideout#open", slideout_title_param: "Edit #{item.kind.humanize}" } %>
        <% end %>
        <% if Policy.can?(Current.person, :destroy, item) %>
          <%= button_to "Delete", project_doc_item_path(project, item), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Delete “#{item.title}”? Its comments are deleted too." } } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= render "comments/thread", commentable: item %>
</li>
