<section class="tool-section" aria-labelledby="tool-docs" data-controller="slideout">
  <%= render "projects/tools/planner_arrival", tool: "docs" %>
  <% doc_items = project.doc_items.includes(:author, file_attachment: :blob).ordered %>
  <% documents = doc_items.select(&:document?) %>
  <% files = doc_items.select(&:file?) %>
  <% links = doc_items.select(&:link?) %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-docs" class="text-ink"><%= Project::TOOL_LABELS.fetch("docs") %></h2>
    <% if Policy.can?(Current.person, :manage_docs, project) %>
      <div class="ml-auto flex flex-wrap justify-end gap-2">
        <%= link_to new_project_doc_item_path(project, kind: "document"), class: "btn btn-secondary btn-sm", data: { action: "slideout#open", slideout_title_param: "Add Document" } do %>Add Document<% end %>
        <%= link_to new_project_doc_item_path(project, kind: "file"), class: "btn btn-secondary btn-sm", data: { action: "slideout#open", slideout_title_param: "Add File" } do %>Add File<% end %>
        <%= link_to new_project_doc_item_path(project, kind: "link"), class: "btn btn-secondary btn-sm", data: { action: "slideout#open", slideout_title_param: "Add Link" } do %>Add Link<% end %>
      </div>
    <% end %>
  </div>

  <% if doc_items.any? %>
    <div class="mt-6 space-y-6">
      <% if documents.any? %>
        <div>
          <h3 class="text-ink-2">Documents</h3>
          <ul class="mt-3 space-y-3">
            <% documents.each do |item| %>
              <%= render "projects/tools/doc_item", project: project, item: item %>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if files.any? %>
        <div>
          <h3 class="text-ink-2">Files</h3>
          <ul class="mt-3 space-y-3">
            <% files.each do |item| %>
              <%= render "projects/tools/doc_item", project: project, item: item %>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if links.any? %>
        <div>
          <h3 class="text-ink-2">Links</h3>
          <ul class="mt-3 space-y-3">
            <% links.each do |item| %>
              <%= render "projects/tools/doc_item", project: project, item: item %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No items yet</p>
  <% end %>

  <dialog class="sheet" aria-labelledby="doc-item-form-heading" data-slideout-target="dialog" data-action="click->slideout#backdrop">
    <div class="sheet-panel">
      <div class="flex items-center justify-between gap-4">
        <h2 id="doc-item-form-heading" class="text-ink" data-slideout-target="title">Document</h2>
        <button type="button" class="btn btn-icon" aria-label="Close" data-action="slideout#close"><%= icon(:close) %></button>
      </div>
      <%= turbo_frame_tag "doc-item-form", data: { slideout_target: "frame", action: "turbo:submit-end->slideout#submitted" } do %>
        <p class="mt-6 text-meta text-ink-2">Loading…</p>
      <% end %>
    </div>
  </dialog>
</section>
