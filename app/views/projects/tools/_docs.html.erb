<section class="tool-section" aria-labelledby="tool-docs">
  <% doc_items = project.doc_items.includes(:author, file_attachment: :blob).ordered %>
  <% documents = doc_items.select(&:document?) %>
  <% files = doc_items.select(&:file?) %>
  <% links = doc_items.select(&:link?) %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-docs" class="text-ink"><%= icon(:docs, class: "text-tool-docs") %> <%= Project::TOOL_LABELS.fetch("docs") %></h2>
    <% if Policy.can?(Current.person, :manage_docs, project) %>
      <div class="flex flex-wrap justify-end gap-3 text-meta font-semibold text-ink-2">
        <%= link_to "Add document", new_project_doc_item_path(project, kind: "document"), class: "hover:text-ink" %>
        <%= link_to "Add file", new_project_doc_item_path(project, kind: "file"), class: "hover:text-ink" %>
        <%= link_to "Add link", new_project_doc_item_path(project, kind: "link"), class: "hover:text-ink" %>
      </div>
    <% end %>
  </div>

  <% if doc_items.any? %>
    <div class="mt-6 space-y-6">
      <% if documents.any? %>
        <div>
          <h3 class="text-ink-2">Documents</h3>
          <ul class="mt-3 space-y-3">
            <% documents.each do |item| %>
              <%= render "projects/tools/doc_item", project: project, item: item %>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if files.any? %>
        <div>
          <h3 class="text-ink-2">Files</h3>
          <ul class="mt-3 space-y-3">
            <% files.each do |item| %>
              <%= render "projects/tools/doc_item", project: project, item: item %>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if links.any? %>
        <div>
          <h3 class="text-ink-2">Links</h3>
          <ul class="mt-3 space-y-3">
            <% links.each do |item| %>
              <%= render "projects/tools/doc_item", project: project, item: item %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No items yet</p>
  <% end %>
</section>
