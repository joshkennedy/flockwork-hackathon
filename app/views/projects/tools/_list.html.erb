<% lists = project.lists.includes(:columns, :rows) %>
<section class="tool-section" aria-labelledby="tool-list" data-controller="slideout">
  <%= render "projects/tools/planner_arrival", tool: "list" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-list" class="text-ink"><%= Project::TOOL_LABELS.fetch("list") %></h2>
    <% if Policy.can?(Current.person, :manage_lists, project) %>
      <%= link_to "Add List", new_project_list_path(project), class: "inline-flex min-h-6 items-center text-meta font-semibold text-ink-2 hover:text-ink", data: { action: "slideout#open", slideout_title_param: "Add List" } %>
    <% end %>
  </div>

  <% if lists.any? %>
    <div class="mt-6 space-y-7">
      <% lists.each do |list| %>
        <% manage_lists = Policy.can?(Current.person, :manage_lists, project) %>
        <section class="min-w-0" aria-labelledby="list-<%= list.id %>">
          <div class="flex items-center justify-between gap-4">
            <h3 id="list-<%= list.id %>" class="text-body-phone sm:text-body font-semibold text-ink"><%= list.name %></h3>
            <div class="flex flex-wrap justify-end gap-2">
              <% if Policy.can?(Current.person, :manage_list_rows, project) %>
                <%= link_to new_project_list_list_row_path(project, list), class: "btn btn-secondary btn-sm", data: { action: "slideout#open", slideout_title_param: "Add Row" } do %>Add Row<% end %>
              <% end %>
              <% if Policy.can?(Current.person, :manage_lists, project) %>
                <%= link_to new_project_list_list_column_path(project, list), class: "btn btn-secondary btn-sm", data: { action: "slideout#open", slideout_title_param: "Add Column" } do %>Add Column<% end %>
                <%= actions_menu("Actions for #{list.name}") do %>
                  <%= link_to "Rename List", edit_project_list_path(project, list), data: { action: "slideout#open", slideout_title_param: "Rename List" } %>
                  <hr>
                  <%= button_to "Delete List", project_list_path(project, list), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Delete “#{list.name}”? Its columns, rows, comments, and values go with it." } } %>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="relative mt-3 max-w-full overflow-x-auto">
            <table class="list-table min-w-full border-collapse bg-panel text-left text-meta">
              <thead class="<%= "max-sm:hidden" unless manage_lists %>">
                <tr>
                  <% list.columns.each_with_index do |column, index| %>
                    <th class="min-w-40 border-b border-hairline px-3 py-2 text-ink">
                      <span class="column-name block font-semibold"><%= column.name %></span>
                      <% if manage_lists %>
                        <div class="mt-0.5 flex items-center justify-between gap-2">
                          <span class="text-label font-normal text-ink-2"><%= column.column_type.humanize %></span>
                          <%= actions_menu("Actions for #{column.name} column", align: index.zero? ? :start : :end) do %>
                            <%= link_to "Edit Column", edit_project_list_list_column_path(project, list, column), data: { action: "slideout#open", slideout_title_param: "Edit Column" } %>
                            <% if index.positive? %>
                              <%= button_to "Move Up", move_up_project_list_list_column_path(project, list, column), method: :patch %>
                            <% end %>
                            <% if index < list.columns.length - 1 %>
                              <%= button_to "Move Down", move_down_project_list_list_column_path(project, list, column), method: :patch %>
                            <% end %>
                            <hr>
                            <%= button_to "Delete Column", project_list_list_column_path(project, list, column), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Delete the #{column.name} column? Its values in every row go with it." } } %>
                          <% end %>
                        </div>
                      <% end %>
                    </th>
                  <% end %>
                  <th class="border-b border-hairline px-3 py-2"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% list.rows.each do |row| %>
                  <tr class="list-row">
                    <% list.columns.each do |column| %>
                      <td data-label="<%= column.name %>" class="border-b border-hairline px-3 py-3 text-ink <%="tabular-nums text-right" if column.column_type == "number" %>">
                        <% if column.checkbox? && Policy.can?(Current.person, :manage_list_rows, project) %>
                          <%= render "list_rows/checkbox_cell", project: project, list: list, list_row: row, column: column %>
                        <% else %>
                          <%= column.display(row.cells[column.id.to_s]) %>
                        <% end %>
                      </td>
                    <% end %>
                    <td class="whitespace-nowrap border-b border-hairline px-3 py-3">
                      <% if Policy.can?(Current.person, :manage_list_rows, project) %>
                        <div class="list-row-actions flex items-center justify-end gap-1">
                          <%= actions_menu("Actions for this row") do %>
                            <%= link_to "Edit Row", edit_project_list_list_row_path(project, list, row), data: { action: "slideout#open", slideout_title_param: "Edit Row" } %>
                            <hr>
                            <% row_label = list_row_label(list, row) %>
                            <% delete_question = row_label ? "Delete “#{row_label}”?" : "Delete this row?" %>
                            <%= button_to "Delete Row", project_list_list_row_path(project, list, row), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "#{delete_question} Its comments are deleted too." } } %>
                          <% end %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                  <tr class="list-comment-row">
                    <td colspan="<%= list.columns.length + 1 %>" class="px-3 pb-4">
                      <%= render "comments/thread", commentable: row %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No Lists yet</p>
  <% end %>

  <dialog class="slideout" aria-labelledby="list-form-heading" data-slideout-target="dialog" data-action="click->slideout#backdrop">
    <div class="slideout-panel">
      <div class="flex items-center justify-between gap-4">
        <h2 id="list-form-heading" class="text-ink" data-slideout-target="title">List</h2>
        <button type="button" class="btn btn-icon" aria-label="Close" data-action="slideout#close"><%= icon(:close) %></button>
      </div>
      <%= turbo_frame_tag "list-form", data: { slideout_target: "frame", action: "turbo:submit-end->slideout#submitted" } do %>
        <p class="mt-6 text-meta text-ink-2">Loading…</p>
      <% end %>
    </div>
  </dialog>
</section>
