<% lists = project.lists.includes(:columns, :rows) %>
<section class="tool-section" aria-labelledby="tool-list">
  <%= render "projects/tools/planner_arrival", tool: "list" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-list" class="text-ink"><%= icon(:list, class: "text-tool-list") %> <%= Project::TOOL_LABELS.fetch("list") %></h2>
    <% if Policy.can?(Current.person, :manage_lists, project) %>
      <%= link_to "Create List", new_project_list_path(project), class: "inline-flex min-h-6 items-center text-meta font-semibold text-ink-2 hover:text-ink" %>
    <% end %>
  </div>

  <% if lists.any? %>
    <div class="mt-6 space-y-7">
      <% lists.each do |list| %>
        <section class="min-w-0" aria-labelledby="list-<%= list.id %>">
          <div class="flex items-center justify-between gap-4">
            <h3 id="list-<%= list.id %>" class="text-body-phone sm:text-body font-semibold text-ink"><%= list.name %></h3>
            <div class="flex flex-wrap justify-end gap-4">
              <% if Policy.can?(Current.person, :manage_list_rows, project) %>
                <%= link_to "Add row", new_project_list_list_row_path(project, list), class: "inline-flex min-h-6 items-center text-meta font-semibold text-ink-2 hover:text-ink" %>
              <% end %>
              <% if Policy.can?(Current.person, :manage_lists, project) %>
                <%= link_to "Add column", new_project_list_list_column_path(project, list), class: "inline-flex min-h-6 items-center text-meta font-semibold text-ink-2 hover:text-ink" %>
              <% end %>
            </div>
          </div>

          <div class="relative mt-3 max-w-full overflow-x-auto">
            <% manage_lists = Policy.can?(Current.person, :manage_lists, project) %>
            <table class="list-table min-w-full border-collapse bg-panel text-left text-meta">
              <thead class="<%= "max-sm:hidden" unless manage_lists %>">
                <tr>
                  <% list.columns.each_with_index do |column, index| %>
                    <th class="min-w-40 border-b border-hairline px-3 py-2 text-ink">
                      <span class="column-name block font-semibold"><%= column.name %></span>
                      <% if manage_lists %>
                        <span class="mt-0.5 block text-label font-normal text-ink-2"><%= column.column_type.humanize %></span>
                        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-label font-semibold">
                          <%= link_to "Edit", edit_project_list_list_column_path(project, list, column), class: "inline-flex min-h-6 items-center text-ink-2 hover:text-ink" %>
                          <% if index.positive? %>
                            <%= button_to "Move up", move_up_project_list_list_column_path(project, list, column), method: :patch, class: "btn btn-text" %>
                          <% end %>
                          <% if index < list.columns.length - 1 %>
                            <%= button_to "Move down", move_down_project_list_list_column_path(project, list, column), method: :patch, class: "btn btn-text" %>
                          <% end %>
                          <%= button_to "Remove", project_list_list_column_path(project, list, column), method: :delete, class: "btn btn-danger" %>
                        </div>
                      <% end %>
                    </th>
                  <% end %>
                  <th class="border-b border-hairline px-3 py-2"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% list.rows.each do |row| %>
                  <tr class="list-row">
                    <% list.columns.each do |column| %>
                      <td data-label="<%= column.name %>" class="border-b border-hairline px-3 py-3 text-ink <%="tabular-nums text-right" if column.column_type == "number" %>">
                        <% if column.checkbox? && Policy.can?(Current.person, :manage_list_rows, project) %>
                          <%= render "list_rows/checkbox_cell", project: project, list: list, list_row: row, column: column %>
                        <% else %>
                          <%= column.display(row.cells[column.id.to_s]) %>
                        <% end %>
                      </td>
                    <% end %>
                    <td class="whitespace-nowrap border-b border-hairline px-3 py-3">
                      <% if Policy.can?(Current.person, :manage_list_rows, project) %>
                        <div class="list-row-actions flex items-center justify-end gap-1">
                          <%= link_to "Edit", edit_project_list_list_row_path(project, list, row), class: "btn btn-text" %>
                          <%= button_to "Delete", project_list_list_row_path(project, list, row), method: :delete, class: "btn btn-danger" %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                  <tr class="list-comment-row">
                    <td colspan="<%= list.columns.length + 1 %>" class="px-3 pb-4">
                      <%= render "comments/thread", commentable: row %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No Lists yet</p>
  <% end %>
</section>
