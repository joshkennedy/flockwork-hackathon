<% lists = project.lists.includes(:columns, :rows) %>
<section class="min-h-44 min-w-0 bg-[#e7ede3] p-6 [contain:paint] md:col-span-2" aria-labelledby="tool-list">
  <div class="flex items-start justify-between gap-4">
    <h2 id="tool-list" class="text-xl font-bold text-stone-950"><%= Project::TOOL_LABELS.fetch("list") %></h2>
    <% if Policy.can?(Current.person, :manage_lists, project) %>
      <%= link_to "Create List", new_project_list_path(project), class: "inline-flex min-h-6 items-center text-sm font-semibold text-stone-700 hover:text-stone-950" %>
    <% end %>
  </div>

  <% if lists.any? %>
    <div class="mt-6 space-y-8">
      <% lists.each do |list| %>
        <section class="min-w-0" aria-labelledby="list-<%= list.id %>">
          <div class="flex items-center justify-between gap-4">
            <h3 id="list-<%= list.id %>" class="text-lg font-bold text-stone-950"><%= list.name %></h3>
            <div class="flex flex-wrap justify-end gap-4">
              <% if Policy.can?(Current.person, :manage_list_rows, project) %>
                <%= link_to "Add row", new_project_list_list_row_path(project, list), class: "inline-flex min-h-6 items-center text-sm font-semibold text-stone-700 hover:text-stone-950" %>
              <% end %>
              <% if Policy.can?(Current.person, :manage_lists, project) %>
                <%= link_to "Add column", new_project_list_list_column_path(project, list), class: "inline-flex min-h-6 items-center text-sm font-semibold text-stone-700 hover:text-stone-950" %>
              <% end %>
            </div>
          </div>

          <div class="mt-3 max-w-full overflow-x-auto">
            <table class="min-w-full border-collapse bg-white text-left text-sm">
              <thead>
                <tr>
                  <% list.columns.each_with_index do |column, index| %>
                    <th class="min-w-40 border-b border-stone-300 px-3 py-2 text-stone-900">
                      <span class="column-name block font-semibold"><%= column.name %></span>
                      <span class="mt-0.5 block text-xs font-normal text-stone-500"><%= column.column_type.humanize %></span>
                      <% if Policy.can?(Current.person, :manage_lists, project) %>
                        <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs font-semibold">
                          <%= link_to "Edit", edit_project_list_list_column_path(project, list, column), class: "inline-flex min-h-6 items-center text-stone-600 hover:text-stone-950" %>
                          <% if index.positive? %>
                            <%= button_to "Move up", move_up_project_list_list_column_path(project, list, column), method: :patch, class: "min-h-6 text-stone-600 hover:text-stone-950" %>
                          <% end %>
                          <% if index < list.columns.length - 1 %>
                            <%= button_to "Move down", move_down_project_list_list_column_path(project, list, column), method: :patch, class: "min-h-6 text-stone-600 hover:text-stone-950" %>
                          <% end %>
                          <%= button_to "Remove", project_list_list_column_path(project, list, column), method: :delete, class: "min-h-6 text-red-800 hover:text-red-950" %>
                        </div>
                      <% end %>
                    </th>
                  <% end %>
                  <th class="border-b border-stone-300 px-3 py-2"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                <% list.rows.each do |row| %>
                  <tr>
                    <% list.columns.each do |column| %>
                      <td class="border-b border-stone-200 px-3 py-3 text-stone-800">
                        <% if column.checkbox? && Policy.can?(Current.person, :manage_list_rows, project) %>
                          <%= render "list_rows/checkbox_cell", project: project, list: list, list_row: row, column: column %>
                        <% else %>
                          <%= column.display(row.cells[column.id.to_s]) %>
                        <% end %>
                      </td>
                    <% end %>
                    <td class="border-b border-stone-200 px-3 py-3">
                      <% if Policy.can?(Current.person, :manage_list_rows, project) %>
                        <div class="flex justify-end gap-3 font-semibold">
                          <%= link_to "Edit", edit_project_list_list_row_path(project, list, row), class: "inline-flex min-h-6 items-center text-stone-700 hover:text-stone-950" %>
                          <%= button_to "Delete", project_list_list_row_path(project, list, row), method: :delete, class: "min-h-6 text-red-800 hover:text-red-950" %>
                        </div>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <td colspan="<%= list.columns.length + 1 %>" class="px-3 pb-4">
                      <%= render "comments/thread", commentable: row %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="mt-8 text-sm text-stone-600">No Lists yet</p>
  <% end %>
</section>
