<section class="tool-section" aria-labelledby="tool-messages">
  <%= render "projects/tools/planner_arrival", tool: "messages" %>
  <% roots = project.message_board_roots %>

  <div class="flex items-center justify-between gap-4">
    <h2 id="tool-messages" class="text-ink"><%= icon(:messages, class: "text-tool-messages") %> <%= Project::TOOL_LABELS.fetch("messages") %></h2>
    <% if roots.any? %>
      <span class="text-meta text-ink-2"><%= pluralize(roots.size, "Conversation") %></span>
    <% end %>
  </div>

  <% if Policy.can?(Current.person, :post_message, project) %>
    <%= render "messages/plain_form",
          project: project,
          message: project.messages.build,
          label: "Write a Message",
          submit_label: "Post Message",
          class_name: "message-composer mt-5" %>
  <% end %>

  <% if roots.any? %>
    <ol class="message-thread mt-5">
      <% roots.each do |root| %>
        <li>
          <%= render "projects/tools/message", message: root, project: project %>

          <% if root.replies.any? %>
            <ol class="ml-8 mt-4 space-y-4">
              <% root.replies.each do |reply| %>
                <li>
                  <%= render "projects/tools/message", message: reply, project: project %>
                </li>
              <% end %>
            </ol>
          <% end %>

          <% if Policy.can?(Current.person, :post_message, project) %>
            <details class="ml-8 mt-3" data-reply-form>
              <summary class="comment-toggle btn btn-text btn-sm -ml-2 list-none [&::-webkit-details-marker]:hidden">
                <%= icon(:reply) %>
                Reply
              </summary>
              <%= render "messages/plain_form",
                    project: project,
                    message: project.messages.build(parent: root),
                    label: "Write a Reply",
                    submit_label: "Post Reply",
                    class_name: "message-composer mt-3" %>
            </details>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-6 text-meta text-ink-2">No messages yet</p>
  <% end %>
</section>
