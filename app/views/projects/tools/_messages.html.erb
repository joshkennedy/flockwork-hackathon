<section class="tool-section" aria-labelledby="tool-messages" data-controller="slideout">
  <%= render "projects/tools/planner_arrival", tool: "messages" %>
  <% roots = project.message_board_roots %>

  <div class="flex items-center justify-between gap-4">
    <h2 id="tool-messages" class="text-ink"><%= Project::TOOL_LABELS.fetch("messages") %></h2>
    <% if roots.any? %>
      <span class="text-meta text-ink-2"><%= pluralize(roots.size, "thread") %></span>
    <% end %>
  </div>

  <% if Policy.can?(Current.person, :plan, project) %>
    <p class="mt-4"><%= link_to "Draft a message", new_project_message_draft_path(project), class: "link" %></p>
  <% end %>

  <% if Policy.can?(Current.person, :post_message, project) %>
    <%= render "messages/plain_form",
          project: project,
          message: project.messages.build,
          label: "Write a message",
          submit_label: "Post Message",
          class_name: "message-composer mt-5" %>
  <% end %>

  <% if roots.any? %>
    <ol class="message-thread mt-5">
      <% roots.each do |root| %>
        <li>
          <%= render "projects/tools/message", message: root, project: project %>

          <% if root.replies.any? %>
            <ol class="ml-8 mt-4 space-y-4">
              <% root.replies.each do |reply| %>
                <li>
                  <%= render "projects/tools/message", message: reply, project: project %>
                </li>
              <% end %>
            </ol>
          <% end %>

          <% if Policy.can?(Current.person, :post_message, project) %>
            <details class="ml-8 mt-3" data-reply-form>
              <summary class="comment-toggle btn btn-text btn-sm -ml-2 list-none [&::-webkit-details-marker]:hidden">
                Reply
              </summary>
              <%= render "messages/plain_form",
                    project: project,
                    message: project.messages.build(parent: root),
                    label: "Write a Reply",
                    submit_label: "Post Reply",
                    class_name: "message-composer mt-3" %>
            </details>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="mt-6 text-meta text-ink-2">No messages yet</p>
  <% end %>

  <dialog class="slideout" aria-labelledby="message-form-heading" data-slideout-target="dialog" data-action="click->slideout#backdrop">
    <div class="slideout-panel">
      <div class="flex items-center justify-between gap-4">
        <h2 id="message-form-heading" class="text-ink" data-slideout-target="title">Message</h2>
        <button type="button" class="btn btn-icon" aria-label="Close" data-action="slideout#close"><%= icon(:close) %></button>
      </div>
      <%= turbo_frame_tag "message-form", data: { slideout_target: "frame", action: "turbo:submit-end->slideout#submitted" } do %>
        <p class="mt-6 text-meta text-ink-2">Loading…</p>
      <% end %>
    </div>
  </dialog>
</section>
