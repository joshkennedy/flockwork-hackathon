<% if @completed_planner_session&.acceptance_tool == tool %>
  <p role="status" class="mb-4 rounded-control bg-sunlit-soft px-4 py-3 text-ink">
    <% if @completed_planner_session.meal_planner? %>
      <%= pluralize(@completed_planner_session.pending_item_count, "meal") %> added to your Sign-up sheet.
    <% else %>
      <%= pluralize(@completed_planner_session.pending_item_count, "item") %> added to your Project.
    <% end %>
  </p>
<% end %>
