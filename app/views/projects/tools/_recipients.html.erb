<% if Policy.can?(Current.person, :view_recipients, project) %>
  <% recipients = project.recipients.joins(:person).order("people.name") %>
  <section class="tool-section" aria-labelledby="tool-recipients">
    <%= render "projects/tools/planner_arrival", tool: "recipients" %>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 id="tool-recipients" class="text-ink"><%= icon(:heart, class: "text-tool-messages") %> <%= Project::TOOL_LABELS.fetch("recipients") %></h2>
      <% if Policy.can?(Current.person, :manage_recipients, project) %>
        <%= link_to new_project_recipient_path(project), class: "btn btn-secondary btn-sm" do %><%= icon(:plus) %>Add recipient<% end %>
      <% end %>
    </div>

    <% if recipients.any? %>
      <ul class="mt-4 divide-y divide-hairline border-t border-hairline">
        <% recipients.each do |recipient| %>
          <li class="py-4">
            <div class="flex items-center justify-between gap-4">
              <span class="font-semibold text-ink"><%= recipient.person.name %></span>
              <% if Policy.can?(Current.person, :manage_recipients, project) %>
                <%= actions_menu("Actions for #{recipient.person.name}") do %>
                  <%= button_to "Remove", project_recipient_path(project, recipient), method: :delete, class: "menu-danger" %>
                <% end %>
              <% end %>
            </div>
            <div class="mt-3" aria-label="Notes for <%= recipient.person.name %>">
              <h3 class="text-label font-medium text-ink-2">Care notes</h3>
              <%= render "notes/list", notes: @recipient_notes_by_id.fetch(recipient.id, []) %>
              <%= render "notes/form",
                notable: recipient,
                visibilities: @note_visibilities,
                form_url: project_notes_path(project) %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-7 text-meta text-ink-2">No recipients yet</p>
    <% end %>
  </section>
<% end %>
