<% schedule_items_by_day = project.schedule_items.grouped_by_day %>
<section class="tool-section" aria-labelledby="tool-schedule" data-controller="slideout">
  <%= render "projects/tools/planner_arrival", tool: "schedule" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-schedule" class="text-ink"><%= Project::TOOL_LABELS.fetch("schedule") %></h2>
    <% if Policy.can?(Current.person, :manage_schedule, project) %>
      <%= link_to new_project_schedule_item_path(project), class: "btn btn-secondary btn-sm", data: { action: "slideout#open", slideout_title_param: "Add Schedule Item" } do %>Add Item<% end %>
    <% end %>
  </div>

  <% if schedule_items_by_day.any? %>
    <div class="mt-6 space-y-6">
      <% schedule_items_by_day.each do |day, items| %>
        <div>
          <h3><%= day.strftime("%A, %B %-d") %></h3>
          <ul class="mt-3 space-y-2">
            <% items.each do |item| %>
              <li class="text-ink" data-schedule-item-id="<%= item.id %>">
                <div class="flex items-start justify-between gap-3">
                  <% time_label = item.starts_at_time && [ item.starts_at_time, item.ends_at_time ].compact.map { |time| time.strftime("%-l:%M %p") }.join(" – ") %>
                  <% meta = [ time_label, item.location.presence ].compact.join(" · ") %>
                  <div class="min-w-0">
                    <p class="text-heading text-ink"><%= item.title %></p>
                    <% if meta.present? %>
                      <p class="mt-0.5 text-meta text-ink-2"><%= meta %></p>
                    <% end %>
                  </div>
                  <%= actions_menu("Actions for #{item.title}") do %>
                    <%= link_to "Add to Calendar", project_schedule_item_calendar_path(project, item), data: { turbo: false } %>
                    <% if Policy.can?(Current.person, :manage_schedule, project) %>
                      <%= link_to "Edit Item", edit_project_schedule_item_path(project, item), data: { action: "slideout#open", slideout_title_param: "Edit Schedule Item" } %>
                      <hr>
                      <%= button_to "Delete Item", project_schedule_item_path(project, item), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: "Delete “#{item.title}”? Its comments are deleted too, and linked Slots stay without a Schedule item." } } %>
                    <% end %>
                  <% end %>
                </div>
                <% if item.slots.any? %>
                  <ul class="mt-3 space-y-1" aria-label="Slots for <%= item.title %>">
                    <% item.slots.chronological.each do |slot| %>
                      <li class="flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-control bg-ghost-fill px-3">
                        <span class="schedule-role-label font-medium"><%= slot.label %></span>
                        <span class="schedule-role-count ml-auto text-meta text-ink-2"><%= slot.claims_count %> of <%= slot.capacity %> filled</span>
                        <% if slot.full? || Policy.can?(Current.person, :claim_slot, project) %>
                          <%= link_to(slot.full? ? "View" : "Claim", "##{dom_id(slot)}", class: "btn btn-secondary btn-sm min-h-11") %>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
                <%= render "comments/thread", commentable: item %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No items yet</p>
  <% end %>

  <dialog class="slideout" aria-labelledby="schedule-item-form-heading" data-slideout-target="dialog" data-action="click->slideout#backdrop">
    <div class="slideout-panel">
      <div class="flex items-center justify-between gap-4">
        <h2 id="schedule-item-form-heading" class="text-ink" data-slideout-target="title">Schedule Item</h2>
        <button type="button" class="btn btn-icon" aria-label="Close" data-action="slideout#close"><%= icon(:close) %></button>
      </div>
      <%= turbo_frame_tag "schedule-item-form", data: { slideout_target: "frame", action: "turbo:submit-end->slideout#submitted" } do %>
        <p class="mt-6 text-meta text-ink-2">Loading…</p>
      <% end %>
    </div>
  </dialog>
</section>
