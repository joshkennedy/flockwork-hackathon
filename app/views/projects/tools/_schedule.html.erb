<% schedule_items_by_day = project.schedule_items.grouped_by_day %>
<section class="tool-section" aria-labelledby="tool-schedule">
  <%= render "projects/tools/planner_arrival", tool: "schedule" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-schedule" class="text-ink"><%= icon(:schedule, class: "text-tool-schedule") %> <%= Project::TOOL_LABELS.fetch("schedule") %></h2>
    <% if Policy.can?(Current.person, :manage_schedule, project) %>
      <%= link_to "Add item", new_project_schedule_item_path(project), class: "text-meta font-semibold text-ink-2 hover:text-ink" %>
    <% end %>
  </div>

  <% if schedule_items_by_day.any? %>
    <div class="mt-6 space-y-6">
      <% schedule_items_by_day.each do |day, items| %>
        <div>
          <h3 class="text-ink-2"><%= day.strftime("%A, %B %-d") %></h3>
          <ul class="mt-3 space-y-2">
            <% items.each do |item| %>
              <li class="text-ink">
                <div class="flex items-start justify-between gap-3">
                  <div>
                  <% if item.starts_at_time.present? %>
                    <span class="text-meta font-medium text-ink-2">
                      <%= item.starts_at_time.strftime("%-l:%M %p") %>
                      <% if item.ends_at_time.present? %>
                        – <%= item.ends_at_time.strftime("%-l:%M %p") %>
                      <% end %>
                    </span>
                  <% end %>
                  <span class="block font-semibold"><%= item.title %></span>
                  <% if item.location.present? %>
                    <span class="block text-meta text-ink-2"><%= item.location %></span>
                  <% end %>
                  </div>
                  <% if Policy.can?(Current.person, :manage_schedule, project) %>
                    <div class="flex flex-wrap gap-3 text-meta font-semibold">
                      <%= link_to "Edit", edit_project_schedule_item_path(project, item), class: "text-ink-2 hover:text-ink" %>
                      <%= button_to "Delete", project_schedule_item_path(project, item), method: :delete, class: "btn btn-danger" %>
                    </div>
                  <% end %>
                </div>
                <%= render "comments/thread", commentable: item %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No items yet</p>
  <% end %>
</section>
