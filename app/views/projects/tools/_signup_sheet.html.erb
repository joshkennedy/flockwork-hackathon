<% slots_by_date = project.slots.includes(slot_claims: :person).chronological.group_by(&:date) %>
<section class="tool-section" aria-labelledby="tool-signup-sheet">
  <%= render "projects/tools/planner_arrival", tool: "signup_sheet" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-signup-sheet"><%= icon(:schedule, class: "text-tool-signup") %> <%= Project::TOOL_LABELS.fetch("signup_sheet") %></h2>
    <% if Policy.can?(Current.person, :manage_slots, project) %>
      <div class="flex flex-wrap gap-4 text-meta font-medium text-ink-2">
        <%= link_to "Add Slot", new_project_slot_path(project), class: "hover:text-ink" %>
        <%= link_to "Generate run", new_project_slot_run_path(project), class: "hover:text-ink" %>
      </div>
    <% end %>
  </div>

  <% if flash[:alert].present? %>
    <p role="alert" class="mt-4 text-danger"><%= flash[:alert] %></p>
  <% end %>

  <% if slots_by_date.any? %>
    <div class="mt-5 max-w-2xl space-y-5">
      <% slots_by_date.each do |date, slots| %>
        <div>
          <h3 class="mb-3"><%= date.strftime("%A, %B %-d") %></h3>
          <ul class="space-y-3">
            <% slots.each do |slot| %>
              <% own_claim = slot.slot_claims.find { |claim| claim.person_id == Current.person.id } %>
              <li class="<%= !slot.full? && !own_claim ?"tile-raised p-4" : "border-b border-hairline py-3" %>">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <% if slot.starts_at_time.present? %>
                      <p class="mb-1 text-meta text-ink-2"><%= slot.starts_at_time.strftime("%-l:%M %p") %></p>
                    <% end %>
                    <p class="font-semibold"><%= slot.label %></p>
                    <p class="mt-1 text-meta text-ink-2"><%= slot.full? ? "Full" : "#{slot.claims_count} of #{slot.capacity} filled" %></p>
                    <% if slot.slot_claims.any? %>
                      <p class="mt-2 flex items-start gap-2 text-meta text-ink-2"><%= icon(:check, class: own_claim ? "text-sunlit" : "text-ink-2") %><span><%= slot.slot_claims.map { |claim| claim.person.name }.to_sentence %></span></p>
                    <% end %>
                  </div>
                  <% unless slot.full? || own_claim %>
                    <span class="badge-need"><%= pluralize(slot.capacity - slot.claims_count, "spot") %> left</span>
                  <% end %>
                </div>
                <% if own_claim %>
                  <p class="mt-2 text-meta text-ink-2"><%= slot.label.downcase == "dinner" ? "You’re bringing dinner" : "You’re signed up for #{slot.label.downcase}" %></p>
                <% end %>
                <% if own_claim %>
                  <%= button_to "Release", project_slot_claim_path(project, slot), method: :delete, class: "mt-3 btn btn-text" %>
                <% elsif !slot.full? && Policy.can?(Current.person, :claim_slot, project) %>
                  <%= button_to (slot.label.downcase == "dinner" ? "I can bring dinner" : "I can help with #{slot.label.downcase}"), project_slot_claim_path(project, slot), class: "mt-3 btn btn-primary min-h-phone-action-h w-full", aria: { label: "Claim: #{slot.label}" } %>
                <% end %>
                <% if Policy.can?(Current.person, :manage_slots, project) %>
                  <div class="mt-2 flex items-center gap-3">
                    <%= link_to "Edit", edit_project_slot_path(project, slot), class: "btn btn-text" %>
                    <%= button_to "Delete", project_slot_path(project, slot), method: :delete, class: "btn btn-danger" %>
                  </div>
                <% end %>
                <%= render "comments/thread", commentable: slot %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-5 text-meta text-ink-2">No Slots yet</p>
  <% end %>
</section>
