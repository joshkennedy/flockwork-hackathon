<% slots_by_date = project.slots.includes(slot_claims: :person).chronological.group_by(&:date) %>
<section class="min-h-44 bg-[#e7ede3] p-6" aria-labelledby="tool-signup-sheet">
  <div class="flex items-start justify-between gap-4">
    <h2 id="tool-signup-sheet" class="text-xl font-bold text-stone-950"><%= Project::TOOL_LABELS.fetch("signup_sheet") %></h2>
    <% if Policy.can?(Current.person, :manage_slots, project) %>
      <div class="flex flex-wrap justify-end gap-x-4 gap-y-2 text-sm font-semibold">
        <%= link_to "Add Slot", new_project_slot_path(project), class: "text-stone-700 hover:text-stone-950" %>
        <%= link_to "Generate run", new_project_slot_run_path(project), class: "text-stone-700 hover:text-stone-950" %>
      </div>
    <% end %>
  </div>

  <% if flash[:alert].present? %>
    <p class="mt-4 border-l-4 border-red-700 bg-red-50 px-4 py-3 text-sm font-semibold text-red-950"><%= flash[:alert] %></p>
  <% end %>

  <% if slots_by_date.any? %>
    <div class="mt-6 space-y-6">
      <% slots_by_date.each do |date, slots| %>
        <div>
          <h3 class="text-sm font-semibold text-stone-700"><%= date.strftime("%A, %B %-d") %></h3>
          <ul class="mt-3 space-y-4">
            <% slots.each do |slot| %>
              <li>
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <% if slot.starts_at_time.present? %>
                      <p class="text-sm font-medium text-stone-600"><%= slot.starts_at_time.strftime("%-l:%M %p") %></p>
                    <% end %>
                    <p class="font-semibold text-stone-950"><%= slot.label %></p>
                    <p class="mt-1 text-sm font-medium text-stone-700">
                      <%= slot.full? ? "Full" : "#{slot.claims_count} of #{slot.capacity} filled" %>
                    </p>
                    <% if slot.slot_claims.any? %>
                      <p class="mt-1 text-sm text-stone-600"><%= slot.slot_claims.map { |claim| claim.person.name }.to_sentence %></p>
                    <% end %>
                  </div>
                  <div class="flex shrink-0 flex-wrap justify-end gap-3 text-sm font-semibold">
                    <% if (own_claim = slot.slot_claims.find { |claim| claim.person_id == Current.person.id }) %>
                      <%= button_to "Release", project_slot_claim_path(project, slot), method: :delete, class: "text-stone-700 hover:text-stone-950" %>
                    <% elsif !slot.full? && Policy.can?(Current.person, :claim_slot, project) %>
                      <%= button_to "Claim", project_slot_claim_path(project, slot), class: "text-stone-700 hover:text-stone-950" %>
                    <% end %>
                    <% if Policy.can?(Current.person, :manage_slots, project) %>
                      <%= link_to "Edit", edit_project_slot_path(project, slot), class: "text-stone-700 hover:text-stone-950" %>
                      <%= button_to "Delete", project_slot_path(project, slot), method: :delete, class: "text-red-800 hover:text-red-950" %>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-8 text-sm text-stone-600">No Slots yet</p>
  <% end %>
</section>
