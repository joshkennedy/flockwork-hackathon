<% own_claim = slot.slot_claims.find { |claim| claim.person_id == Current.person.id } %>
<% open = !slot.full? && !own_claim %>
<% manage = Policy.can?(Current.person, :manage_slots, project) %>
<% comment_count = slot.comments.size %>
<% can_comment = Policy.can?(Current.person, :comment, project) %>
<% has_comment_thread = comment_count.positive? || can_comment || slot.follows.exists?(person: Current.person) %>
<%# Phones keep DESIGN.md's raised tile for an open Slot; wider screens show every Slot as a flat row. %>
<li id="<%= dom_id(slot) %>" class="signup-row<%= " signup-open" if open %>" data-controller="<%= "comment-thread" if has_comment_thread %>">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <p class="signup-date w-28 shrink-0">
      <span class="block font-semibold"><%= slot.date.strftime(slot.date.year == Date.current.year ? "%a, %b %-d" : "%a, %b %-d, %Y") %></span>
      <% if slot.date == Date.current %><span class="block text-label text-ink-2">Today</span><% end %>
    </p>
    <div class="signup-details min-w-0 flex-1">
      <p class="text-ink-2">
        <span class="text-ink"><%= slot.label %></span><% if slot.starts_at_time.present? %> · <%= slot.starts_at_time.strftime("%-l:%M %p") %><% end %>
      </p>
      <% if slot.schedule_item %>
        <p class="signup-session text-meta text-ink-2">Schedule item: <%= slot.schedule_item.title %></p>
      <% end %>
      <% if own_claim %>
        <p class="flex items-center gap-1.5 text-heading text-ink"><%= icon(:check, size: 18, view_box: "3 2 18 18", class: "stroke-2 text-sunlit-strong") %><%= claimed_slot_phrase(slot) %></p>
      <% end %>
    </div>
    <div class="signup-actions flex min-w-0 flex-wrap items-center gap-2.5 <%= "max-sm:w-full" if open %>">
      <% if slot.slot_claims.any? %>
        <ul class="signup-people min-w-0 max-w-full space-y-1 text-meta text-ink-2">
          <% slot.slot_claims.each do |claim| %>
            <li class="flex min-w-0 items-center gap-1.5"><%= person_pill(claim.person) %><% if claim.note.present? %><span>· <%= claim.note %></span><% end %></li>
          <% end %>
        </ul>
      <% end %>
      <% if open %>
        <% can_claim = Policy.can?(Current.person, :claim_slot, project) %>
        <% if can_claim %>
          <% if slot.claim_prompt.present? %>
            <%= form_with scope: :slot_claim, url: project_slot_claim_path(project, slot), class: "w-full space-y-2 sm:max-w-sm" do |form| %>
              <%= form.label :note, slot.claim_prompt, class: "block text-label font-medium text-ink" %>
              <div class="flex flex-col gap-2 sm:flex-row">
                <%= form.text_field :note, maxlength: 80, required: true, class: "field min-w-0 flex-1" %>
                <%= form.submit "Sign Up", class: "btn btn-secondary btn-sm btn-claim" %>
              </div>
            <% end %>
          <% else %>
            <%= button_to "Sign Up", project_slot_claim_path(project, slot),
                  class: "btn btn-secondary btn-sm btn-claim",
                  form_class: "button_to max-sm:w-full",
                  aria: { label: "Sign up for #{slot.label}" } %>
          <% end %>
        <% end %>
      <% end %>
      <span class="text-meta text-ink-2"><%= slot_claims_summary(slot) %></span>
    </div>
    <% if manage || own_claim || has_comment_thread %>
      <%= actions_menu("Actions for #{slot.label} on #{slot.date.strftime("%B %-d")}") do %>
        <% if has_comment_thread %>
          <button type="button" aria-expanded="false" data-comment-thread-target="trigger" data-action="comment-thread#toggle"><%= comment_count.positive? ? "View #{pluralize(comment_count, "Comment")}" : "Add Comment" %></button>
        <% end %>
        <% if own_claim %>
          <%= link_to "Add to Calendar", project_slot_calendar_path(project, slot), data: { turbo: false } %>
          <%= button_to "Release", project_slot_claim_path(project, slot), method: :delete if Policy.can?(Current.person, :claim_slot, project) %>
        <% end %>
        <% if manage %>
          <%= link_to "Edit Slot", edit_project_slot_path(project, slot), data: { action: "slideout#open", slideout_title_param: "Edit Slot" } %>
          <hr>
          <%= button_to "Delete Slot", project_slot_path(project, slot), method: :delete, class: "menu-danger", form: { data: { turbo_confirm: slot.slot_claims.any? ? "Delete this Slot? #{pluralize(slot.slot_claims.size, "person")} signed up will lose their spot. Its comments are deleted too." : "Delete this Slot? Its comments are deleted too." } } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <% if own_claim && (slot.claim_prompt.present? || own_claim.note.present?) %>
    <details class="mt-3 max-w-sm">
      <%= disclosure_summary "Edit Answer" %>
      <%= form_with model: own_claim, scope: :slot_claim, url: project_slot_claim_path(project, slot), method: :patch, class: "mt-3 space-y-3" do |form| %>
        <%= form.label :note, slot.claim_prompt.presence || "Your answer", class: "block text-label font-medium text-ink" %>
        <%= form.text_field :note, maxlength: 80, required: slot.claim_prompt.present?, class: "field block w-full" %>
        <%= form.submit "Save Answer", class: "btn btn-secondary btn-sm" %>
      <% end %>
    </details>
  <% end %>
  <%= render "comments/thread", commentable: slot, external: true if has_comment_thread %>
</li>
