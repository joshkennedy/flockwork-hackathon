<% open_tasks = project.tasks.open.includes(:assignee, :rich_text_details).due_first %>
<% done_tasks = project.tasks.done.includes(:assignee, :completed_by, :rich_text_details).order(completed_at: :desc, id: :desc) %>
<section class="min-h-44 min-w-0 bg-[#e7ede3] p-6" aria-labelledby="tool-tasks">
  <div class="flex items-start justify-between gap-4">
    <h2 id="tool-tasks" class="text-xl font-bold text-stone-950"><%= Project::TOOL_LABELS.fetch("tasks") %></h2>
    <% if Policy.can?(Current.person, :manage_tasks, project) %>
      <%= link_to "Add Task", new_project_task_path(project), class: "min-h-11 px-2 py-3 text-sm font-semibold text-stone-700 hover:text-stone-950" %>
    <% end %>
  </div>

  <% if flash[:alert].present? %>
    <p role="alert" class="mt-4 bg-red-100 px-4 py-3 text-sm font-semibold text-red-950"><%= flash[:alert] %></p>
  <% end %>

  <% if open_tasks.any? %>
    <ul class="mt-5 space-y-3">
      <% open_tasks.each do |task| %>
        <li class="bg-[#fafbf7] p-4 text-stone-900">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="font-semibold"><%= task.title %></h3>
              <% if task.due_on.present? %>
                <p class="mt-1 text-sm text-stone-600">Due <%= task.due_on.to_fs(:long) %></p>
              <% end %>
            </div>
            <% if task.assignee.present? %>
              <span class="shrink-0 text-sm font-medium text-stone-600"><%= task.assignee.name %></span>
            <% elsif Policy.can?(Current.person, :claim_task, task) %>
              <%= button_to "Open — Claim", claim_project_task_path(project, task), class: "min-h-11 shrink-0 bg-[#1f291f] px-4 py-2 text-sm font-semibold text-white hover:bg-[#354235]" %>
            <% else %>
              <span class="shrink-0 text-sm font-medium text-stone-600">Open</span>
            <% end %>
          </div>
          <% if task.details.present? %>
            <div class="mt-3 text-sm leading-6 text-stone-700"><%= task.details %></div>
          <% end %>
          <% if Policy.can?(Current.person, :manage_tasks, project) ||
                Policy.can?(Current.person, :unclaim_task, task) ||
                Policy.can?(Current.person, :mark_task_done, task) %>
            <div class="mt-3 flex flex-wrap gap-4 text-sm font-semibold">
              <% if Policy.can?(Current.person, :mark_task_done, task) %>
                <%= button_to "Done", mark_done_project_task_path(project, task), class: "min-h-11 bg-[#1f291f] px-4 py-2 text-white hover:bg-[#354235]" %>
              <% end %>
              <% if Policy.can?(Current.person, :unclaim_task, task) %>
                <%= button_to "Unclaim", unclaim_project_task_path(project, task), class: "min-h-11 px-2 py-2 text-stone-700 hover:text-stone-950" %>
              <% end %>
              <% if Policy.can?(Current.person, :manage_tasks, project) %>
                <%= link_to "Edit", edit_project_task_path(project, task), class: "py-2 text-stone-700 hover:text-stone-950" %>
                <%= button_to "Delete", project_task_path(project, task), method: :delete, class: "py-2 text-red-800 hover:text-red-950" %>
              <% end %>
            </div>
          <% end %>
          <%= render "comments/thread", commentable: task %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-8 text-sm text-stone-600">No open Tasks</p>
  <% end %>

  <% if done_tasks.any? %>
    <h3 class="mt-7 text-base font-bold text-stone-950">Done</h3>
    <ul class="mt-3 space-y-2">
      <% done_tasks.each do |task| %>
        <li class="py-2 text-sm text-stone-700">
          <div class="flex items-start justify-between gap-3">
            <div>
              <span class="font-medium"><%= task.title %></span>
              <span class="mt-1 block"><%= task.assignee&.name || "Unassigned" %></span>
            </div>
            <% if Policy.can?(Current.person, :reopen_task, task) || Policy.can?(Current.person, :manage_tasks, project) %>
              <div class="flex shrink-0 flex-wrap justify-end gap-2 font-semibold">
                <% if Policy.can?(Current.person, :reopen_task, task) %>
                  <%= button_to "Undo", reopen_project_task_path(project, task), class: "min-h-11 px-3 py-2 text-stone-700 hover:text-stone-950" %>
                <% end %>
                <% if Policy.can?(Current.person, :manage_tasks, project) %>
                  <%= link_to "Edit", edit_project_task_path(project, task), class: "min-h-11 px-2 py-3 text-stone-700 hover:text-stone-950" %>
                  <%= button_to "Delete", project_task_path(project, task), method: :delete, class: "min-h-11 px-2 py-2 text-red-800 hover:text-red-950" %>
                <% end %>
              </div>
            <% end %>
          </div>
          <%= render "comments/thread", commentable: task %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
