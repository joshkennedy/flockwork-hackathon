<% open_tasks = project.tasks.open.includes(:assignee, :rich_text_details).due_first %>
<% done_tasks = project.tasks.done.includes(:assignee, :completed_by, :rich_text_details).order(completed_at: :desc, id: :desc) %>
<section class="tool-section" aria-labelledby="tool-tasks">
  <%= render "projects/tools/planner_arrival", tool: "tasks" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-tasks" class="text-ink"><%= icon(:tasks, class: "text-tool-tasks") %> <%= Project::TOOL_LABELS.fetch("tasks") %></h2>
    <% if Policy.can?(Current.person, :manage_tasks, project) %>
      <%= link_to new_project_task_path(project), class: "btn btn-secondary btn-sm" do %><%= icon(:plus) %>Add Task<% end %>
    <% end %>
  </div>

  <% if flash[:alert].present? %>
    <p role="alert" class="mt-4 bg-danger-soft px-4 py-3 text-meta font-semibold text-danger"><%= flash[:alert] %></p>
  <% end %>

  <% if open_tasks.any? %>
    <ul class="mt-4 divide-y divide-hairline">
      <% open_tasks.each do |task| %>
        <% can_finish = Policy.can?(Current.person, :mark_task_done, task) %>
        <% can_claim = task.assignee.blank? && Policy.can?(Current.person, :claim_task, task) %>
        <% can_unclaim = Policy.can?(Current.person, :unclaim_task, task) %>
        <% can_manage = Policy.can?(Current.person, :manage_tasks, project) %>
        <li class="flex gap-3 py-4 text-ink">
          <% if can_finish %>
            <%= button_to mark_done_project_task_path(project, task), class: "task-check", form_class: "shrink-0", aria: { label: "Mark #{task.title} done" } do %>
              <%= icon(:check, class: "task-check-glyph") %>
            <% end %>
          <% else %>
            <span class="task-check" aria-hidden="true"></span>
          <% end %>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
              <div class="min-w-0">
                <h3 class="text-heading text-ink"><%= task.title %></h3>
                <p class="mt-0.5 text-meta text-ink-2">
                  <%= person_pill(task.assignee, fallback: "Unassigned") %>
                  <% if task.due_on %>
                    · <time datetime="<%= task.due_on.iso8601 %>" title="<%= task.due_on.to_fs(:long) %>" class="<%= "font-medium text-ink" if task.due_on < Date.current %>"><%= task_due_label(task.due_on) %></time>
                  <% end %>
                </p>
              </div>
              <div class="flex shrink-0 items-center gap-1">
                <% if can_claim %>
                  <%= button_to "I’ll Do It", claim_project_task_path(project, task), class: "btn btn-secondary btn-sm" %>
                <% end %>
                <% if can_manage || can_unclaim %>
                  <%= actions_menu("Actions for #{task.title}") do %>
                    <% if can_manage %>
                      <%= link_to "Edit Task", edit_project_task_path(project, task) %>
                    <% end %>
                    <% if can_unclaim %>
                      <%= button_to "Unclaim", unclaim_project_task_path(project, task) %>
                    <% end %>
                    <% if can_manage %>
                      <hr>
                      <%= button_to "Delete Task", project_task_path(project, task), method: :delete, class: "menu-danger" %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
            <% if task.details.present? %>
              <div class="mt-2 text-meta leading-normal text-ink-2"><%= task.details %></div>
            <% end %>
            <%= render "comments/thread", commentable: task %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No open Tasks</p>
  <% end %>

  <% if done_tasks.any? %>
    <h3 class="mt-7 text-ink">Done</h3>
    <ul class="mt-2 divide-y divide-hairline">
      <% done_tasks.each do |task| %>
        <% can_reopen = Policy.can?(Current.person, :reopen_task, task) %>
        <% can_manage = Policy.can?(Current.person, :manage_tasks, project) %>
        <li class="flex gap-3 py-3 text-ink-2">
          <% if can_reopen %>
            <%= button_to reopen_project_task_path(project, task), class: "task-check task-check-done", form_class: "shrink-0", aria: { label: "Reopen #{task.title}" } do %>
              <%= icon(:check, class: "task-check-glyph") %>
            <% end %>
          <% else %>
            <span class="task-check task-check-done" aria-hidden="true"><%= icon(:check, class: "task-check-glyph") %></span>
          <% end %>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
              <div class="min-w-0">
                <p class="text-meta font-medium text-ink-2"><%= task.title %></p>
                <p class="mt-0.5 text-label text-ink-2"><%= person_pill(task.assignee, fallback: "Unassigned") %></p>
              </div>
              <% if can_manage %>
                <div class="flex shrink-0 items-center gap-1">
                  <%= actions_menu("Actions for #{task.title}") do %>
                    <%= link_to "Edit Task", edit_project_task_path(project, task) %>
                    <hr>
                    <%= button_to "Delete Task", project_task_path(project, task), method: :delete, class: "menu-danger" %>
                  <% end %>
                </div>
              <% end %>
            </div>
            <%= render "comments/thread", commentable: task %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
