<% open_tasks = project.tasks.open.includes(:assignee, :rich_text_details).due_first %>
<% done_tasks = project.tasks.done.includes(:assignee, :completed_by, :rich_text_details).order(completed_at: :desc, id: :desc) %>
<section class="tool-section" aria-labelledby="tool-tasks">
  <%= render "projects/tools/planner_arrival", tool: "tasks" %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <h2 id="tool-tasks" class="text-ink"><%= icon(:tasks, class: "text-tool-tasks") %> <%= Project::TOOL_LABELS.fetch("tasks") %></h2>
    <% if Policy.can?(Current.person, :manage_tasks, project) %>
      <%= link_to "Add Task", new_project_task_path(project), class: "btn btn-text text-meta font-semibold text-ink-2 hover:text-ink" %>
    <% end %>
  </div>

  <% if flash[:alert].present? %>
    <p role="alert" class="mt-4 bg-danger-soft px-4 py-3 text-meta font-semibold text-danger"><%= flash[:alert] %></p>
  <% end %>

  <% if open_tasks.any? %>
    <ul class="mt-5 space-y-3">
      <% open_tasks.each do |task| %>
        <li class="border-b border-hairline py-4 text-ink">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 ><%= task.title %></h3>
              <% if task.due_on.present? %>
                <p class="mt-1 text-meta text-ink-2">Due <%= task.due_on.to_fs(:long) %></p>
              <% end %>
            </div>
            <% if task.assignee.present? %>
              <span class="shrink-0 text-meta font-medium text-ink-2"><%= task.assignee.name %></span>
            <% elsif Policy.can?(Current.person, :claim_task, task) %>
              <%= button_to "Open · Claim", claim_project_task_path(project, task), class: "shrink-0 btn btn-secondary" %>
            <% else %>
              <span class="shrink-0 text-meta font-medium text-ink-2">Open</span>
            <% end %>
          </div>
          <% if task.details.present? %>
            <div class="mt-3 text-meta leading-normal text-ink-2"><%= task.details %></div>
          <% end %>
          <% if Policy.can?(Current.person, :manage_tasks, project) ||
                Policy.can?(Current.person, :unclaim_task, task) ||
                Policy.can?(Current.person, :mark_task_done, task) %>
            <div class="mt-3 flex flex-wrap gap-4 text-meta font-semibold">
              <% if Policy.can?(Current.person, :mark_task_done, task) %>
                <%= button_to "Done", mark_done_project_task_path(project, task), class: "btn btn-secondary" %>
              <% end %>
              <% if Policy.can?(Current.person, :unclaim_task, task) %>
                <%= button_to "Unclaim", unclaim_project_task_path(project, task), class: "btn btn-text" %>
              <% end %>
              <% if Policy.can?(Current.person, :manage_tasks, project) %>
                <%= link_to "Edit", edit_project_task_path(project, task), class: "py-2 text-ink-2 hover:text-ink" %>
                <%= button_to "Delete", project_task_path(project, task), method: :delete, class: "btn btn-danger" %>
              <% end %>
            </div>
          <% end %>
          <%= render "comments/thread", commentable: task %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-7 text-meta text-ink-2">No open Tasks</p>
  <% end %>

  <% if done_tasks.any? %>
    <h3 class="mt-7 text-ink">Done</h3>
    <ul class="mt-3 space-y-2">
      <% done_tasks.each do |task| %>
        <li class="py-2 text-meta text-ink-2">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <span class="font-medium"><%= task.title %></span>
              <span class="mt-1 block"><%= task.assignee&.name || "Unassigned" %></span>
            </div>
            <% if Policy.can?(Current.person, :reopen_task, task) || Policy.can?(Current.person, :manage_tasks, project) %>
              <div class="flex shrink-0 flex-wrap justify-end gap-2 font-semibold">
                <% if Policy.can?(Current.person, :reopen_task, task) %>
                  <%= button_to "Undo", reopen_project_task_path(project, task), class: "btn btn-text" %>
                <% end %>
                <% if Policy.can?(Current.person, :manage_tasks, project) %>
                  <%= link_to "Edit", edit_project_task_path(project, task), class: "btn btn-text text-ink-2 hover:text-ink" %>
                  <%= button_to "Delete", project_task_path(project, task), method: :delete, class: "btn btn-danger" %>
                <% end %>
              </div>
            <% end %>
          </div>
          <%= render "comments/thread", commentable: task %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
