<% content_for :title, @project.name %>
<% if authenticated? %>
  <% content_for :account do %>
    <div class="flex items-center gap-1 text-meta text-ink-2" data-public-account>
      <span>Signed in as <%= Current.person.name %></span>
      <%= button_to "Not You?", guest_sign_out_path(@project.public_token), method: :delete, class: "btn btn-text btn-sm" %>
    </div>
  <% end %>
<% end %>

<%= render "projects/banner", project: @project, editable: false %>

<header>
  <h1 class="text-ink"><%= @project.name %></h1>
  <% if @project.description.present? %>
    <p class="mt-4 text-body-phone sm:text-body leading-normal text-ink-2"><%= @project.description %></p>
  <% end %>
  <% if @project.starts_on.present? || @project.ends_on.present? %>
    <p class="mt-4 text-meta font-medium text-ink-2">
      <%= [ @project.starts_on&.to_fs(:long), @project.ends_on&.to_fs(:long) ].compact.join(" to ") %>
    </p>
  <% end %>
</header>

<% if @schedule_items_by_day.any? %>
  <section class="mt-7" aria-labelledby="public-schedule">
    <h2 id="public-schedule" class="text-ink">Schedule</h2>
    <div class="mt-4 space-y-6">
      <% @schedule_items_by_day.each do |day, items| %>
        <div>
          <h3 class="text-ink-2"><%= day.strftime("%A, %B %-d") %></h3>
          <ul class="mt-3 space-y-2">
            <% items.each do |item| %>
              <li class="text-ink">
                <% if item.starts_at_time.present? %>
                  <span class="text-meta font-medium text-ink-2">
                    <%= item.starts_at_time.strftime("%-l:%M %p") %>
                    <% if item.ends_at_time.present? %>
                      – <%= item.ends_at_time.strftime("%-l:%M %p") %>
                    <% end %>
                  </span>
                <% end %>
                <span class="block font-semibold"><%= item.title %></span>
                <% if item.location.present? %>
                  <span class="block text-meta text-ink-2"><%= item.location %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @open_tasks.any? %>
  <section class="mt-7" aria-labelledby="public-tasks">
    <h2 id="public-tasks" class="text-ink">Tasks</h2>
    <ul class="mt-4 space-y-3">
      <% @open_tasks.each do |task| %>
        <li class="flex flex-wrap items-start justify-between gap-3 tile-raised p-4">
          <div>
            <h3 class="text-ink"><%= task.title %></h3>
            <% if task.due_on.present? %>
              <p class="mt-1 text-meta text-ink-2">Due <%= task.due_on.to_fs(:long) %></p>
            <% end %>
          </div>
          <%= button_to "I’ll Do It", claim_project_task_path(@project, task), class: "btn btn-primary" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @open_slots.any? %>
  <section class="mt-7" aria-labelledby="public-slots">
    <h2 id="public-slots" class="text-ink">Sign-up</h2>
    <ul class="mt-4 space-y-4">
      <% @open_slots.group_by(&:date).each do |date, slots| %>
        <% slots.each do |slot| %>
          <% spots_left = slot.capacity - slot.claims_count %>
          <% claimed = @claimed_slot_ids.include?(slot.id) %>
          <%# A held spot is done, so it lies flat; only open Slots stay raised to be pressed. %>
          <li id="<%= dom_id(slot) %>" class="flex scroll-mt-36 flex-wrap items-start justify-between gap-3 p-4 sm:scroll-mt-24 <%= claimed ? "rounded-tile border border-border bg-panel" : "tile-raised" %>">
            <div>
              <p class="text-meta font-medium text-ink-2"><%= date.strftime("%A, %B %-d") %></p>
              <% if slot.starts_at_time.present? %>
                <p class="text-meta font-medium text-ink-2"><%= slot.starts_at_time.strftime("%-l:%M %p") %></p>
              <% end %>
              <p class="font-semibold text-ink"><%= slot.label %></p>
              <% if claimed %>
                <p class="mt-2 flex items-center gap-1.5 text-meta text-ink"><%= icon(:check, class: "text-sunlit") %>You’re signed up</p>
              <% elsif spots_left > 1 %>
                <%# A lone open spot is already said by the row's button. %>
                <p class="badge-need mt-2"><%= spots_left %> <%= "spot".pluralize(spots_left) %> left</p>
              <% end %>
            </div>
            <% if claimed %>
              <%= button_to "Unclaim", public_slot_claim_path(@project.public_token, slot), method: :delete, class: "btn btn-text" %>
            <% elsif @helper %>
              <%= button_to (slot.label.downcase == "dinner" ? "I Can Bring Dinner" : "I Can Help"), public_slot_claim_path(@project.public_token, slot),
                    class: "btn btn-secondary btn-sm btn-claim", aria: { label: "Claim: #{slot.label}" } %>
            <% else %>
              <%= link_to "Help with This", guest_sign_in_path(@project.public_token, slot_id: slot.id), class: "btn btn-secondary btn-sm btn-claim" %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>
<% end %>
