<% content_for :title, @project.name %>

<header>
  <h1 class="text-3xl font-bold tracking-tight text-stone-950 sm:text-4xl"><%= @project.name %></h1>
  <% if @project.description.present? %>
    <p class="mt-4 text-lg leading-8 text-stone-700"><%= @project.description %></p>
  <% end %>
  <% if @project.starts_on.present? || @project.ends_on.present? %>
    <p class="mt-4 text-sm font-medium text-stone-600">
      <%= [ @project.starts_on&.to_fs(:long), @project.ends_on&.to_fs(:long) ].compact.join(" to ") %>
    </p>
  <% end %>
</header>

<% if @schedule_items_by_day.any? %>
  <section class="mt-10" aria-labelledby="public-schedule">
    <h2 id="public-schedule" class="text-xl font-bold text-stone-950">Schedule</h2>
    <div class="mt-4 space-y-6">
      <% @schedule_items_by_day.each do |day, items| %>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-stone-600"><%= day.strftime("%A, %B %-d") %></h3>
          <ul class="mt-3 space-y-2">
            <% items.each do |item| %>
              <li class="text-stone-900">
                <% if item.starts_at_time.present? %>
                  <span class="text-sm font-medium text-stone-600">
                    <%= item.starts_at_time.strftime("%-l:%M %p") %>
                    <% if item.ends_at_time.present? %>
                      – <%= item.ends_at_time.strftime("%-l:%M %p") %>
                    <% end %>
                  </span>
                <% end %>
                <span class="block font-semibold"><%= item.title %></span>
                <% if item.location.present? %>
                  <span class="block text-sm text-stone-600"><%= item.location %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @open_tasks.any? %>
  <section class="mt-10" aria-labelledby="public-tasks">
    <h2 id="public-tasks" class="text-xl font-bold text-stone-950">Tasks</h2>
    <ul class="mt-4 space-y-3">
      <% @open_tasks.each do |task| %>
        <li class="flex flex-wrap items-start justify-between gap-3 border border-stone-200 bg-white p-4">
          <div>
            <h3 class="font-semibold text-stone-950"><%= task.title %></h3>
            <% if task.due_on.present? %>
              <p class="mt-1 text-sm text-stone-600">Due <%= task.due_on.to_fs(:long) %></p>
            <% end %>
          </div>
          <%= link_to "Sign in to help", @sign_in_path, class: "text-sm font-semibold text-stone-800 underline hover:text-stone-950" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @open_slots.any? %>
  <section class="mt-10" aria-labelledby="public-slots">
    <h2 id="public-slots" class="text-xl font-bold text-stone-950">Sign-up</h2>
    <ul class="mt-4 space-y-4">
      <% @open_slots.group_by(&:date).each do |date, slots| %>
        <% slots.each do |slot| %>
          <% spots_left = slot.capacity - slot.claims_count %>
          <li class="flex flex-wrap items-start justify-between gap-3 border border-stone-200 bg-white p-4">
            <div>
              <p class="text-sm font-medium text-stone-600"><%= date.strftime("%A, %B %-d") %></p>
              <% if slot.starts_at_time.present? %>
                <p class="text-sm font-medium text-stone-600"><%= slot.starts_at_time.strftime("%-l:%M %p") %></p>
              <% end %>
              <p class="font-semibold text-stone-950"><%= slot.label %></p>
              <p class="mt-1 text-sm font-medium text-stone-700"><%= spots_left %> <%= "spot".pluralize(spots_left) %> left</p>
            </div>
            <%= link_to "Sign in to help", @sign_in_path, class: "text-sm font-semibold text-stone-800 underline hover:text-stone-950" %>
          </li>
        <% end %>
      <% end %>
    </ul>
  </section>
<% end %>
