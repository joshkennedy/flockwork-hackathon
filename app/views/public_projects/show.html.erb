<% content_for :title, @project.name %>
<% if @helper %>
  <% content_for :account do %>
    <div class="flex min-w-0 items-center gap-3 text-meta font-medium text-ink-2" data-public-account>
      <%# Phones keep only the name, the useful part; screen readers still hear the whole phrase. %>
      <span class="min-w-0 truncate"><span class="max-sm:sr-only">Signed in as </span><%= Current.person.name %></span>
      <%= button_to "Sign Out", guest_sign_out_path(@project.public_token), method: :delete, class: "link -my-3.5 cursor-pointer py-3.5 text-meta font-medium text-ink-2 sm:my-0 sm:py-0", form_class: "button_to shrink-0" %>
    </div>
  <% end %>
<% else %>
  <% content_for :account do %>
    <%= link_to "Already signed up? Sign in", guest_sign_in_path(@project.public_token), class: "link inline-flex min-h-11 items-center text-meta font-medium text-ink-2 sm:min-h-0" %>
  <% end %>
<% end %>

<%= render "projects/banner", project: @project, editable: false %>

<header>
  <h1 class="text-ink"><%= @project.name %></h1>
  <% if @project.description.present? %>
    <p class="mt-4 text-body-phone sm:text-body leading-normal text-ink-2"><%= @project.description %></p>
  <% end %>
  <% if @project.starts_on.present? || @project.ends_on.present? %>
    <p class="mt-4 text-meta font-medium text-ink-2">
      <%= [ @project.starts_on&.to_fs(:long), @project.ends_on&.to_fs(:long) ].compact.join(" to ") %>
    </p>
  <% end %>
</header>

<% if @schedule_items_by_day.any? %>
  <section class="mt-7" aria-labelledby="public-schedule">
    <h2 id="public-schedule" class="text-ink">Schedule</h2>
    <div class="mt-4 space-y-6">
      <% @schedule_items_by_day.each do |day, items| %>
        <div>
          <h3 class="text-ink-2"><%= day.strftime("%A, %B %-d") %></h3>
          <ul class="mt-3 space-y-2">
            <% items.each do |item| %>
              <li class="text-ink">
                <% if item.starts_at_time.present? %>
                  <span class="text-meta font-medium text-ink-2">
                    <%= item.starts_at_time.strftime("%-l:%M %p") %>
                    <% if item.ends_at_time.present? %>
                      – <%= item.ends_at_time.strftime("%-l:%M %p") %>
                    <% end %>
                  </span>
                <% end %>
                <span class="block font-semibold"><%= item.title %></span>
                <% if item.location.present? %>
                  <span class="block text-meta text-ink-2"><%= item.location %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if @open_tasks.any? %>
  <section class="mt-7" aria-labelledby="public-tasks">
    <h2 id="public-tasks" class="text-ink">Tasks</h2>
    <ul class="mt-4 space-y-3">
      <% @open_tasks.each do |task| %>
        <li class="flex flex-wrap items-start justify-between gap-3 tile-raised p-4">
          <div>
            <h3 class="text-ink"><%= task.title %></h3>
            <% if task.due_on.present? %>
              <p class="mt-1 text-meta text-ink-2">Due <%= task.due_on.to_fs(:long) %></p>
            <% end %>
          </div>
          <%= button_to "Sign Up", claim_project_task_path(@project, task), class: "btn btn-primary" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @open_slots.any? %>
  <% slot_weeks(@open_slots) => { this_week:, next_week:, later: } %>
  <section class="mt-7" aria-labelledby="public-slots">
    <h2 id="public-slots" class="text-ink">Sign-up</h2>
    <div class="mt-4 space-y-6">
      <% [ [ "This week", this_week ], [ "Next week", next_week ] ].each do |heading, group| %>
        <% next if group.empty? %>
        <div>
          <h3 class="text-label text-ink-2"><%= heading %></h3>
          <ul class="mt-2 space-y-3 sm:space-y-4"><%= render partial: "public_projects/slot", collection: group %></ul>
        </div>
      <% end %>

      <% if later.any? %>
        <%# Open when nothing nearer exists, or when it holds the helper's own spot, so a claim is never hidden behind a click. %>
        <details data-signup-later <%= "open" if (this_week + next_week).empty? || later.any? { |slot| @claimed_slot_ids.include?(slot.id) } %>>
          <%= disclosure_summary "Later Slots", meta: later_slots_meta(later), class: "disclosure-bar" %>
          <ul class="mt-2 space-y-3 sm:space-y-4"><%= render partial: "public_projects/slot", collection: later %></ul>
        </details>
      <% end %>
    </div>
  </section>
<% end %>
