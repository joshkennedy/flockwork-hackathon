<% content_for :title, "Add Recipient · #{@project.name}" %>

<div class="w-full max-w-2xl">
  <%= page_header "Add Recipient" %>

  <section class="mt-7" aria-labelledby="directory-heading">
    <h2 id="directory-heading" class="text-ink">Search the directory</h2>
    <%= form_with url: new_project_recipient_path(@project), method: :get, class: "mt-5 max-w-xl", data: { controller: "live-search", turbo_frame: "directory-results", turbo_action: "replace" } do |form| %>
      <%= form.label :query, "Search by name", class: "sr-only" %>
      <%= form.search_field :query, value: params[:query], placeholder: "Search by name", autocomplete: "off", class: "w-full field", data: { action: "input->live-search#search" } %>
    <% end %>

    <%= turbo_frame_tag "directory-results", target: "_top" do %>
    <% if @directory_people %>
      <ul class="mt-5 divide-y divide-hairline border-y border-hairline">
        <% @directory_people.each do |person| %>
          <li class="flex items-center justify-between gap-4 py-4">
            <span class="font-semibold text-ink"><%= person.name %></span>
            <%= button_to "Add", project_recipients_path(@project), params: { person_id: person.id }, class: "btn btn-secondary", aria: { label: "Add #{person.name} as Recipient" } %>
          </li>
        <% end %>
      </ul>
      <% if @directory_people.empty? %>
        <p class="mt-5 text-ink-2">No matching People who can be added as Recipients.</p>
      <% end %>
    <% end %>
    <% end %>
  </section>

  <section class="mt-7" aria-labelledby="new-person-heading">
    <h2 id="new-person-heading" class="text-ink">Add a new Person</h2>
    <%= form_with url: project_recipients_path(@project), class: "mt-5 max-w-xl space-y-4" do |form| %>
      <div>
        <%= form.label :name, "Name", class: "block text-label font-medium text-ink" %>
        <%= form.text_field "person[name]", value: @person&.name, required: true, class: "mt-2 w-full field" %>
        <% if @person&.errors&.include?(:name) %>
          <p role="alert" class="mt-1 text-meta text-danger"><%= @person.errors.full_messages_for(:name).to_sentence %></p>
        <% end %>
      </div>
      <div>
        <%= form.label :phone, "Phone (optional)", class: "block text-label font-medium text-ink" %>
        <%= form.telephone_field "person[phone]", value: @person&.phone, class: "mt-2 w-full field" %>
      </div>
      <% if @person&.errors&.any? && !@person.errors.include?(:name) %>
        <p role="alert" class="text-meta text-danger"><%= @person.errors.full_messages.to_sentence %></p>
      <% end %>
      <% if @recipient&.errors&.any? %>
        <p role="alert" class="text-meta text-danger"><%= @recipient.errors.full_messages.to_sentence %></p>
      <% end %>
      <%= form.submit "Add as Recipient", class: "btn btn-primary" %>
    <% end %>
  </section>
</div>
