<%= form_with model: [ project, schedule_item ], class: "space-y-7" do |form| %>
  <% if schedule_item.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-danger">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% schedule_item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :date, class: "block text-label font-medium text-ink" %>
    <%= form.date_field :date, required: true, autofocus: true, class: "mt-2 block w-full field" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :starts_at_time, "Start time", class: "block text-label font-medium text-ink" %>
      <%= form.time_field :starts_at_time, class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :ends_at_time, "End time", class: "block text-label font-medium text-ink" %>
      <%= form.time_field :ends_at_time, class: "mt-2 block w-full field" %>
    </div>
  </div>

  <div>
    <%= form.label :title, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :title, required: true, class: "mt-2 block w-full field" %>
  </div>

  <div>
    <%= form.label :location, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :location, class: "mt-2 block w-full field" %>
  </div>

  <%= form.submit schedule_item.persisted? ? "Update Schedule Item" : "Create Schedule Item", class: "btn btn-primary" %>
<% end %>
