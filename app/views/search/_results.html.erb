<%= turbo_frame_tag results_frame, data: { global_search_target: ("results" if results_frame == "search-results") } do %>
  <% pages = search_pages(query) %>
  <% if query.blank? %>
    <p class="search-caption">Go to</p>
    <% organization_navigation.each do |label, path, _icon| %>
      <%= link_to path, class: "search-result", data: { turbo_frame: "_top", action: "global-search#close" } do %>
        <span><span class="block font-medium"><%= label %></span><span class="block text-meta text-ink-2">Page</span></span>
      <% end %>
    <% end %>
    <p class="search-caption">Search projects, people, tasks, slots, schedule and docs by name or title.</p>
  <% elsif pages.empty? && results.values.all?(&:empty?) %>
    <div class="search-empty"><p class="font-medium">No results for “<%= query %>”</p><p class="mt-1 text-meta text-ink-2">Try a shorter name or a different word. Only work you can access is searched.</p></div>
  <% else %>
    <p class="search-caption">Results for “<%= query %>”</p>
    <% if pages.any? %>
      <section aria-label="Pages">
        <h2 class="search-caption">Pages</h2>
        <% pages.each do |label, path, _icon| %>
          <%= link_to path, class: "search-result", data: { turbo_frame: "_top", action: "global-search#close" } do %>
            <span><%= search_highlight(label, query) %></span><span class="text-meta text-ink-2">Page</span>
          <% end %>
        <% end %>
      </section>
    <% end %>
    <% results.each do |group, records| %>
      <% next if records.empty? %>
      <section aria-label="<%= group %>">
        <h2 class="search-caption"><%= group %> <span class="ml-2 font-normal"><%= records.size %></span></h2>
        <ul>
          <% records.each do |record| %>
            <% label, context, path = search_result(record) %>
            <li><%= link_to path, class: "search-result", data: { turbo_frame: "_top", action: "global-search#close" } do %>
              <span class="min-w-0"><span class="block break-words font-medium"><%= search_highlight(label, query) %></span><span class="block truncate text-meta text-ink-2"><%= search_highlight(context, query) %></span></span>
              <span class="search-return text-ink-2" aria-hidden="true">↵</span>
            <% end %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
<% end %>
