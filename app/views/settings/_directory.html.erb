<%# Where the People directory comes from: Planning Center or a CSV file. %>
<div class="space-y-10">
  <section aria-labelledby="planning-center-heading">
  <div>
    <h2 id="planning-center-heading" class="text-heading font-semibold text-ink">Planning Center</h2>
    <p class="mt-1 text-meta text-ink-2">Create a Personal Access Token in your <%= link_to "Planning Center developer account", "https://api.planningcenteronline.com/docs/overview/authentication", class: "link", target: "_blank", rel: "noreferrer" %>, then paste its App ID and Secret.</p>
  </div>

  <% if Current.organization.planning_center_connected? %>
    <div class="mt-5 rounded-tile bg-sunlit-soft p-4">
      <p class="font-medium text-ink">Connected</p>
      <% if Current.organization.pco_last_synced_at.present? %>
        <p class="mt-1 text-meta text-ink-2">Last synced <%= time_ago_in_words(Current.organization.pco_last_synced_at) %> ago.</p>
      <% else %>
        <p class="mt-1 text-meta text-ink-2">Not synced yet.</p>
      <% end %>
    </div>

    <% if Current.organization.pco_last_sync_error.present? %>
      <p class="mt-5 text-meta font-medium text-danger" role="alert"><%= Current.organization.pco_last_sync_error %></p>
    <% elsif Current.organization.pco_last_sync_result.present? %>
      <% result = Current.organization.pco_last_sync_result %>
      <p class="mt-5 text-meta text-ink-2"><%= result.fetch("created") %> created, <%= result.fetch("updated") %> updated, <%= result.fetch("unchanged") %> unchanged.</p>
      <% if result.fetch("skipped_email_changes", []).any? %>
        <p class="mt-3 text-meta font-medium text-ink">Email changes skipped:</p>
        <ul class="mt-1 list-disc space-y-1 break-words pl-5 text-meta text-ink-2">
          <% result.fetch("skipped_email_changes").each do |change| %>
            <li><%= change.fetch("person_name") %>: kept <%= change.fetch("current_email") %>; skipped <%= change.fetch("skipped_email") %> from Planning Center.</li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <%= button_to "Sync Now", sync_planning_center_directory_path, class: "mt-5 btn btn-primary" %>
  <% end %>

  <% if Current.organization.errors.any? && @settings_tab == "directory" %>
    <p role="alert" class="mt-5 text-meta text-danger"><%= Current.organization.errors.full_messages.to_sentence %></p>
  <% end %>

  <%= form_with model: Current.organization, url: planning_center_directory_path, method: :patch, class: "mt-7 space-y-4" do |form| %>
    <div>
      <%= form.label :pco_skills_field_id, "Skills text field ID (optional)", class: "block text-label font-medium text-ink" %>
      <%= form.text_field :pco_skills_field_id, inputmode: "numeric", class: "mt-2 block w-full field", aria: { describedby: "pco-skills-help" } %>
      <p id="pco-skills-help" class="mt-2 text-meta text-ink-2">Use the numeric ID for the Planning Center People text field that lists skills, separated by commas. Leave blank to keep local Skills unchanged. Selection and checkbox fields are not supported.</p>
    </div>
    <%= form.submit "Save Skills Mapping", class: "btn btn-secondary" %>
  <% end %>

  <%= form_with model: Current.organization, url: planning_center_directory_path, method: :patch, class: "mt-7 space-y-4" do |form| %>
    <div>
      <%= form.label :pco_app_id, "App ID", class: "block text-label font-medium text-ink" %>
      <%= form.password_field :pco_app_id, value: nil, required: true, autocomplete: "off", class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :pco_secret, "Secret", class: "block text-label font-medium text-ink" %>
      <%= form.password_field :pco_secret, value: nil, required: true, autocomplete: "off", class: "mt-2 block w-full field" %>
    </div>
    <%= form.submit Current.organization.planning_center_connected? ? "Replace Connection" : "Connect Planning Center", class: Current.organization.planning_center_connected? ? "btn btn-secondary" : "btn btn-primary" %>
  <% end %>
  </section>

  <section aria-labelledby="csv-import-heading">
    <h2 id="csv-import-heading" class="text-heading font-semibold text-ink">CSV import</h2>
    <p class="mt-1 text-meta text-ink-2">Bring in a spreadsheet when your directory is not in Planning Center.</p>
    <%= link_to "Import CSV", new_people_csv_import_path, class: "mt-4 btn btn-secondary" %>
  </section>
</div>
