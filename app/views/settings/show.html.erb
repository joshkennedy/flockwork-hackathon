<% content_for :title, "Settings · #{Current.organization.name}" %>
<% content_for :breadcrumbs do %>
  <span class="min-w-0 truncate text-ink" aria-current="page">Settings</span>
<% end %>
<% organization = Current.organization %>
<% saved_color = organization.mark_color_was || organization.mark_color %>
<% preset = Organization::MARK_PRESETS.value?(organization.mark_color) %>

<div class="w-full max-w-2xl">
  <%= page_header "Settings", subtitle: "Choices here apply to everyone at #{organization.name}." %>

  <% if organization.errors.any? %>
    <p class="mt-7 text-meta font-medium text-danger" role="alert"><%= organization.errors.full_messages.to_sentence %></p>
  <% end %>

  <%= form_with model: organization, url: settings_path, method: :patch, class: "mt-7",
        data: { controller: "theme-picker", action: "change->theme-picker#pick", theme_picker_default_value: Organization::DEFAULT_MARK_COLOR } do |form| %>
    <fieldset class="space-y-4">
      <legend class="text-heading font-semibold text-ink">Theme</legend>
      <p class="text-meta text-ink-2">Colors the lead bird in the Flockwork mark, in the sidebar and the browser tab. Changes save as you pick.</p>

      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <% Organization::MARK_PRESETS.each do |name, color| %>
          <label class="tile-raised flex cursor-pointer items-center gap-2 px-3 py-2.5 text-button has-[:checked]:border-ink has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ink">
            <%= form.radio_button :mark_color_choice, color, checked: organization.mark_color == color, class: "sr-only" %>
            <span class="size-4 shrink-0 rounded-badge" style="background: <%= color %>" aria-hidden="true"></span>
            <%= name %>
          </label>
        <% end %>
        <label for="organization_custom_mark_color" class="tile-raised flex cursor-pointer items-center gap-2 px-3 py-2.5 text-button has-[:checked]:border-ink has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-ink">
          <%= form.radio_button :mark_color_choice, "custom", checked: !preset, class: "sr-only", data: { theme_picker_target: "customChoice" } %>
          <%= form.color_field :custom_mark_color, value: (preset ? saved_color : organization.mark_color).to_s.downcase,
                class: "size-4 shrink-0 cursor-pointer rounded-badge border-0 p-0", aria: { label: "Custom color" },
                data: { theme_picker_target: "custom", action: "input->theme-picker#previewCustom change->theme-picker#previewCustom" } %>
          Custom
        </label>
      </div>
    </fieldset>
  <% end %>
</div>
