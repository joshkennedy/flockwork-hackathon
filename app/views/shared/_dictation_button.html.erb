<div data-controller="dictation" class="dictation-field <%= local_assigns.fetch(:wrapper_class,"flex items-center gap-2") %>">
  <%= yield %>
  <button type="button" hidden data-dictation-target="button" data-action="dictation#toggle" aria-label="Dictate" aria-pressed="false" class="btn btn-text min-h-7 px-2 py-1">
    <%= icon(:mic) %>
    <span data-dictation-target="listeningLabel" hidden class="text-label text-danger">Listening…</span>
  </button>
</div>
