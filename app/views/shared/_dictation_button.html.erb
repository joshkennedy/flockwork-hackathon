<div data-controller="dictation" class="<%= local_assigns.fetch(:wrapper_class, "flex items-center gap-2") %>">
  <%= yield %>
  <button type="button" hidden data-dictation-target="button" data-action="dictation#toggle" aria-label="Dictate" aria-pressed="false" class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-full border border-stone-400 bg-white p-2 text-stone-800 hover:border-stone-950 hover:bg-[#f2f5ed]">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
      <path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Z" />
      <path d="M19 11a1 1 0 1 0-2 0 5 5 0 0 1-10 0 1 1 0 1 0-2 0 7 7 0 0 0 6 6.92V21H9a1 1 0 1 0 0 2h6a1 1 0 1 0 0-2h-2v-3.08A7 7 0 0 0 19 11Z" />
    </svg>
    <span data-dictation-target="listeningLabel" hidden class="pr-1 text-xs font-semibold text-red-700">Listening…</span>
  </button>
</div>
