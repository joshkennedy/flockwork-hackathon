<section class="<%= local_assigns.fetch(:section_class, "mt-7") %>" aria-labelledby="involvement-timeline-heading">
  <h2 id="involvement-timeline-heading" class="text-ink"><%= title %></h2>

  <% if involvement.any? %>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-meta border-collapse text-left">
        <thead>
          <tr class="border-b border-hairline text-meta text-ink-2">
            <th scope="col" class="py-3 pr-4 font-semibold">Year</th>
            <th scope="col" class="px-2 py-3 text-right font-semibold">Projects</th>
            <th scope="col" class="px-2 py-3 text-right font-semibold">Tasks</th>
            <th scope="col" class="py-3 pl-4 text-right font-semibold">Slots</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <% involvement.each do |entry| %>
            <tr data-involvement-year="<%= entry[:year] %>"
                data-projects="<%= entry[:projects] %>"
                data-tasks="<%= entry[:tasks] %>"
                data-slots="<%= entry[:slots] %>">
              <th scope="row" class="py-4 pr-4 font-semibold text-ink"><%= entry[:year] %></th>
              <td class="px-2 py-4 text-right text-ink-2"><%= entry[:projects] %></td>
              <td class="px-2 py-4 text-right text-ink-2"><%= entry[:tasks] %></td>
              <td class="py-4 pl-4 text-right text-ink-2"><%= entry[:slots] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-6 text-ink-2">No Involvement yet.</p>
  <% end %>
</section>
