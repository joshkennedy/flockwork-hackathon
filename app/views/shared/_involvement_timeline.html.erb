<section class="mt-14" aria-labelledby="involvement-timeline-heading">
  <h2 id="involvement-timeline-heading" class="text-2xl font-bold text-stone-950"><%= title %></h2>
  <p class="mt-2 leading-7 text-stone-700">Projects joined, Tasks completed, and Slots claimed by year.</p>

  <% if involvement.any? %>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[30rem] border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-stone-800 text-sm text-stone-700">
            <th scope="col" class="py-3 pr-4 font-semibold">Year</th>
            <th scope="col" class="px-4 py-3 text-right font-semibold">Projects</th>
            <th scope="col" class="px-4 py-3 text-right font-semibold">Tasks</th>
            <th scope="col" class="py-3 pl-4 text-right font-semibold">Slots</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-300">
          <% involvement.each do |entry| %>
            <tr data-involvement-year="<%= entry[:year] %>"
                data-projects="<%= entry[:projects] %>"
                data-tasks="<%= entry[:tasks] %>"
                data-slots="<%= entry[:slots] %>">
              <th scope="row" class="py-4 pr-4 font-semibold text-stone-950"><%= entry[:year] %></th>
              <td class="px-4 py-4 text-right text-stone-700"><%= entry[:projects] %></td>
              <td class="px-4 py-4 text-right text-stone-700"><%= entry[:tasks] %></td>
              <td class="py-4 pl-4 text-right text-stone-700"><%= entry[:slots] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-6 text-stone-600">No Involvement yet.</p>
  <% end %>
</section>
