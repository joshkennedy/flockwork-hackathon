<ol class="setup-steps" aria-label="Project setup">
  <% steps.each_with_index do |step, index| %>
    <li class="setup-step" data-step-state="<%= step.fetch(:state) %>" <%= tag.attributes(aria: { current: ("step" if step.fetch(:state) == :open) }) %>>
      <div class="setup-step-heading">
        <span class="setup-step-number" aria-hidden="true"><%= step.fetch(:state) == :done ? icon(:check, size: 14) : index + 1 %></span>
        <span class="sr-only"><%= { done: "Done", open: "Current", upcoming: "Next" }.fetch(step.fetch(:state)) %>: </span>
        <h2 class="setup-step-title"><%= step.fetch(:title) %></h2>
        <% if step[:detail].present? %><span class="setup-step-detail"><%= step[:detail] %></span><% end %>
      </div>
      <% if step[:change].present? %><div class="setup-step-change"><%= step[:change] %></div><% end %>
      <% if step.fetch(:state) == :open %>
        <div class="setup-step-body"><%= yield %></div>
      <% end %>
    </li>
  <% end %>
</ol>
