<% content_for :title, "Sign-in link not valid" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Sign-in link not valid</h1>
  <p class="mt-2 text-ink-2">That sign-in link has expired or was already used. Request a new one.</p>
  <p class="mt-6"><%= link_to "Request a New Sign-In Link", new_sign_in_request_path, class: "btn btn-primary" %></p>
</div>
