<% content_for :title, "Check your email" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Check your email</h1>
  <p class="mt-2 text-ink-2">If that address can sign in to Flockwork, a sign-in link is on its way. It works once and expires in 15 minutes.</p>
  <p class="mt-6 text-ink-2">Check your spam folder too. You can close this page and open the link from your inbox.</p>
  <p class="mt-6"><%= link_to "Try another email or request a new link", new_sign_in_request_path, class: "font-medium underline" %></p>
</div>
