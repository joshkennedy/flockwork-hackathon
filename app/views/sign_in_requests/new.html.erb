<% content_for :title, "Sign in to #{@workspace.name}" %>

<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold text-gray-900">Sign in to <%= @workspace.name %></h1>
  <p class="mt-2 text-gray-600">Enter your email and we will send you a sign-in link. It works once and expires in 15 minutes.</p>

  <%= form_with url: sign_in_requests_path(@workspace), class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>

    <%= f.submit "Email me a sign-in link", class: "w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% end %>

  <% if @workspace.demo? %>
    <div class="mt-10 border-t border-gray-200 pt-6">
      <h2 class="text-lg font-semibold text-gray-900">Explore the demo</h2>
      <p class="mt-1 text-sm text-gray-600">No email needed. Pick a role to look around.</p>

      <div class="mt-4 grid gap-3">
        <%= button_to "Explore as Admin", demo_session_path(@workspace, role: "admin"), class: "w-full rounded-md border border-gray-300 px-4 py-2 font-medium text-gray-900 hover:bg-gray-50 cursor-pointer" %>
        <%= button_to "Explore as Leader", demo_session_path(@workspace, role: "leader"), class: "w-full rounded-md border border-gray-300 px-4 py-2 font-medium text-gray-900 hover:bg-gray-50 cursor-pointer" %>
        <%= button_to "Explore as Volunteer", demo_session_path(@workspace, role: "volunteer"), class: "w-full rounded-md border border-gray-300 px-4 py-2 font-medium text-gray-900 hover:bg-gray-50 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
