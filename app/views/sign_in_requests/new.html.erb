<% content_for :title, "Sign in to #{@workspace.name}" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Sign in to <%= @workspace.name %></h1>
  <p class="mt-2 text-ink-2">Enter your email and we will send you a sign-in link. It works once and expires in 15 minutes.</p>

  <%= form_with url: sign_in_requests_path(@workspace), class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block text-label font-medium text-ink-2" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 block w-full field" %>
    </div>

    <%= f.submit "Email me a sign-in link", class: "w-full btn btn-primary" %>
  <% end %>

  <% if @workspace.demo? %>
    <div class="mt-7 border-t border-hairline pt-6">
      <h2 class="text-ink">Explore the demo</h2>
      <p class="mt-1 text-meta text-ink-2">No email needed. Pick a role to look around.</p>

      <div class="mt-4 grid gap-3">
        <%= button_to "Explore as Admin", demo_session_path(@workspace, role: "admin"), class: "w-full btn btn-secondary" %>
        <%= button_to "Explore as Leader", demo_session_path(@workspace, role: "leader"), class: "w-full btn btn-secondary" %>
        <%= button_to "Explore as Volunteer", demo_session_path(@workspace, role: "volunteer"), class: "w-full btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>
