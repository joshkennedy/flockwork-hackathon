<% content_for :title, "Sign in" %>

<div class="w-full max-w-xl mx-auto">
  <h1 class="text-ink">Sign in to Flockwork</h1>
  <p class="mt-2 text-ink-2">Enter your email and we will send you a sign-in link. It works once and expires in 15 minutes.</p>
  <p class="mt-2 text-meta text-ink-2">Use the email your church leader added. For privacy, the next screen looks the same even when an email isn’t found.</p>

  <%= form_with url: sign_in_requests_path, class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block text-label font-medium text-ink-2" %>
      <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-2 block w-full field" %>
    </div>

    <%= f.submit "Email Me a Sign-In Link", class: "w-full btn btn-primary" %>
  <% end %>

  <p class="mt-6 text-meta text-ink-2">Just looking around? <%= link_to "Explore the demo", new_demo_session_path, class: "link font-medium" %></p>
  <p class="mt-4 text-meta text-ink-2">Starting a space for your church? <%= link_to "Create your church", sign_up_path, class: "link font-medium" %></p>
</div>
