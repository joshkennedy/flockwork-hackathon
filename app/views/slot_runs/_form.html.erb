<%= form_with model: slot_run, url: project_slot_run_path(project), class: local_assigns.fetch(:class_name, "mt-7 space-y-7"),
      data: { turbo_frame: ("_top" unless local_assigns.fetch(:within_frame, false) || request.headers["Turbo-Frame"] == "slot-run-form") } do |form| %>
  <% if slot_run.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
      <p class="font-semibold">Fix these to continue:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% slot_run.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :start_date, class: "block text-label font-medium text-ink" %>
      <%= form.date_field :start_date, required: true, autofocus: local_assigns.fetch(:autofocus, true), class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :end_date, class: "block text-label font-medium text-ink" %>
      <%= form.date_field :end_date, required: true, class: "mt-2 block w-full field" %>
    </div>
  </div>

  <div>
    <%= form.label :starts_at_time, "Start time", class: "block text-label font-medium text-ink" %>
    <%= form.time_field :starts_at_time, class: "mt-2 block w-full field" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_8rem]">
    <div>
      <%= form.label :label, class: "block text-label font-medium text-ink" %>
      <%= form.text_field :label, required: true, placeholder: "Dinner, setup, childcare…", class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :capacity, class: "block text-label font-medium text-ink" %>
      <%= form.number_field :capacity, min: 1, required: true, class: "mt-2 block w-full field" %>
    </div>
  </div>

  <div class="flex justify-end">
    <%= form.submit "Add Slots", class: "btn btn-primary" %>
  </div>
<% end %>
