<% content_for :title, "Generate Slot run" %>

<div class="mx-auto w-full max-w-2xl">
  <%= link_to "Back to #{@project.name}", @project, class: "text-sm font-semibold text-stone-600 hover:text-stone-950" %>

  <h1 class="mt-8 text-3xl font-bold text-stone-950">Generate Slot run</h1>
  <p class="mt-3 text-stone-700">Create one Slot per day, up to 60 days.</p>

  <%= form_with model: @slot_run, url: project_slot_run_path(@project), class: "mt-8 space-y-7" do |form| %>
    <% if @slot_run.errors.any? %>
      <div class="border-l-4 border-red-700 bg-red-50 px-5 py-4 text-red-950">
        <p class="font-semibold">Please fix the following:</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          <% @slot_run.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :start_date, class: "block text-sm font-semibold text-stone-900" %>
        <%= form.date_field :start_date, required: true, autofocus: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
      </div>
      <div>
        <%= form.label :end_date, class: "block text-sm font-semibold text-stone-900" %>
        <%= form.date_field :end_date, required: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
      </div>
    </div>

    <div>
      <%= form.label :starts_at_time, "Start time", class: "block text-sm font-semibold text-stone-900" %>
      <%= form.time_field :starts_at_time, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :label, class: "block text-sm font-semibold text-stone-900" %>
      <%= form.text_field :label, required: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :capacity, class: "block text-sm font-semibold text-stone-900" %>
      <%= form.number_field :capacity, min: 1, required: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-2.5 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>

    <%= form.submit "Generate Slots", class: "cursor-pointer bg-[#1f291f] px-5 py-3 text-sm font-semibold text-white hover:bg-[#354235]" %>
  <% end %>
</div>
