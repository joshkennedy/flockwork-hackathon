<%= form_with model: [ project, task ], class: "space-y-7",
      data: { turbo_frame: ("_top" unless request.headers["Turbo-Frame"] == "task-form") } do |form| %>
  <% if task.errors.any? %>
    <div role="alert" class="rounded-control bg-danger-soft px-4 py-3 text-ink">
      <p class="font-semibold">Fix these to continue:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-meta">
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-label font-medium text-ink" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "mt-2 block w-full field" %>
  </div>

  <div>
    <%= form.label :details, class: "block text-label font-medium text-ink" %>
    <%= form.rich_text_area :details, class: "mt-2 block w-full field" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :due_on, "Due date", class: "block text-label font-medium text-ink" %>
      <%= form.date_field :due_on, class: "mt-2 block w-full field" %>
    </div>
    <div>
      <%= form.label :assignee_id, "Assigned to", class: "block text-label font-medium text-ink" %>
      <%= form.collection_select :assignee_id, team_people, :id, :name, { include_blank: "Unassigned" }, class: "mt-2 block w-full field" %>
    </div>
  </div>

  <%= form.submit task.persisted? ? "Save Task" : "Add Task", class: "btn btn-primary" %>
<% end %>
