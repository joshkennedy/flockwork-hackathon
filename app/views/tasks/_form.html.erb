<%= form_with model: [ project, task ], class: "space-y-7" do |form| %>
  <% if task.errors.any? %>
    <div class="border-l-4 border-red-700 bg-red-50 px-5 py-4 text-red-950">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold text-stone-900" %>
    <%= form.text_field :title, required: true, autofocus: true, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-3 text-stone-950 focus:border-stone-950 focus:outline-none" %>
  </div>

  <div>
    <%= form.label :details, class: "block text-sm font-semibold text-stone-900" %>
    <%= form.rich_text_area :details, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-3 text-stone-950 focus:border-stone-950 focus:outline-none" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :due_on, "Due date", class: "block text-sm font-semibold text-stone-900" %>
      <%= form.date_field :due_on, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-3 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>
    <div>
      <%= form.label :assignee_id, "Assigned to", class: "block text-sm font-semibold text-stone-900" %>
      <%= form.collection_select :assignee_id, team_people, :id, :name, { include_blank: "Unassigned" }, class: "mt-2 block w-full border border-stone-400 bg-white px-3 py-3 text-stone-950 focus:border-stone-950 focus:outline-none" %>
    </div>
  </div>

  <%= form.submit class: "min-h-12 cursor-pointer bg-[#1f291f] px-5 py-3 text-sm font-semibold text-white hover:bg-[#354235]" %>
<% end %>
