<% content_for :title, @workspace.name %>

<div class="w-full max-w-2xl mx-auto">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm text-gray-500">Signed in as <%= @person.name %></p>
      <h1 class="mt-1 text-3xl font-bold text-gray-900"><%= @workspace.name %></h1>
    </div>

    <%= button_to "Sign out", session_path, method: :delete, class: "rounded-md border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 cursor-pointer" %>
  </div>

  <div class="mt-10 rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-600">
    Nothing here yet. Projects will show up here once your team starts planning.
  </div>
</div>
