<% content_for :title, @workspace.name %>

<div class="w-full max-w-3xl">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-meta text-ink-2">Signed in as <%= @person.name %></p>
      <h1 class="mt-2 text-ink"><%= @workspace.name %></h1>
    </div>

  </div>

  <section class="mt-7 border-t border-hairline pt-7">
    <h2 >Plan the work together</h2>
    <p class="mt-3 max-w-lg leading-normal text-ink-2">Projects give each Team one clear place for the Tools, dates, and details their work needs.</p>
    <%= link_to "Projects", projects_path, class: "mt-5 btn btn-primary" %>
    <%= link_to "Get involved", get_involved_path, class: "mt-5 btn btn-text" %>
  </section>

  <% if @pending_invitations.any? %>
    <section class="mt-7" aria-labelledby="pending-invitations-heading">
      <h2 id="pending-invitations-heading" class="text-ink">Pending Invitations</h2>
      <ul class="mt-5 divide-y divide-hairline border-y border-hairline">
        <% @pending_invitations.each do |invitation| %>
          <li>
            <%= link_to invitation_path(invitation.generate_token_for(:access)), class: "flex items-center justify-between gap-4 py-4 font-semibold text-ink hover:text-ink" do %>
              <span><%= invitation.project.name %></span>
              <span class="text-meta font-medium text-ink-2"><%= invitation.role.humanize %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <nav class="mt-7 flex flex-wrap gap-4 text-meta font-medium">
    <%= link_to "My Tasks", my_tasks_path, class: "text-ink-2 hover:text-ink" %>
    <% if @person.admin? %>
      <%= link_to "People", people_path, class: "text-ink-2 hover:text-ink" %>
    <% end %>
    <% if Policy.can?(@person, :view_oversight, @workspace) %>
      <%= link_to "Oversight", oversight_path, class: "text-ink-2 hover:text-ink" %>
    <% end %>
    <%= link_to "My profile", edit_profile_path, class: "text-ink-2 hover:text-ink" %>
  </nav>
</div>
